pe":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"A barrier to AI adoption can include data limitations and a lack of AI readiness and skills."},{"id":"s2","label":"Organizations often struggle with AI adoption because they prioritize technology selection before defining clear business use cases."},{"id":"s3","label":"A lack of cross-functional collaboration is a common barrier to AI adoption."}],"correctValues":{"s1":true,"s2":true,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: Yes\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-055-answer.jpg","alt":"AB-731 source answer frame for question 55","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 55 · video frame around 01:35:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5700s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q056","topicId":"practice-images","title":"Question 56","prompt":[{"type":"paragraph","text":"Your company is building a portfolio of AI-powered business solutions.\nCompany executives want to understand how Microsoft responsible AI principles can support the company's long-term goals.\nWhich benefit best demonstrates the importance of responsible AI?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"reduces the need for executive oversight in AI decision-making"},{"id":"b","label":"enhances stakeholder trust and fosters sustainable AI adoption throughout the organization"},{"id":"c","label":"guarantees that AI models provide accurate and relevant responses"},{"id":"d","label":"reduces the need for data protection policies and governance"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nB. enhances stakeholder trust and fosters sustainable AI adoption throughout the organization"},{"type":"image","src":"/content/ab-731/q-056-answer.jpg","alt":"AB-731 source answer frame for question 56","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 56 · video frame around 01:36:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5800s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q057","topicId":"practice-images","title":"Question 57","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"To use Microsoft 365 Copilot Chat, you must have a Microsoft 365 Copilot license."},{"id":"s2","label":"Microsoft 365 Copilot Chat provides context-aware assistance in Microsoft 365 apps."},{"id":"s3","label":"Microsoft 365 Copilot Chat can only access information in open files and read emails."}],"correctValues":{"s1":false,"s2":true,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: Yes\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-057-answer.jpg","alt":"AB-731 source answer frame for question 57","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 57 · video frame around 01:38:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5910s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q058","topicId":"practice-images","title":"Question 58","prompt":[{"type":"paragraph","text":"Which statement accurately describes the difference between a pretrained generative AI model and a fine-tuned\ngenerative AI model?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"A pretrained model requires labeled data, while a fine-tuned model does not."},{"id":"b","label":"A pretrained model is faster to train than a fine-tuned model because the pretrained model uses fewer parameters."},{"id":"c","label":"A pretrained model is trained on broad datasets, while a fine-tuned model is adapted to perform well on a narrower, domain-specific dataset."},{"id":"d","label":"A pretrained model is optimized for a specific task, while a fine-tuned model is designed for general-purpose use."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nC. A pretrained model is trained on broad datasets, while a fine-tuned model is adapted to perform well on a narrower, domain-specific dataset."},{"type":"image","src":"/content/ab-731/q-058-answer.jpg","alt":"AB-731 source answer frame for question 58","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 58 · video frame around 01:40:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6040s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q059","topicId":"practice-images","title":"Question 59","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Microsoft Foundry provides a unified platform for developers and data professionals to create custom end-to-end AI solutions."},{"id":"s2","label":"Microsoft Foundry provides a unified platform for low-code developers and business users to create custom end-to-end AI solutions."},{"id":"s3","label":"You need a Microsoft 365 Copilot license to access Microsoft Foundry services."}],"correctValues":{"s1":true,"s2":false,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: No\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-059-answer.jpg","alt":"AB-731 source answer frame for question 59","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 59 · video frame around 01:42:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6150s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q060","topicId":"practice-images","title":"Question 60","prompt":[{"type":"paragraph","text":"Your company deploys an AI-powered loan approval solution that enables applicants to request an explanation as to why\ntheir loan application was denied.\nWhich Microsoft responsible AI principle is this an example of?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"fairness"},{"id":"b","label":"privacy and security"},{"id":"c","label":"transparency"},{"id":"d","label":"inclusiveness"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nC. transparency"},{"type":"image","src":"/content/ab-731/q-060-answer.jpg","alt":"AB-731 source answer frame for question 60","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 60 · video frame around 01:44:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6250s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q061","topicId":"practice-images","title":"Question 61","prompt":[{"type":"paragraph","text":"Your company is developing an AI-powered customer support agent.\nYou need to ensure that the solution follows Microsoft responsible AI principles.\nWhich two actions should you perform?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Retain all customer conversations."},{"id":"b","label":"Test the agent to ensure that responses are inclusive and culturally sensitive."},{"id":"c","label":"Enable the agent to operate independently."},{"id":"d","label":"Ensure that the agent can be used for multiple purposes."},{"id":"e","label":"Provide a clear disclaimer that users are interacting with an AI solution."}],"correctOptionIds":["b","e"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nB. Test the agent to ensure that responses are inclusive and culturally sensitive.\nE. Provide a clear disclaimer that users are interacting with an AI solution."},{"type":"image","src":"/content/ab-731/q-061-answer.jpg","alt":"AB-731 source answer frame for question 61","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 61 · video frame around 01:45:50","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6350s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q062","topicId":"practice-images","title":"Question 62","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"A generative AI solution is well-suited to predict next-quarter sales trends."},{"id":"s2","label":"A generative AI solution can summarize lengthy policy documents."},{"id":"s3","label":"A generative AI solution can create product descriptions from product specifications."}],"correctValues":{"s1":false,"s2":true,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: Yes\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-062-answer.jpg","alt":"AB-731 source answer frame for question 62","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 62 · video frame around 01:48:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6480s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q063","topicId":"practice-images","title":"Question 63","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nAn organization's AI champions program includes [blank]."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"An organization's AI champions program includes","allowedChoiceIds":["c1","c2","c3","c4"]}],"choices":[{"id":"c1","label":"technical teams responsible for designing advanced analytics solutions to track adoption."},{"id":"c2","label":"users who advocate for the value of AI by learning, sharing, and identifying use cases."},{"id":"c3","label":"users who are dedicated to building the infrastructure required to support AI across the organization."},{"id":"c4","label":"users who come together and define the organization's overall AI strategy."}],"allowReuse":false,"correctPairs":{"p1":"c2"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nAn organization's AI champions program includes: users who advocate for the value of AI by learning, sharing, and identifying use cases."},{"type":"image","src":"/content/ab-731/q-063-answer.jpg","alt":"AB-731 source answer frame for question 63","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 63 · video frame around 01:50:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6600s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q064","topicId":"practice-images","title":"Question 64","prompt":[{"type":"paragraph","text":"Your company plans to implement a proof of concept (PoC) agent that uses Azure OpenAI. The solution must start small\nand provide flexibility to scale usage as demand grows.\nWhich pricing model should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Microsoft 365 Copilot"},{"id":"b","label":"Batch API"},{"id":"c","label":"Provisioned (PTUs)"},{"id":"d","label":"Standard (On-Demand)"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nD. Standard (On-Demand)"},{"type":"image","src":"/content/ab-731/q-064-answer.jpg","alt":"AB-731 source answer frame for question 64","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 64 · video frame around 01:51:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6690s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q065","topicId":"practice-images","title":"Question 65","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nAn effective way to scale AI proficiency and adoption amongst employees is to [blank]."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"An effective way to scale AI proficiency and adoption amongst employees is to","allowedChoiceIds":["c1","c2","c3","c4"]}],"choices":[{"id":"c1","label":"launch an internal campaign to promote AI awareness."},{"id":"c2","label":"offer a self-paced online training course for employees."},{"id":"c3","label":"define performance metrics for AI tool usage."},{"id":"c4","label":"establish a champions program for your company."}],"allowReuse":false,"correctPairs":{"p1":"c4"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nAn effective way to scale AI proficiency and adoption amongst employees is to: establish a champions program for your company."},{"type":"image","src":"/content/ab-731/q-065-answer.jpg","alt":"AB-731 source answer frame for question 65","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 65 · video frame around 01:53:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=6790s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q066","topicId":"practice-images","title":"Question 66","prompt":[{"type":"paragraph","text":"Your company manages a website that publishes daily news articles.\nYou need to recommend an AI solution that can analyze text and identify the main people, locations, and companies mentioned\nin the articles.\nWhat should you include in the recommendation?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Language in Foundry Tools"},{"id":"b","label":"Azure Vision in Foundry Tools"},{"id":"c","label":"ContentSafety in Foundry Control Plane"},{"id":"d","label":"Azure Speech in Foundry Tools"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(