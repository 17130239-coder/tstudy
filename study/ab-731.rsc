h?v=C4m8LS2Jzqs&t=4040s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q042","topicId":"practice-images","title":"Question 42","prompt":[{"type":"paragraph","text":"Your company sells hiking and camping gear online.\nYou need a generative AI solution that can interact with customers, ask questions about their needs, and escalate to a human agent if necessary.\nWhat solution should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a chatbot"},{"id":"b","label":"predictive AI"},{"id":"c","label":"a recommendation engine"},{"id":"d","label":"computer vision"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nA. a chatbot"},{"type":"image","src":"/content/ab-731/q-042-answer.jpg","alt":"AB-731 source answer frame for question 42","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 42 · video frame around 01:10:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4200s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q043","topicId":"practice-images","title":"Question 43","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Azure Vision in Foundry Tools can extract and analyze key phrases from PDF files."},{"id":"s2","label":"Azure Vision in Foundry Tools can generate images based on natural language descriptions."},{"id":"s3","label":"Azure Document Intelligence in Foundry Tools can be used to automate the processing of invoices and credit notes."}],"correctValues":{"s1":false,"s2":false,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: No\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-043-answer.jpg","alt":"AB-731 source answer frame for question 43","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 43 · video frame around 01:11:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4290s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q044","topicId":"practice-images","title":"Question 44","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nA [blank] AI solution recognizes patterns in large and complex datasets to create new and original content."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"An AI solution that recognizes patterns in large and complex datasets to create new and original content is","allowedChoiceIds":["c1","c2","c3"]}],"choices":[{"id":"c1","label":"prescriptive"},{"id":"c2","label":"predictive"},{"id":"c3","label":"generative"}],"allowReuse":false,"correctPairs":{"p1":"c3"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nAn AI solution that recognizes patterns in large and complex datasets to create new and original content is: generative"},{"type":"image","src":"/content/ab-731/q-044-answer.jpg","alt":"AB-731 source answer frame for question 44","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 44 · video frame around 01:13:50","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4430s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q045","topicId":"practice-images","title":"Question 45","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Microsoft 365 Copilot enables users to search across emails, files, chats, meetings, and connected apps, by using natural language queries."},{"id":"s2","label":"Microsoft 365 Copilot provides data protection, and helps ensure that user prompts and chat data are secure."},{"id":"s3","label":"Microsoft 365 Copilot is included in all Microsoft 365 subscriptions."}],"correctValues":{"s1":true,"s2":true,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: Yes\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-045-answer.jpg","alt":"AB-731 source answer frame for question 45","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 45 · video frame around 01:15:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4510s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q046","topicId":"practice-images","title":"Question 46","prompt":[{"type":"paragraph","text":"Your company's HR department spends a large amount time answering repetitive questions and updating policy\ndocuments.\nYou need a solution that can automate employee interactions, respond to HR-related questions, and connect to internal\nbusiness data sources.\nWhat solution should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Microsoft Security Copilot"},{"id":"b","label":"Microsoft Copilot Studio"},{"id":"c","label":"Microsoft 365 Copilot"},{"id":"d","label":"Microsoft Copilot in Azure"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nB. Microsoft Copilot Studio"},{"type":"image","src":"/content/ab-731/q-046-answer.jpg","alt":"AB-731 source answer frame for question 46","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 46 · video frame around 01:16:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4600s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q047","topicId":"practice-images","title":"Question 47","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Larger datasets can increase the cost of a generative AI solution that uses an Azure Machine Learning workspace."},{"id":"s2","label":"The cost of consuming Azure OpenAI models is primarily identified by the number of input and output tokens processed."},{"id":"s3","label":"The cost of custom generative AI solutions always remains the same regardless of the model version or capability used."}],"correctValues":{"s1":true,"s2":true,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: Yes\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-047-answer.jpg","alt":"AB-731 source answer frame for question 47","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 47 · video frame around 01:18:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4720s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q048","topicId":"practice-images","title":"Question 48","prompt":[{"type":"paragraph","text":"You need to recommend a service that supports indexing information and knowledge mining by extracting insights\nfrom documents.\nWhat should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Microsoft Foundry"},{"id":"b","label":"Azure Vision in Foundry Tools"},{"id":"c","label":"Azure Document Intelligence in Foundry Tools"},{"id":"d","label":"Azure AI Search"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nD. Azure AI Search"},{"type":"image","src":"/content/ab-731/q-048-answer.jpg","alt":"AB-731 source answer frame for question 48","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 48 · video frame around 01:20:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4830s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q049","topicId":"practice-images","title":"Question 49","prompt":[{"type":"paragraph","text":"Your company uses a fine-tuned generative AI solution trained on data that is representative of the general population.\nYou discover that some of the generated responses include inappropriate or exclusionary language based on ableist\nassumptions.\nYou need to prevent the inappropriate responses. Your solution must minimize costs. What should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Apply a newer version of the generative AI model."},{"id":"b","label":"Apply a content-moderation filter."},{"id":"c","label":"Create a new version of the solution that is trained on only inclusive and representative content."},{"id":"d","label":"Create a new version of the solution that is trained on only exclusionary content."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nB. Apply a content-moderation filter."},{"type":"image","src":"/content/ab-731/q-049-answer.jpg","alt":"AB-731 source answer frame for question 49","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 49 · video frame around 01:22:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=4920s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q050","topicId":"practice-images","title":"Question 50","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"A generative AI model guarantees factually accurate responses if the model is trained on a large dataset."},{"id":"s2","label":"Content filtering and responsible AI safeguards help a generative AI model generate safe and inoffensive content."},{"id":"s3","label":"A generative AI model always produces fair and unbiased results when the training data has been properly prepared and reviewed for fairness."}],"correctValues":{"s1":false,"s2":true,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: Yes\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-050-answer.jpg","alt":"AB-731 source answer frame for question 50","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 50 · video frame around 01:24:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5050s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q051","topicId":"practice-images","title":"Question 51","prompt":[{"type":"paragraph","text":"What is considered a best practice when forming an AI adoption team in an enterprise environment?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Include primarily IT and project management staff initially to streamline deployment, adding governance and compliance roles later."},{"id":"b","label":"Include procurement and vendor management specialists early to evaluate AI tools, involving business teams once a platform is selected."},{"id":"c","label":"Include representatives from legal, leadership, and business units to align AI initiatives with organizational priorities."},{"id":"d","label":"Include only data scientists and engineers at first to validate technical feasibility, then add other stakeholders later."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nC. Include representatives from legal, leadership, and business units to align AI initiatives with organizational priorities."},{"type":"image","src":"/content/ab-731/q-051-answer.jpg","alt":"AB-731 source answer frame for question 51","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 51 · video frame around 01:27:20","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5240s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q052","topicId":"practice-images","title":"Question 52","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"You can use Azure Language in Foundry Tools to analyze the sentiment of customer reviews."},{"id":"s2","label":"languages. You can use Azure Language in Foundry Tools to translate internal reports into multiple"},{"id":"s3","label":"You can use Azure Language in Foundry Tools to extract text from scanned documents."}],"correctValues":{"s1":true,"s2":true,"s3":false}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: Yes\nStatement 3: No"},{"type":"image","src":"/content/ab-731/q-052-answer.jpg","alt":"AB-731 source answer frame for question 52","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 52 · video frame around 01:29:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=5340s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q053","topicId":"practice-images","title":"Question 53","prompt":[{"type":"paragraph","text":"What should you use for each task? To answer, select the appropriate options in the answer area.\nExtracting structured data from forms and invoices:\nSummarizing written content from business reports:"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Extracting structured data from forms and invoices:","allowedChoiceIds":["c1","c2","c3"]},{"id":"p2","label":"Summarizing written content from business reports:","allowedChoiceIds":["c1","c2","c3"]},{"id":"p3","label":"Generating descriptive text for uploaded images:","allowedChoiceIds":["c1","c2","c3"]}],"choices":[{"id":"c1","label":"Azure Language in Foundry Tools"},{"id":"c2","label":"Azure Document Intelligence in Foundry Tools"},{"id":"c3","label":"Azure Vision in Foundry Tools"}],"allowReuse":true,"correctPairs":{"p1":"c2","p2":"c1","p3":"c3"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nExtracting structured data from forms and in