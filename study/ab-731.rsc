8:[["$","$L11","ab-731",{"course":{"schemaVersion":"1.0","id":"ab-731","revision":3,"title":"AB-731: AI Transformation Leader","subtitle":"100 exam-prep practice questions · extracted questions, answers and grading","description":"Structured AB-731 practice questions extracted from the supplied YouTube source. Questions, answer choices and source-marked correct answers are preserved for interactive practice and review.","language":"en","icon":"brain","accent":"blue","coverImage":"/content/course-icons/ab-731.png","status":"published","topics":[{"id":"practice-images","title":"Practice question images","description":"Original question screens captured from the supplied practice video."}],"contexts":[],"questions":[{"id":"ab731-q001","topicId":"practice-images","title":"Question 1","prompt":[{"type":"paragraph","text":"Your company manages an online catalog of office supplies. You plan to use a generative AI solution to create product\ndescriptions for your company's website. The solution must meet the following requirements:\n• Ensure that the descriptions can be posted immediately after they are created.\n• Enable the selection and inclusion of product details in each description.\n• Be fast and simple for non-technical staff to use.\nWhat is the best type of solution to use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"custom Azure Machine Learning model"},{"id":"b","label":"the Researcher agent in Microsoft 365 Copilot"},{"id":"c","label":"an interactive AI agent"},{"id":"d","label":"a fine-tuned large language model (LLM)"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nC. an interactive AI agent"},{"type":"image","src":"/content/ab-731/q-001-answer.jpg","alt":"AB-731 source answer frame for question 1","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 1 · video frame around 00:00:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=0s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q002","topicId":"practice-images","title":"Question 2","prompt":[{"type":"paragraph","text":"Your company plans to use generative AI to help build a website that will showcase various existing products.\nWhich capability best describes a benefit of using generative AI for this project?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"creating product descriptions based on product specifications"},{"id":"b","label":"designing a new product based on customer requirements"},{"id":"c","label":"translating product descriptions into a different language"},{"id":"d","label":"analyzing product sales to identify patterns and trends"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nA. creating product descriptions based on product specifications"},{"type":"image","src":"/content/ab-731/q-002-answer.jpg","alt":"AB-731 source answer frame for question 2","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 2 · video frame around 00:01:50","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=110s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q003","topicId":"practice-images","title":"Question 3","prompt":[{"type":"paragraph","text":"Your company wants to ensure that AI solutions are used responsibly and align with company values and compliance\nrequirements.\nYou need to establish governance principles for AI use.\nWhich two actions should you perform?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Allow each department to tailor governance processes for its own AI initiatives."},{"id":"b","label":"Define accountability norms for AI decisions across business and technical teams."},{"id":"c","label":"Create a process to review AI initiatives for responsible AI alignment."},{"id":"d","label":"Assign governance ownership primarily to the AI engineering and data science teams."},{"id":"e","label":"Focus governance efforts on AI systems that handle regulated or sensitive data."}],"correctOptionIds":["b","c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nB. Define accountability norms for AI decisions across business and technical teams.\nC. Create a process to review AI initiatives for responsible AI alignment."},{"type":"image","src":"/content/ab-731/q-003-answer.jpg","alt":"AB-731 source answer frame for question 3","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 3 · video frame around 00:03:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=220s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q004","topicId":"practice-images","title":"Question 4","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Using incomplete or poor-quality data during generative AI model training can increase costs."},{"id":"s2","label":"AI models rely on training data to learn patterns and identify relationships to produce outputs."},{"id":"s3","label":"Generative AI models trained on non-representative datasets can produce inaccurate or unbalanced results."}],"correctValues":{"s1":true,"s2":true,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: Yes\nStatement 2: Yes\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-004-answer.jpg","alt":"AB-731 source answer frame for question 4","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 4 · video frame around 00:05:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=330s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q005","topicId":"practice-images","title":"Question 5","prompt":[{"type":"paragraph","text":"Your company plans to use generative AI to help summarize and analyze internal business documents.\nYou need to recommend a solution to prevent generative AI from accessing confidential or classified information. What\nshould you include in the recommendation?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"an information barrier(IB) policy"},{"id":"b","label":"communication monitoring"},{"id":"c","label":"a data retention policy"},{"id":"d","label":"data governance"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nD. data governance"},{"type":"image","src":"/content/ab-731/q-005-answer.jpg","alt":"AB-731 source answer frame for question 5","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 5 · video frame around 00:06:50","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=410s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q006","topicId":"practice-images","title":"Question 6","prompt":[{"type":"paragraph","text":"Your company sells hiking and camping gear online.\nYou need a generative AI solution that can interact with customers and ask questions about their needs. What should you\ninclude in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a chatbot"},{"id":"b","label":"predictive AI"},{"id":"c","label":"computer vision"},{"id":"d","label":"a recommendation engine"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nA. a chatbot"},{"type":"image","src":"/content/ab-731/q-006-answer.jpg","alt":"AB-731 source answer frame for question 6","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 6 · video frame around 00:08:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=520s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q007","topicId":"practice-images","title":"Question 7","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nWhen you use Microsoft 365 Copilot connectors to connect external content to [blank], your users can find, summarize, and learn from line-of-business (LOB) data by using natural language prompts."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"The Microsoft service that completes the sentence is","allowedChoiceIds":["c1","c2","c3"]}],"choices":[{"id":"c1","label":"Microsoft Graph"},{"id":"c2","label":"Microsoft Purview"},{"id":"c3","label":"Microsoft SharePoint"}],"allowReuse":false,"correctPairs":{"p1":"c1"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nThe Microsoft service that completes the sentence is: Microsoft Graph"},{"type":"image","src":"/content/ab-731/q-007-answer.jpg","alt":"AB-731 source answer frame for question 7","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 7 · video frame around 00:10:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=610s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q008","topicId":"practice-images","title":"Question 8","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nAn organization that runs continuous, large-scale workloads with Azure OpenAI models should choose the [blank] pricing model."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"The pricing model is","allowedChoiceIds":["c1","c2","c3"]}],"choices":[{"id":"c1","label":"Batch API"},{"id":"c2","label":"Provisioned (PTUs)"},{"id":"c3","label":"Standard (On-Demand)"}],"allowReuse":false,"correctPairs":{"p1":"c2"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nThe pricing model is: Provisioned (PTUs)"},{"type":"image","src":"/content/ab-731/q-008-answer.jpg","alt":"AB-731 source answer frame for question 8","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 8 · video frame around 00:11:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=690s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q009","topicId":"practice-images","title":"Question 9","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Microsoft Copilot in Outlook can automatically send follow-up replies to emails."},{"id":"s2","label":"Microsoft Copilot in Outlook can identify and surface tasks mentioned in your emails."},{"id":"s3","label":"Microsoft Copilot in Outlook can summarize long email threads and highlight action items and deadlines."}],"correctValues":{"s1":false,"s2":true,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: Yes\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-009-answer.jpg","alt":"AB-731 source answer frame for question 9","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 9 · video frame around 00:13:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=780s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q010","topicId":"practice-images","title":"Question 10","prompt":[{"type":"paragraph","text":"You have a business unit that uses an AI solution to process loan applications.\nYou discover that the solution rejects the application of all applicants that are older than 60 years of age. Which Microsoft\nresponsible AI principle is this violating?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"accountability"},{"id":"b","label":"transparency"},{"id":"c","label":"reliability and safety"},{"id":"d","label":"fairness"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nD. fairness"},{"type":"image","src":"/content/ab-731/q-010-answer.jpg","alt":"AB-731 source answer frame for question 10","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 10 · video frame around 00:14:10","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=850s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q011","topicId":"practice-images","title":"Question 11","prompt":[{"type":"paragraph","text":"Match the Microsoft responsible AI principles to the appropriate descriptions.\nTo answer, drag the principle from the column on the left to its description on the right. Each principle may be used once,\nmore than once, or not at all."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Protect personal information and apply strong safeguards to keep data secure.","allowedChoiceIds":["c1","c2","c3","c4","c5","c6"]},{"id":"p2","label":"Make AI solutions understandable by explaining how and why decisions are made.","allowedChoiceIds":["c1","c2","c3","c4","c5","c6"]},{"id":"p3","label":"Design AI solutions that are accessible to people of all abilities and experiences.","allowedChoiceIds":["c1","c2","c3","c4","c5","c6"]},{"id":"p4","label":"Involve human oversight in the control of AI solutions.","allowedChoiceIds":["c1","c2","c3","c4","c5","c6"]}],"choices":[{"id":"c1","label":"Fairness"},{"id":"c2","label":"Reliability and safety"},{"id":"c3","label":"Privacy and security"},{"id":"c4","label":"Inclusiveness"},{"id":"c5","label":"Transparency"},{"id":"c6","label":"Accountability"}],"allowReuse":true,"correctPairs":{"p1":"c3","p2":"c5","p3":"c4","p4":"c6"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nProtect personal information and apply strong safeguards to keep data secure.: Privacy and security\nMake AI solutions understandable by explaining how and why decisions are made.: Transparency\nDesign AI solutions that are accessible to people of all abilities and experiences.: Inclusiveness\nInvolve human oversight in the control of AI solutions.: Accountability"},{"type":"image","src":"/content/ab-731/q-011-answer.jpg","alt":"AB-731 source answer frame for question 11","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 11 · video frame around 00:15:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=930s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q012","topicId":"practice-images","title":"Question 12","prompt":[{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Retrieval Augmented Generation (RAG) architectures require that a large language model (LLM) be retrained on proprietary data."},{"id":"s2","label":"Retrieval-Augmented Generation (RAG) grounds a language model to produce more factual and context-relevant responses."},{"id":"s3","label":"Retrieval Augmented Generation (RAG) retrieves information from external knowledge sources at runtime instead of relying solely on the knowledge of a generative AI model."}],"correctValues":{"s1":false,"s2":true,"s3":true}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nStatement 1: No\nStatement 2: Yes\nStatement 3: Yes"},{"type":"image","src":"/content/ab-731/q-012-answer.jpg","alt":"AB-731 source answer frame for question 12","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 12 · video frame around 00:18:20","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=1100s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q013","topicId":"practice-images","title":"Question 13","prompt":[{"type":"paragraph","text":"Your company is deploying Microsoft 365 Copilot. The deployment must provide users with access to the Researcher\nagent to search across data in Microsoft SharePoint.\nYou need to recommend a licensing plan for the solution. What should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a Microsoft 365 Copilot per-user add-on license"},{"id":"b","label":"pay-as-you-go"},{"id":"c","label":"a Microsoft 365 subscription entitlement"},{"id":"d","label":"a usage-based consumption license in Azure"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nA. a Microsoft 365 Copilot per-user add-on license"},{"type":"image","src":"/content/ab-731/q-013-answer.jpg","alt":"AB-731 source answer frame for question 13","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 13 · video frame around 00:19:50","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=1190s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q014","topicId":"practice-images","title":"Question 14","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nThe Researcher agent in Microsoft 365 Copilot [blank]."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"The Researcher agent","allowedChoiceIds":["c1","c2","c3","c4"]}],"choices":[{"id":"c1","label":"creates visual dashboards from structured data in Microsoft Excel and Power Bl."},{"id":"c2","label":"generates a pivot table and performs time series forecasting."},{"id":"c3","label":"performs complex, multi-step, data analysis and code execution tasks over arbitrary datasets."},{"id":"c4","label":"uses reasoning capabilities to generate deep insights based on organizational data and the web."}],"allowReuse":false,"correctPairs":{"p1":"c4"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nThe Researcher agent: uses reasoning capabilities to generate deep insights based on organizational data and the web."},{"type":"image","src":"/content/ab-731/q-014-answer.jpg","alt":"AB-731 source answer frame for question 14","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 14 · video frame around 00:21:40","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=1300s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q015","topicId":"practice-images","title":"Question 15","prompt":[{"type":"paragraph","text":"You plan to meet with a group of stakeholders to discuss how generative AI can benefit your company.\nYou need to provide the stakeholders with a relevant description of generative AI during the meeting. Which description\nshould you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Generative AI is designed to generate responses based on a user's natural language prompts."},{"id":"b","label":"Generative AI is designed to translate documents into other languages."},{"id":"c","label":"Generative AI is designed to predict future trends based on historical data."},{"id":"d","label":"Generative AI is designed to recommend products based on user behavior."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nA. Generative AI is designed to generate responses based on a user's natural language prompts."},{"type":"image","src":"/content/ab-731/q-015-answer.jpg","alt":"AB-731 source answer frame for question 15","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 15 · video frame around 00:23:30","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=1410s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q016","topicId":"practice-images","title":"Question 16","prompt":[{"type":"paragraph","text":"Select the answer that correctly completes the sentence.\nEffective prompt engineering increases the [blank]."}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Effective prompt engineering increases the","allowedChoiceIds":["c1","c2","c3"]}],"choices":[{"id":"c1","label":"storage capacity required for AI data."},{"id":"c2","label":"training time required for generative AI models."},{"id":"c3","label":"accuracy and relevance of AI-generated responses."}],"allowReuse":false,"correctPairs":{"p1":"c3"}},"explanation":[{"type":"paragraph","text":"Correct answer(s) from the source:\nEffective prompt engineering increases the: accuracy and relevance of AI-generated responses."},{"type":"image","src":"/content/ab-731/q-016-answer.jpg","alt":"AB-731 source answer frame for question 16","caption":"Source answer frame from the supplied YouTube video."}],"optionExplanations":[],"source":{"name":"AB-731: AI Transformation Leader - All 100 Exam Prep Practice Questions with Answers (YouTube video)","locator":"Question 16 · video frame around 00:25:00","url":"https://www.youtube.com/watch?v=C4m8LS2Jzqs&t=1500s"},"review":{"status":"ready","notes":[]}},{"id":"ab731-q017","topicId":"practice-images","title":"Question 17","prompt":[{"type":"paragraph","text":"Your company uses a generative AI solution.\nYou need to improve the quality of responses by using grounding.\nWhich statement accurately describes how grounding improves accuracy and relevancy?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"references a diverse set of people, disciplines, and perspectives"},{"id":"b","label":"explains how and why AI models generate content"},{"id":