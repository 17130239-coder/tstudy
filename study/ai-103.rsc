Retrieves a specific version, not the agent itself, and is unnecessary for basic access.8:[["$","$L11","ai-103",{"course":{"schemaVersion":"1.0","id":"ai-103","revision":2,"title":"AI-103","subtitle":"Azure AI Apps and Agents Developer Associate","description":"175 câu hỏi từ tài liệu AI-103, kèm đáp án, giải thích và hình gốc. Học từng câu theo nhịp của bạn, hoặc mở đáp án để ôn nhanh.","language":"en","icon":"brain","accent":"indigo","coverImage":"/content/course-icons/ai-103.png","status":"published","topics":[{"id":"practice","title":"Practice questions","description":"Microsoft Foundry, agents, search, safety, vision, language and speech."},{"id":"case-study","title":"Case study · Contoso","description":"Tình huống chung cho câu 166–175."}],"contexts":[{"id":"contoso","title":"Contoso · Case study","content":[{"type":"paragraph","text":"$12"}],"source":{"name":"AI-103 1.pdf","locator":"pages 178–180","url":""}}],"questions":[{"id":"ai103-q001","topicId":"practice","title":"Question 1","prompt":[{"type":"paragraph","text":"You are building a speech processing solution in Microsoft Foundry for a customer support platform.\nThe platform will transcribe live phone calls, so that supervisors at your company can view call transcripts\nand detect issues while the calls are in progress. The call audio will arrive as a continuous stream from the\ntelephony system.\nYou need to ensure that the call transcripts appear within only a few seconds of the audio stream.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Use text to speech by using a custom neural voice."},{"id":"b","label":"Use speech translation to generate the transcripts into multiple languages."},{"id":"c","label":"Run a batch transcription job on recorded audio files."},{"id":"d","label":"Use real-time speech to text to process streaming audio input."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$13"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q1 · pages 2–2","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q002","topicId":"practice","title":"Question 2","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent ingests scanned PDF vendor invoices that contain tables and embedded QR codes.\nThe agent must preserve the PDF layout in the extracted output to ensure that downstream processing can\nreference sections and tables.\nYou plan to call Azure Content Understanding in Foundry Tools.\nYou need to extract content and layout elements and detect QR codes without requiring a language model\ndeployment.\nWhich built-in analyzer should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"prebuilt-documentFieldSchema"},{"id":"b","label":"prebuilt-read"},{"id":"c","label":"prebuilt-documentSearch"},{"id":"d","label":"prebuilt-layout"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$14"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q2 · pages 2–3","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q003","topicId":"practice","title":"Question 3","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent accepts user-uploaded screenshots and uses a multimodal chat model. Some screenshots contain\npotentially malicious embedded text.\nYou need to prevent a prompt injection attack and ensure that third-party content is treated as lower trust.\nHow should you configure prompt shields for document attacks?"},{"type":"image","src":"/content/ai-103/figure-36.png","alt":"Original diagram from AI-103, page 4","caption":"Source: AI-103 PDF · page 4"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Prompt shields action","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Additional mitigation","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Disable prompt shields"},{"id":"p1-c2","label":"Set action to Block"},{"id":"p1-c3","label":"Set action to Annotate"},{"id":"p2-c1","label":"Enable Spotlighting"},{"id":"p2-c2","label":"Create a custom blocklist"},{"id":"p2-c3","label":"Use OCR to extract text"}],"allowReuse":true,"correctPairs":{"p1":"p1-c2","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-37.png","alt":"Original diagram from AI-103, page 4","caption":"Source: AI-103 PDF · page 4"},{"type":"paragraph","text":"$15"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q3 · pages 3–5","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q004","topicId":"practice","title":"Question 4","prompt":[{"type":"paragraph","text":"You are building a web app named App1 that generates responses by using a model deployed to a\nMicrosoft Foundry project named Project1. Before sending the prompts to the model, App1 must retrieve\ndocuments by using Azure AI Search. You need to integrate Project1 and App1.\nThe solution must meet the following requirements:\n• Multiple client applications must use the same search configuration.\n• A security policy must prevent key-based authentication.\n• Administrative effort must be minimized.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create a custom HTTP connection in Foundry and manually configure Azure AI Search endpoints per application."},{"id":"b","label":"Configure an Azure AI Search connection in Project1 and reference the connection in each application."},{"id":"c","label":"Call Azure AI Search directly from each application by using Microsoft Entra authentication."},{"id":"d","label":"Enable a managed identity for each application and call Azure AI Search directly."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$16"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q4 · pages 5–6","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q005","topicId":"practice","title":"Question 5","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent. The agent calls an internal\nknowledge API tool before generating responses.\nUsers report the following issues:\n• Some requests take more than 15 seconds to complete.\n• Some responses are incorrect, even when the knowledge API returns the expected data.\nYou need to inspect individual agent runs to view the ordered sequence of large language model (LLM) calls,\ntool invocations, and timing information.\nWhich observability capability should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"token usage"},{"id":"b","label":"monitoring"},{"id":"c","label":"safety metrics"},{"id":"d","label":"tracing"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$17"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q5 · pages 6–6","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q006","topicId":"practice","title":"Question 6","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent used by the financial analysts at your\ncompany. You need to optimize the agent workflow by providing additional data access and processing\ncapabilities. The solution must meet the following requirements:\n• Ensure that the agent can perform calculations during conversations.\n• Ensure that the agent can access up-to-date information from public websites.\n• Ensure that the agent can retrieve information from documents uploaded directly to the agent.\nWhat should you use for each requirement? To answer, drag the appropriate tools to the correct\nrequirements. Each tool may be used once, more than once, or not at all."},{"type":"image","src":"/content/ai-103/figure-49.png","alt":"Original diagram from AI-103, page 7","caption":"Source: AI-103 PDF · page 7"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Access up-to-date information from public websites"},{"id":"p2","label":"Perform calculations"},{"id":"p3","label":"Retrieve information from uploaded documents"}],"choices":[{"id":"c1","label":"Code interpreter"},{"id":"c2","label":"Computer use"},{"id":"c3","label":"File search"},{"id":"c4","label":"Grounding with Bing Search"},{"id":"c5","label":"Microsoft Fabric"}],"allowReuse":true,"correctPairs":{"p1":"c4","p2":"c1","p3":"c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-50.png","alt":"Original diagram from AI-103, page 7","caption":"Source: AI-103 PDF · page 7"},{"type":"paragraph","text":"$18"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q6 · pages 7–8","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q007","topicId":"practice","title":"Question 7","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project named Project1 that contains an agent. The agent uses an\nOpenAPI 3.0 specification to call an external weather service.\nThe weather service requires a key to be passed in an HTTP header. The key value is stored as a connection\nin Project1.\nYou need to ensure that the key value from the connection is included automatically whenever the OpenAPI\ntool is invoked.\nWhat should you configure in the OpenAPI specification?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a header parameter defined for each operation"},{"id":"b","label":"an Azure Key Vault connection"},{"id":"c","label":"an API key security scheme"},{"id":"d","label":"a Bearer token security scheme"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$19"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q7 · pages 8–9","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q008","topicId":"practice","title":"Question 8","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains three agents as shown in the following table."},{"type":"image","src":"/content/ai-103/figure-55.png","alt":"Original diagram from AI-103, page 9","caption":"Source: AI-103 PDF · page 9"},{"type":"paragraph","text":"You need to orchestrate the agents to ensure that the customer requests meet the following requirements:\n• Support a deterministic, step-based process that uses conditional branching and shared state across\nthe agents.\n• Optionally trigger a ticket action based on the triage result.\n• The solution must minimize development effort.\nWhat should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a workflow"},{"id":"b","label":"threads and runs without a workflow"},{"id":"c","label":"a multi-agent group chat session"},{"id":"d","label":"separate agent runs coordinated in the application code"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$1a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q8 · pages 9–10","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q009","topicId":"practice","title":"Question 9","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent. The agent is deployed by\nusing a GitHub Actions workflow.\nThe organization has the following requirements:\n•\nEvery deployment to the production environment must use the latest approved evaluation baseline.\n•\nDeployments must stop automatically if the current evaluation scores regress beyond the configured\ntolerance.\nHow should you configure the workflow?"},{"type":"image","src":"/content/ai-103/figure-58.png","alt":"Original diagram from AI-103, page 10","caption":"Source: AI-103 PDF · page 10"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Evaluation comparison","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"When metrics exceed the allowed tolerance","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Latest approved baseline"},{"id":"p1-c2","label":"Previous workflow run"},{"id":"p1-c3","label":"Production deployment logs"},{"id":"p1-c4","label":"Repository default branch"},{"id":"p2-c1","label":"Continue and send an alert"},{"id":"p2-c2","label":"Fail the workflow"},{"id":"p2-c3","label":"Retry the evaluation automatically"},{"id":"p2-c4","label":"Lock the target branch"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-61.png","alt":"Original diagram from AI-103, page 11","caption":"Source: AI-103 PDF · page 11"},{"type":"paragraph","text":"$1b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q9 · pages 10–12","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q010","topicId":"practice","title":"Question 10","prompt":[{"type":"paragraph","text":"$1c"},{"type":"image","src":"/content/ai-103/figure-64.png","alt":"Original diagram from AI-103, page 12","caption":"Source: AI-103 PDF · page 12"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"The LangChain service will appear in Traces without configuring a tracer."},{"id":"s2","label":"Setting different OTEL_SERVICE_NAME values separates the services in Application Insights."},{"id":"s3","label":"When using enable_content_recording=False, prompts and tool data will be captured in the telemetry."}],"correctValues":{"s1":false,"s2":true,"s3":false}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-69.png","alt":"Original diagram from AI-103, page 12","caption":"Source: AI-103 PDF · page 12"},{"type":"paragraph","text":"$1d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q10 · pages 12–13","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q011","topicId":"practice","title":"Question 11","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent and an image generation model\ndeployment. The agent generates original images from user-supplied product photos.\nYou need to ensure that the generated images maintain the product identity and visual characteristics of the\nprovided photo.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Set the input_fidelity parameter to high."},{"id":"b","label":"Apply a groundedness detection filter."},{"id":"c","label":"Include a prompt and input image in the request."},{"id":"d","label":"Decrease the value of the temperature parameter."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$1e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q11 · pages 13–14","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q012","topicId":"practice","title":"Question 12","prompt":[{"type":"paragraph","text":"You are developing a travel planning agent by using Microsoft Foundry Agent Service.\nThe solution must meet the following requirements:\n•\nRemember each user's preferred airline and hotel chain across future conversations.\n•\nEnsure that payment card details are discarded after the conversation ends.\n•\nMinimize custom development.\nWhich implementation should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Store both preferences and payment information in persistent agent memory."},{"id":"b","label":"Store preferences in persistent agent memory and retain payment information only in orchestration- managed session context."},{"id":"c","label":"Store both preferences and payment information in conversation history."},{"id":"d","label":"Store payment information in Azure AI Search and preferences in session context."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$1f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q12 · pages 14–15","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q013","topicId":"practice","title":"Question 13","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses tools to retrieve internal\ncontent and call external APIs. The agent is configured to let the model decide when to call the tools.\nYou need to publish the agent for a compliance workflow.\nThe solution must meet the following requirements:\n• Each workflow run must include a retrieval step before generating a response.\n• Tool calls must authenticate by using the published agent’s own identity.\n• Tool access must use an identity isolated from other project resources.\n• Tool access must use support audit tracing.\nWhat should you do?"},{"type":"image","src":"/content/ai-103/figure-72.png","alt":"Original diagram from AI-103, page 15","caption":"Source: AI-103 PDF · page 15"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"tool_choice","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Authentication","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"auto"},{"id":"p1-c2","label":"none"},{"id":"p1-c3","label":"required"},{"id":"p2-c1","label":"Store API keys in the prompt"},{"id":"p2-c2","label":"Use a shared project identity"},{"id":"p2-c3","label":"Use a distinct agent identity bound to the client"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-80.png","alt":"Original diagram from AI-103, page 16","caption":"Source: AI-103 PDF · page 16"},{"type":"paragraph","text":"$20"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q13 · pages 15–16","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q014","topicId":"practice","title":"Question 14","prompt":[{"type":"paragraph","text":"You have a chat app in a Microsoft Foundry project and an Azure AI Search vectorized index.\nYou need to connect to the index to meet the following requirements:\n• Complex questions must retrieve information from multiple chunks.\n• Multi-turn conversations must influence retrieval planning.\n• Retrievals must run in parallel to reduce latency.\nWhich retrieval approach should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"iterative retrieval"},{"id":"b","label":"agentic Retrieval Augmented Generation (RAG)"},{"id":"c","label":"chain of thought"},{"id":"d","label":"classic Retrieval Augmented Generation (RAG)"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$21"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q14 · pages 17–17","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q015","topicId":"practice","title":"Question 15","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent processes scanned employee identification cards from multiple countries.\nThe solution must meet the following requirements:\n•\nExtract structured fields such as employee ID, full name, and expiration date.\n•\nReturn the extracted values as a structured schema instead of raw text.\n•\nMinimize custom post-processing.\nYou plan to call Azure Content Understanding in Foundry Tools.\nWhich built-in analyzer should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"prebuilt-layout"},{"id":"b","label":"prebuilt-documentSearch"},{"id":"c","label":"prebuilt-documentFieldSchema"},{"id":"d","label":"prebuilt-read"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$22"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q15 · pages 18–18","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q016","topicId":"practice","title":"Question 16","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a deployed ticket-triage agent.\nYou discover that sometimes the agent responds without calling any tools, even when a tool is required. You\nneed to ensure that the agent calls a tool during execution.\nHow should you complete the Python code?\nTo answer, drag the appropriate values to the correct targets. Each value may be used once, more than once,\nor not at all."},{"type":"image","src":"/content/ai-103/figure-83.png","alt":"Original diagram from AI-103, page 19","caption":"Source: AI-103 PDF · page 19"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"First blank in the Python code"},{"id":"p2","label":"Second blank in the Python code"}],"choices":[{"id":"c1","label":"\"auto\""},{"id":"c2","label":"\"required\""},{"id":"c3","label":"\"response_format\""},{"id":"c4","label":"\"tool_choice\""},{"id":"c5","label":"\"tools\""},{"id":"c6","label":"\"type\""}],"allowReuse":true,"correctPairs":{"p1":"c4","p2":"c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-84.png","alt":"Original diagram from AI-103, page 19","caption":"Source: AI-103 PDF · page 19"},{"type":"paragraph","text":"$23"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q16 · pages 18–20","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q017","topicId":"practice","title":"Question 17","prompt":[{"type":"paragraph","text":"You have a customer support agent built by using the Microsoft Foundry Agent Service. The agent calls\nan Azure OpenAI model deployment.\nDuring load testing, calls intermittently fail and return an HTTP 429 rate limit exceeded error.\nYou need to handle throttling to reduce call failures and improve reliability under load. The solution must\nremain within the service and model limits.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create a new thread and retry the calls immediately."},{"id":"b","label":"Reduce the number of registered tools."},{"id":"c","label":"Implement a retry policy that uses exponential backoff and jitter."},{"id":"d","label":"Spit uploaded content into smaller files."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$24"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q17 · pages 20–20","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q018","topicId":"practice","title":"Question 18","prompt":[{"type":"paragraph","text":"You are planning a Microsoft Foundry project named Project1 that will contain several prompt flow\napplications and agents.\nEach application must use the same Azure AI Foundry Model deployment hosted in another Azure resource.\nYou need to recommend a solution that enables all applications in Project1 to reuse the model configuration\nwithout duplicating connection settings.\nWhat should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create a connection to the model resource."},{"id":"b","label":"Configure a managed private endpoint."},{"id":"c","label":"Enable role-based access control (RBAC) on the model deployment."},{"id":"d","label":"Configure diagnostic settings for the model deployment."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$25"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q18 · pages 21–21","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q019","topicId":"practice","title":"Question 19","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent that answers questions by using Retrieval-\nAugmented Generation (RAG).\nA GitHub Actions workflow automatically deploys updates whenever a pull request is approved.\nThe organization has the following requirements:\n•\nValidate that responses remain grounded in the retrieved documents before deployment.\n•\nPrevent pull requests from being merged if the evaluation does not satisfy the required quality\nthresholds."},{"type":"image","src":"/content/ai-103/figure-91.png","alt":"Original diagram from AI-103, page 22","caption":"Source: AI-103 PDF · page 22"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Evaluation","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Branch protection policy","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Groundedness"},{"id":"p1-c2","label":"Fluency"},{"id":"p1-c3","label":"Similarity"},{"id":"p1-c4","label":"Content Safety"},{"id":"p2-c1","label":"Require successful evaluation before merge"},{"id":"p2-c2","label":"Automatically retry failed evaluations"},{"id":"p2-c3","label":"Notify reviewers"},{"id":"p2-c4","label":"Allow merge and then evaluate"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-93.png","alt":"Original diagram from AI-103, page 22","caption":"Source: AI-103 PDF · page 22"},{"type":"paragraph","text":"$26"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q19 · pages 21–23","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q020","topicId":"practice","title":"Question 20","prompt":[{"type":"paragraph","text":"You are creating an image-processing workflow in a Microsoft Foundry project. The workflow must\nmeet the following requirements:\n•\nGenerate multiple alternative versions of an existing product image for marketing campaigns.\n•\nPreserve the overall composition, lighting, and subject.\n•\nUse the built-in image generation capabilities without training a custom model.\nYou need to configure the workflow to generate several stylistic alternatives from the original image.\nHow should you configure the workflow?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Enable image_variation mode and provide the original image as the input."},{"id":"b","label":"Enable mask_inpainting and provide a mask that covers the entire image."},{"id":"c","label":"Enable text_to_image mode and describe the original image in the prompt."},{"id":"d","label":"Enable image_to_image mode with the strength parameter set to 1.0."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$27"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q20 · pages 23–24","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q021","topicId":"practice","title":"Question 21","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent uses a knowledge source built from documents stored in Azure Blob Storage. The documents\ninclude digitally scanned PDFs that contain multipage tables.\nYou have an ingestion job that extracts only plain text, causing loss of table structure, headings, and page-\nnumber metadata.\nUsers frequently ask questions that require the retrieval of specific table rows across the pages.\nYou need to configure an ingestion job for a Retrieval Augmented Generation (RAG) pipeline that performs\noptical character recognition (OCR) on scanned PDFs, preserves tables and headings as structure-aware\nchunks, and stores page-number metadata with each chunk.\nHow should you configure the ingestion job?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Use advanced data parsing to reingest the documents."},{"id":"b","label":"Use OCR and page-level chunking."},{"id":"c","label":"Use page-level OCR extraction and store each page as a single chunk."},{"id":"d","label":"Use basic parsing and fixed-size chunking."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$28"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q21 · pages 24–25","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q022","topicId":"practice","title":"Question 22","prompt":[{"type":"paragraph","text":"A Microsoft Foundry agent helps engineers troubleshoot production systems.\nThe solution must meet the following requirements:\n•\nDownload diagnostic logs from an internal web application that does not expose APIs.\n•\nAnalyze the downloaded log files to identify performance bottlenecks.\nWhich combination of tools should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Computer use and Code interpreter"},{"id":"b","label":"File search and Microsoft Fabric"},{"id":"c","label":"Grounding with Bing Search and Code interpreter"},{"id":"d","label":"Computer use and File search"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$29"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q22 · pages 25–26","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q023","topicId":"practice","title":"Question 23","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an internal Q&A agent.\nUsers report the following issues when they ask the agent questions:\nAn increase in the following response: “No relevant information found”\nPeriodic HTTP 429 rate limit exceeded errors during peak hours\nYou need to identify whether each issue is caused by model unavailability, resource limits, or inference\nfailures.\nWhat should you do?"},{"type":"image","src":"/content/ai-103/figure-102.png","alt":"Original diagram from AI-103, page 26","caption":"Source: AI-103 PDF · page 26"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Metrics","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Diagnostic log category","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Model Availability Rate and Provisioned Utilization"},{"id":"p1-c2","label":"Only Tokens Cache Match Rate"},{"id":"p1-c3","label":"Only Total Requests with status 200"},{"id":"p1-c4","label":"Time To Response and Total Tokens"},{"id":"p2-c1","label":"AllMetrics"},{"id":"p2-c2","label":"audit"},{"id":"p2-c3","label":"RequestResponse"},{"id":"p2-c4","label":"trace"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-105.png","alt":"Original diagram from AI-103, page 27","caption":"Source: AI-103 PDF · page 27"},{"type":"paragraph","text":"$2a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q23 · pages 26–28","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q024","topicId":"practice","title":"Question 24","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a prompt agent used by a customer support web\napp. The agent is invoked from a Python service that does NOT run in the Foundry portal.\nYou need to implement end-to-end tracing to capture latency breakdowns and exceptions across agent runs.\nWhich two components can you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"a Log Analytics workspace"},{"id":"b","label":"Application Insights"},{"id":"c","label":"OpenTelemetry"},{"id":"d","label":"the Azure Monitor Agent"},{"id":"e","label":"Microsoft Sentinel"}],"correctOptionIds":["b","c"]},"explanation":[{"type":"paragraph","text":"$2b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q24 · pages 28–28","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q025","topicId":"practice","title":"Question 25","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent.\nThe agent uses multiple tools during execution. Users report that responses are delayed because the agent\nwaits for several independent tool calls to complete.\nYou need to reduce the overall response time. The solution must be implemented in the application logic.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Execute independent tool calls in parallel before generating the response."},{"id":"b","label":"Increase the maximum completion tokens."},{"id":"c","label":"Replace the language model with a larger deployment."},{"id":"d","label":"Enable persistent agent memory."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$2c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q25 · pages 29–29","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q026","topicId":"practice","title":"Question 26","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent grounded in internal\ndocumentation. After a recent update, users report the following issues:\n• Some answers are unsupported by retrieved documents.\n• A small number of responses are flagged for policy violations.\nYou need to evaluate each issue.\nWhich observability signals should you use for each issue?\nTo answer, drag the appropriate observability signals to the correct issues. Each observability signal may be\nused once, more than once, or not at all."},{"type":"image","src":"/content/ai-103/figure-112.png","alt":"Original diagram from AI-103, page 30","caption":"Source: AI-103 PDF · page 30"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Identify unsupported statements"},{"id":"p2","label":"Identify policy violations"}],"choices":[{"id":"c1","label":"Groundedness evaluation metrics"},{"id":"c2","label":"Latency breakdown traces"},{"id":"c3","label":"Risk and safety metrics"},{"id":"c4","label":"Token usage analytics"}],"allowReuse":true,"correctPairs":{"p1":"c1","p2":"c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-113.png","alt":"Original diagram from AI-103, page 30","caption":"Source: AI-103 PDF · page 30"},{"type":"paragraph","text":"$2d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q26 · pages 29–30","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q027","topicId":"practice","title":"Question 27","prompt":[{"type":"paragraph","text":"You are creating an image-editing workflow in a Microsoft Foundry project.\nThe workflow must meet the following requirements:\n• Ensure that background objects can be removed by applying a mask-based inpainting edit.\n• Preserve the original lighting and style of the edited images.\n• Use the built-in image editing controls, NOT a custom model.\nYou need to ensure that image edits apply exclusively inside the masked area.\nHow should you configure the workflow?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Set generation mode to image_variation and provide the original image as a reference."},{"id":"b","label":"Enable text_to_image mode and a prompt describing the desired background removal."},{"id":"c","label":"Enable image_to_image mode and a high-strength value to regenerate the full image based on the prompt."},{"id":"d","label":"Enable mask_inpainting and supply both the input image and a mask indicating which part of the image to modify."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$2e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q27 · pages 31–31","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q028","topicId":"practice","title":"Question 28","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses Azure AI Search in\nFoundry Tools to retrieve documents from a search index.\nThe application returns an error indicating that the specified index cannot be found.\nYou verify that the Azure AI Search service is reachable and authentication succeeds.\nYou need to configure the request to reference the correct search index.\nTo what should you set the index property?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"The Azure AI Search service name"},{"id":"b","label":"The Azure AI Search endpoint URL"},{"id":"c","label":"The Azure AI Search index name"},{"id":"d","label":"The Microsoft Foundry project name"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. The Azure AI Search index name\nThe index property must be set to the Azure AI Search index name, which uniquely identifies the search\nindex that contains the documents to be queried. Since the Azure AI Search service is reachable and\nauthentication succeeds, the error indicates that the request is referencing an incorrect or non-existent\nindex. Specifying the correct index name enables the agent to retrieve documents from the intended search\nindex.\nIncorrect Answers:\nA. The Azure AI Search service name\nThe service name identifies the Azure AI Search service instance, not the specific index within that service.\nB. The Azure AI Search endpoint URL\nThe endpoint URL specifies the location of the Azure AI Search service. It does not identify which search\nindex should be queried.\nD. The Microsoft Foundry project name\nThe Microsoft Foundry project name identifies the AI project but has no relationship to the Azure AI Search\nindex used for document retrieval."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q28 · pages 32–32","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q029","topicId":"practice","title":"Question 29","prompt":[{"type":"paragraph","text":"You need to recommend a plan to create a customer support agent by using the Microsoft Foundry\nAgent Service.\nThe agent must meet the following requirements:\n• Retain user preferences across multiple conversations.\n• Enable users to provide contextual grounding by directly uploading documents during a chat.\nWhich Foundry capability should you recommend for each requirement?"},{"type":"image","src":"/content/ai-103/figure-120.png","alt":"Original diagram from AI-103, page 33","caption":"Source: AI-103 PDF · page 33"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Retain user preferences","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Contextualize uploaded files","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Persistent agent memory"},{"id":"p1-c2","label":"Conversation history"},{"id":"p1-c3","label":"Orchestration-managed session context"},{"id":"p2-c1","label":"Azure AI Search"},{"id":"p2-c2","label":"Code interpreter"},{"id":"p2-c3","label":"File search"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-121.png","alt":"Original diagram from AI-103, page 33","caption":"Source: AI-103 PDF · page 33"},{"type":"paragraph","text":"$2f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q29 · pages 32–34","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q030","topicId":"practice","title":"Question 30","prompt":[{"type":"paragraph","text":"You are developing an image-editing workflow in a Microsoft Foundry project.\nThe workflow must meet the following requirements:\n•\nReplace the sky in landscape photographs with a sunset.\n•\nModify only the selected sky region.\n•\nPreserve all foreground objects without regeneration.\n•\nUse the built-in image editing capabilities.\nYou need to configure the workflow.\nHow should you configure the workflow?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Enable image_variation mode and provide the original image."},{"id":"b","label":"Enable mask_inpainting and provide the original image together with a mask covering the sky."},{"id":"c","label":"Enable text_to_image mode and describe the desired landscape."},{"id":"d","label":"Enable image_to_image mode with a high-strength value."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$30"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q30 · pages 34–35","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q031","topicId":"practice","title":"Question 31","prompt":[{"type":"paragraph","text":"You are planning a Microsoft Foundry project named Project1 that will contain multiple agents. Each\nagent will access the same Azure AI Search resource.\nYou need to recommend a solution to centrally manage the Azure AI Search credentials within Project1. The\nsolution must be implemented across all the agents.\nWhat should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Enable role-based access control (RBAC) for the Azure AI Search resource."},{"id":"b","label":"Disable key-based access control on the Azure AI Search resource."},{"id":"c","label":"Add a connection to the Azure AI Search resource."},{"id":"d","label":"Create a managed private endpoint that connects to the Azure AI Search resource."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$31"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q31 · pages 35–35","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q032","topicId":"practice","title":"Question 32","prompt":[{"type":"paragraph","text":"You are deploying a support agent that enables users to upload photos.\nYou need to automatically classify uploaded images for harmful content. The solution must block content\nbased on severity levels.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Apply keyword scanning to optical character recognition (OCR) output by using Azure Vision in Foundry Tools."},{"id":"b","label":"Enable prompt shields."},{"id":"c","label":"Use blocklists."},{"id":"d","label":"Implement image moderation."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$32"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q32 · pages 36–36","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q033","topicId":"practice","title":"Question 33","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent named PaymentAgent.\nPaymentAgent includes a function tool that issues customer refunds by using an external API.\nYou are creating a workflow in YAML.\nYou need to ensure that the workflow pauses for human approval and continues with the refund step only\nafter approval is granted.\nHow should you complete the workflow definition?"},{"type":"image","src":"/content/ai-103/figure-130.png","alt":"Original diagram from AI-103, page 37","caption":"Source: AI-103 PDF · page 37"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"YAML type","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Condition","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"ask_question"},{"id":"p1-c2","label":"basic_chat"},{"id":"p1-c3","label":"data_transformation"},{"id":"p2-c1","label":"approval == \"approved\""},{"id":"p2-c2","label":"propose_refund.output != null"},{"id":"p2-c3","label":"true"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-131.png","alt":"Original diagram from AI-103, page 37","caption":"Source: AI-103 PDF · page 37"},{"type":"paragraph","text":"$33"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q33 · pages 36–38","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q034","topicId":"practice","title":"Question 34","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that uses Azure AI Search to ground an agent in internal\ndocumentation. After a recent content update, users report that the agent’s answers have become less\naccurate.\nYou need to identify whether the retrieved content is negatively influencing the model’s generated responses.\nWhich observability signal should you review?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"indexer status and failure history"},{"id":"b","label":"latency breakdown traces"},{"id":"c","label":"prediction drift metrics"},{"id":"d","label":"groundedness evaluation metrics"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$34"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q34 · pages 38–39","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q035","topicId":"practice","title":"Question 35","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent used by a legal department. The agent\ngenerates answers by using documents retrieved from an Azure AI Search index.\nUsers report that some answers omit important clauses from lengthy legal documents.\nYou need to improve the completeness of responses. The solution must be implemented in the application\nlogic without changing the search index or replacing the deployed model.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Increase the number of retrieved document chunks before constructing the prompt."},{"id":"b","label":"Enable Prompt Shields for document attacks."},{"id":"c","label":"Configure Content Safety to annotate responses."},{"id":"d","label":"Use a lower temperature value."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$35"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q35 · pages 39–40","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q036","topicId":"practice","title":"Question 36","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that processes procurement documents submitted by suppliers.\nYou need to implement two pipelines by using Azure Content Understanding in Foundry Tools.\nThe solution must meet the following requirements:\n• Include a pipeline named Pipeline1 that supports cost-effective, high-volume processing of\nstandalone PDF invoices.\n• Include a pipeline named Pipeline2 that supports cross-document validation by using multi-step\nreasoning and reference data.\nHow should you configure each pipeline?\nTo answer, drag the appropriate configurations to the correct pipelines. Each configuration may be used once,\nmore than once, of not at all."},{"type":"image","src":"/content/ai-103/figure-138.png","alt":"Original diagram from AI-103, page 40","caption":"Source: AI-103 PDF · page 40"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Pipeline1","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Pipeline2","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Multi-file model (pro mode)"},{"id":"p1-c2","label":"Multi-file model (standard mode)"},{"id":"p1-c3","label":"Single-file model (pro mode)"},{"id":"p1-c4","label":"Single-file model (standard mode)"},{"id":"p2-c1","label":"Multi-file model (pro mode)"},{"id":"p2-c2","label":"Multi-file model (standard mode)"},{"id":"p2-c3","label":"Single-file model (pro mode)"},{"id":"p2-c4","label":"Single-file model (standard mode)"}],"allowReuse":true,"correctPairs":{"p1":"p1-c4","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-139.png","alt":"Original diagram from AI-103, page 40","caption":"Source: AI-103 PDF · page 40"},{"type":"paragraph","text":"$36"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q36 · pages 40–41","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q037","topicId":"practice","title":"Question 37","prompt":[{"type":"paragraph","text":"You have a multimodal AI generative model that accepts image uploads and uses extracted image text\nto generate responses.\nYou discover that users can upload unsafe images and embed hidden instructions into images to manipulate\nthe model.\nYou need to implement controls to mitigate the risk.\nSolution: You configure a prompt shield for user prompts.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Prompt Shields for user prompts protect against direct prompt injection attacks where malicious instructions\nare entered directly by the user in the prompt. In this scenario, the threat comes from uploaded images\ncontaining hidden or embedded text that is extracted and supplied to the multimodal model. This is an\nindirect prompt injection (document attack). To mitigate this risk, you should configure Prompt Shields for\ndocument attacks. If the content comes from third-party sources, enabling Spotlighting provides additional\nprotection by treating that content as lower trust."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q37 · pages 41–41","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q038","topicId":"practice","title":"Question 38","prompt":[{"type":"paragraph","text":"You have a multimodal AI generative model that accepts image uploads and uses extracted image text\nto generate responses.\nYou discover that users can upload unsafe images and embed hidden instructions into images to manipulate\nthe model.\nYou need to implement controls to mitigate the risk.\nSolution: You configure image moderation to block unsafe content before processing the images.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Image moderation is designed to detect and block unsafe visual content, such as violence, sexual content,\nor other harmful imagery based on configured severity levels. However, it does not protect against hidden\nprompt injection instructions embedded as text within images. In this scenario, the risk is an indirect\nprompt injection attack, which should be mitigated by using Prompt Shields for document attacks. If the\nimages originate from external or third-party sources, Spotlighting should also be enabled to treat the\nextracted content as lower trust."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q38 · pages 42–42","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q039","topicId":"practice","title":"Question 39","prompt":[{"type":"paragraph","text":"You have a multimodal AI generative model that accepts image uploads and uses extracted image text\nto generate responses.\nYou discover that users can upload unsafe images and embed hidden instructions into images to manipulate\nthe model.\nYou need to implement controls to mitigate the risk.\nSolution: You configure a prompt shield for documents. .\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Prompt Shields for documents are specifically designed to protect against indirect prompt injection attacks\noriginating from documents, images, and other external content. In this scenario, users upload images\ncontaining hidden embedded text that is extracted and passed to the multimodal model. By enabling Prompt\nShields for documents, the service analyzes the extracted content and detects attempts to manipulate the\nmodel through embedded instructions. This directly mitigates the identified risk. For third-party or untrusted\ncontent, enabling Spotlighting provides additional protection by treating the extracted content as lower trust."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q39 · pages 42–42","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q040","topicId":"practice","title":"Question 40","prompt":[{"type":"paragraph","text":"You have a multimodal AI generative model that accepts image uploads and uses extracted image text\nto generate responses.\nYou discover that users can upload unsafe images and embed hidden instructions into images to manipulate\nthe model.\nYou need to implement controls to mitigate the risk.\nSolution: You configure protected material detection.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Protected material detection is designed to identify copyrighted or protected content, such as copyrighted\ntext, code, lyrics, or other protected material. Its purpose is to help prevent the generation or reproduction of\ncopyrighted content. It does not detect or prevent indirect prompt injection attacks where hidden\ninstructions are embedded in uploaded images. To mitigate this scenario, the appropriate control is Prompt\nShields for document attacks, which analyze extracted content from documents and images for malicious\ninstructions."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q40 · pages 43–43","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q041","topicId":"practice","title":"Question 41","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that ingests scanned PDF invoices stored in Azure Blob Storage.\nEach invoice contains printed fine items and has a table-based layout.\nExtracted results are stored as structured JSON and used as grounding data for an agent in a Retrieval\nAugmented Generation (RAG) solution.\nYou need to create a single analyzer that meets the following requirements:\n• Extracts the invoice number, invoice date, vendor name, and total amount across varying templates\n• Returns confidence scores so that results with confidence below 0.80 can be routed for supervisor\nreview\nWhat should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a Foundry agent that has groundedness guardrails enabled to extract invoice fields and confidence scores"},{"id":"b","label":"a custom Azure Content Understanding in Foundry Tools analyzer that defines the required fields as the extracted fields and the returned confidence scores for routing"},{"id":"c","label":"the Azure Content Understanding in Foundry Tools prebuilt-layout analyzer"},{"id":"d","label":"the Azure Content Understanding in Foundry Tools prebuilt-documentSearch analyzer and search.score from the Azure AI Search results for routing"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$37"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q41 · pages 43–44","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q042","topicId":"practice","title":"Question 42","prompt":[{"type":"paragraph","text":"A Microsoft Foundry agent retrieves content from external websites by using Grounding with Bing\nSearch.\nSecurity administrators want to:\n•\nDetect indirect prompt injection attempts.\n•\nReview detections before deciding whether to block requests.\nWhich configuration should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Disable Prompt Shields."},{"id":"b","label":"Configure Prompt Shields to Block."},{"id":"c","label":"Configure Prompt Shields to Annotate and enable Spotlighting."},{"id":"d","label":"Configure Content Safety to Block Hate content."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$38"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q42 · pages 44–45","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q043","topicId":"practice","title":"Question 43","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a workflow for a customer support triage process.\nYou have an Ask a question node that stores user responses in a local variable named Var01.\nYou need to create the following Power Fx expressions:\n• An if/else condition expression that ensures that Var01 contains a value\n• A Send message expression that returns the stored user response in uppercase\nHow should you configure the expressions?"},{"type":"image","src":"/content/ai-103/figure-150.png","alt":"Original diagram from AI-103, page 45","caption":"Source: AI-103 PDF · page 45"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Condition","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Message","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"IsBlank(Local.Var01)"},{"id":"p1-c2","label":"IsEmpty(Local.Var01)"},{"id":"p1-c3","label":"Not(IsBlank(Local.Var01))"},{"id":"p2-c1","label":"{Local.Var01}"},{"id":"p2-c2","label":"{Upper(Local.Var01)}"},{"id":"p2-c3","label":"{Upper(Var01)}"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-158.png","alt":"Original diagram from AI-103, page 46","caption":"Source: AI-103 PDF · page 46"},{"type":"paragraph","text":"$39"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q43 · pages 45–46","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q044","topicId":"practice","title":"Question 44","prompt":[{"type":"paragraph","text":"You have a customer support agent that uses the Microsoft Foundry Agent Service.\nSometimes, customers return to a session days later to continue the same support case, and the agent must\nresume with the full historical context.\nThe agent must provide the following:\nMulti-turn continuity within the session Cross-session continuity for the same case\n•\nAccess to the full interaction history, including user messages, agent messages, tool calls, and tool\n•\noutputs\nYou need to ensure that the agent automatically reloads the complete history on each new turn.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create and reuse a conversation by storing the conversation’s ID and supplying the ID on subsequent requests."},{"id":"b","label":"Persist only the final model response stored in the client application and prepend the response to future prompts."},{"id":"c","label":"Enable memory summarization on the agent definition to persist the context automatically."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$3a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q44 · pages 46–47","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q045","topicId":"practice","title":"Question 45","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry Agent Service project that contains an HR onboarding agent.\nEmployees frequently pause conversations and continue them several days later.\nThe solution must meet the following requirements:\n•\nResume the conversation exactly where it ended.\n•\nEnsure the agent can reference previous tool invocations and uploaded documents.\n•\nAvoid manually reconstructing conversation history.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create a new thread for each user request and copy previous responses into the prompt."},{"id":"b","label":"Persist the thread ID and continue subsequent requests by using the existing thread."},{"id":"c","label":"Store conversation summaries in persistent memory and start a new thread for every session."},{"id":"d","label":"Save only the final assistant response and include it as context in future requests."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$3b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q45 · pages 47–48","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q046","topicId":"practice","title":"Question 46","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that processes regulatory compliance documents submitted by\nregional offices.\nYou need to implement two pipelines by using Content Understanding in Microsoft Foundry Tools.\nThe solution must meet the following requirements:\n•\nInclude a pipeline named Pipeline1 that extracts key compliance information from individual audit\nreports while minimizing processing costs.\n•\nInclude a pipeline named Pipeline2 that analyzes multiple related audit reports together to identify\ninconsistencies across reporting periods by using advanced reasoning.\nHow should you configure each pipeline?\nTo answer, drag the appropriate configurations to the correct pipelines. Each configuration may be used once,\nmore than once, or not at all."},{"type":"image","src":"/content/ai-103/figure-138.png","alt":"Original diagram from AI-103, page 48","caption":"Source: AI-103 PDF · page 48"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Pipeline1","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Pipeline2","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Multi-file model (pro mode)"},{"id":"p1-c2","label":"Multi-file model (standard mode)"},{"id":"p1-c3","label":"Single-file model (pro mode)"},{"id":"p1-c4","label":"Single-file model (standard mode)"},{"id":"p2-c1","label":"Multi-file model (pro mode)"},{"id":"p2-c2","label":"Multi-file model (standard mode)"},{"id":"p2-c3","label":"Single-file model (pro mode)"},{"id":"p2-c4","label":"Single-file model (standard mode)"}],"allowReuse":true,"correctPairs":{"p1":"p1-c4","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-139.png","alt":"Original diagram from AI-103, page 49","caption":"Source: AI-103 PDF · page 49"},{"type":"paragraph","text":"$3c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q46 · pages 48–49","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q047","topicId":"practice","title":"Question 47","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a high-traffic agent. After a recent update,\noperational costs increase significantly.\nMonitoring confirms that the volume of user traffic to the agent remains unchanged.\nYou suspect that changes to the request or response characteristics are causing the increase.\nYou need to identify whether the additional costs are driven by the model input size, the model output size, or\nexpanded tool usage.\nWhich observability capability should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"latency"},{"id":"b","label":"evaluation metrics"},{"id":"c","label":"run success rate"},{"id":"d","label":"token usage"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$3d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q47 · pages 49–50","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q048","topicId":"practice","title":"Question 48","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an Azure Storage account used to store documents\nfor Retrieval-Augmented Generation (RAG).\nThe agents authenticate by using managed identities.\nThe agents must be able to read blob data but must not upload, modify, or delete files.\nWhich role-based access control (RBAC) role should you assign to the managed identities?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Storage Blob Data Owner"},{"id":"b","label":"Storage Blob Data Contributor"},{"id":"c","label":"Storage Blob Data Reader"},{"id":"d","label":"Contributor"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. Storage Blob Data Reader\nThe Storage Blob Data Reader role grants read-only access to blob data in an Azure Storage account. It\nallows managed identities to read and download blobs, which is exactly what Retrieval-Augmented\nGeneration (RAG) agents need to retrieve documents. At the same time, it prevents uploading, modifying, or\ndeleting blobs, satisfying the principle of least privilege and meeting the security requirements.\nIncorrect Answers:\nA. Storage Blob Data Owner\nThis role provides full control over blob data, including reading, writing, deleting, and managing permissions,\nwhich exceeds the required permissions.\nB. Storage Blob Data Contributor\nThis role allows reading, creating, modifying, and deleting blob data. It grants write permissions that are not\nrequired.\nD. Contributor\nThe Contributor role provides management access to Azure resources but does not specifically grant blob\ndata access. It also grants far more permissions than are needed for read-only document retrieval."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q48 · pages 50–51","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q049","topicId":"practice","title":"Question 49","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nYou use a GitHub Actions workflow for CI/CD.\nYou need to configure the workflow to automatically evaluate the agent when a pull request (PR) is created\nand prevent branches from merging if the evaluation results do NOT meet the defined thresholds.\nHow should you configure the workflow?"},{"type":"image","src":"/content/ai-103/figure-169.png","alt":"Original diagram from AI-103, page 51","caption":"Source: AI-103 PDF · page 51"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Authentication","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Evaluation failure","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Personal access token"},{"id":"p1-c2","label":"User-assigned managed identity"},{"id":"p1-c3","label":"Azure Login with OpenID Connect (OIDC)"},{"id":"p2-c1","label":"Lock the branch"},{"id":"p2-c2","label":"Send an alert"},{"id":"p2-c3","label":"Fail the workflow"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-170.png","alt":"Original diagram from AI-103, page 51","caption":"Source: AI-103 PDF · page 51"},{"type":"paragraph","text":"$3e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q49 · pages 51–52","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q050","topicId":"practice","title":"Question 50","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses Azure Speech in Foundry\nTools. You fine-tune a baseline speech to text model for the en-us locale and publish the model.\nThe agent calls the Speech to text REST API and returns an error message indicating that the project ID is\ninvalid. You need to set the project property to the correct ID.\nTo what should you set the project property?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"the project URL"},{"id":"b","label":"the custom speech project ID"},{"id":"c","label":"the project ID"},{"id":"d","label":"the custom speech endpoint URL"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. the custom speech project ID\nWhen using a custom Speech-to-Text model that has been trained and published in Azure Speech, the\nSpeech-to-Text REST API expects the project property to contain the Custom Speech project ID. This unique\nidentifier associates the request with the correct custom speech project and its published models. If an\ninvalid or incorrect ID is provided, the service returns an error indicating that the project ID is invalid.\nIncorrect Answers:\nA. the project URL\nThe REST API expects a project ID, not the URL of the project.\nC. the project ID\nThe generic Microsoft Foundry project ID is different from the Custom Speech project ID required by the\nSpeech service.\nD. the custom speech endpoint URL\nThe endpoint URL specifies where the request is sent, but it is not used as the value of the project property."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q50 · pages 52–53","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q051","topicId":"practice","title":"Question 51","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project named Project1.\nProject1 contains an application that processes PDF vendor invoices.\nYou need to configure Azure Document Intelligence in Foundry Tools to generate a Markdown output that\npreserves the sections and table structure of the PDFs. The solution must minimize development effort.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Configure output=figures when you analyze the PDF."},{"id":"b","label":"Configure content=markdown when you analyze the document."},{"id":"c","label":"Increase the confidence threshold."},{"id":"d","label":"Set the output_content_format=ContentFormat.MARKDOWN value."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$3f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q51 · pages 53–54","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q052","topicId":"practice","title":"Question 52","prompt":[{"type":"paragraph","text":"A legal research agent must satisfy the following requirements:\n•\nSearch contracts uploaded by users during an active conversation.\n•\nSearch millions of historical court decisions stored in a centralized enterprise index.\nWhich combination should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"File Search for both requirements"},{"id":"b","label":"Azure AI Search for both requirements"},{"id":"c","label":"File Search for uploaded contracts and Azure AI Search for historical court decisions"},{"id":"d","label":"Microsoft Fabric for uploaded contracts and File Search for historical court decisions"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$40"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q52 · pages 54–54","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q053","topicId":"practice","title":"Question 53","prompt":[{"type":"paragraph","text":"You have a Python application named App1 that integrates with a Microsoft Foundry project named\nProject1.\nYou need to ensure that App1 meets the following requirements:\n• Authenticates by using a Microsoft Entra managed identity\n• Sends prompts to a deployed model by using the Azure OpenAI Responses API\nHow should you complete the Python code?"},{"type":"image","src":"/content/ai-103/figure-179.png","alt":"Original diagram from AI-103, page 55","caption":"Source: AI-103 PDF · page 55"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Credential","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Responses API method","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"AzureKeyCredential"},{"id":"p1-c2","label":"ClientSecretCredential"},{"id":"p1-c3","label":"DefaultAzureCredential"},{"id":"p2-c1","label":"compact"},{"id":"p2-c2","label":"create"},{"id":"p2-c3","label":"retrieve"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-181.png","alt":"Original diagram from AI-103, page 55","caption":"Source: AI-103 PDF · page 55"},{"type":"paragraph","text":"$41"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q53 · pages 55–56","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q054","topicId":"practice","title":"Question 54","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that generates product marketing images from text prompts.\nAfter publishing several images, the legal team at your company identifies a competitor’s logo on a sign in\nthe background of an image.\nYou need to remove only the logo, while preserving the rest of the image.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Apply a mask-based inpainting edit to the part of the image that contains the logo."},{"id":"b","label":"Increase the prompt guidance strength."},{"id":"c","label":"Modify the original prompt to exclude brand names."},{"id":"d","label":"Rerun the prompt by using a different random seed."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$42"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q54 · pages 56–57","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q055","topicId":"practice","title":"Question 55","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent processes scanned maintenance reports that are uploaded by field technicians.\nThe solution must meet the following requirements:\n•\nExtract all readable text from each document.\n•\nIgnore the document layout, including tables and paragraph positions.\n•\nDo not identify key-value pairs or structured business fields.\n•\nMinimize processing costs and avoid using a language model deployment.\nYou plan to call Azure Content Understanding in Foundry Tools.\nWhich built-in analyzer should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"prebuilt-documentFieldSchema"},{"id":"b","label":"prebuilt-layout"},{"id":"c","label":"prebuilt-read"},{"id":"d","label":"prebuilt-documentSearch"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. prebuilt-read\nThe prebuilt-read analyzer is designed to perform optical character recognition (OCR) and extract all\nreadable text from documents and images. It does not attempt to preserve document layout, detect tables,\nidentify key-value pairs, or extract structured business fields. Because it focuses only on text extraction and\ndoes not require a language model deployment, it is the most cost-effective option for this scenario.\nIncorrect Answers:\nA. prebuilt-documentFieldSchema\nThis analyzer extracts structured business fields and returns them according to a predefined schema, which\nis not required.\nB. prebuilt-layout\nThe prebuilt-layout analyzer preserves document structure, including tables, paragraphs, and layout\ninformation, which the requirements specifically state should be ignored.\nD. prebuilt-documentSearch\nThis analyzer is intended for semantic document search scenarios rather than simple OCR-based text\nextraction."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q55 · pages 57–58","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q056","topicId":"practice","title":"Question 56","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a sales assistant agent. The agent retrieves product\ninformation from an Azure AI Search index and generates responses by using a large language model.\nAfter deploying a new version of the agent, users report the following issues:\n•\nThe average response time has increased significantly when users ask complex questions.\n•\nMonthly model inference costs have increased even though the number of user requests has\nremained unchanged.\nYou need to evaluate each issue.\nWhich observability signals should you use for each issue?\nTo answer, drag the appropriate observability signals to the correct issues. Each observability signal may be\nused once, more than once, or not at all."},{"type":"image","src":"/content/ai-103/figure-190.png","alt":"Original diagram from AI-103, page 58","caption":"Source: AI-103 PDF · page 58"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Investigate response times"},{"id":"p2","label":"Investigate costs"}],"choices":[{"id":"c1","label":"Groundedness evaluation metrics"},{"id":"c2","label":"Latency breakdown traces"},{"id":"c3","label":"Risk and safety metrics"},{"id":"c4","label":"Token usage analytics"}],"allowReuse":true,"correctPairs":{"p1":"c2","p2":"c4"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-191.png","alt":"Original diagram from AI-103, page 58","caption":"Source: AI-103 PDF · page 58"},{"type":"paragraph","text":"$43"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q56 · pages 58–59","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q057","topicId":"practice","title":"Question 57","prompt":[{"type":"paragraph","text":"You have an application named App1 that uses Azure Speech in Foundry Tools to transcribe live calls.\nTranscript segments often contain both English and Spanish.\nApp1 sends each segment to Azure Translator in Foundry Tools to translate to another language.\nSometimes, mixed-language segments result in incomplete or incorrect translations.\nYou need to reduce translation errors. The solution must ensure that the entire transcript is translated\nsuccessfully.\nWhat should you do before sending the segments to Translator?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Use document translation to translate the entire transcript as a single document."},{"id":"b","label":"Split the mixed-language segments into single-language segments and translate each segment separately."},{"id":"c","label":"Enable automatic language detection for the translation request."},{"id":"d","label":"Specify English as the source language in the translation request for all the segments."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$44"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q57 · pages 59–60","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q058","topicId":"practice","title":"Question 58","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent used by a customer service application.\nFollowing a recent deployment, users report that responses take significantly longer to generate. Monitoring\nshows that the number of requests per minute has remained constant.\nYou need to determine whether the increased response time is caused by document retrieval, tool execution,\nor model inference.\nWhich observability capability should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Evaluation metrics"},{"id":"b","label":"Latency"},{"id":"c","label":"Run success rate"},{"id":"d","label":"Token usage"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. Latency\nLatency observability provides a detailed breakdown of the time spent during each stage of an agent run,\nincluding document retrieval, tool execution, and model inference. Since the request volume has remained\nconstant but response times have increased, latency analysis enables you to determine exactly which stage\nis responsible for the slowdown and target the appropriate optimization.\nIncorrect Answers:\nA. Evaluation metrics\nEvaluation metrics measure response quality, such as groundedness, fluency, and similarity. They do not\nidentify performance bottlenecks.\nC. Run success rate\nRun success rate indicates whether agent executions succeed or fail, but it does not show where time is\nbeing spent during execution.\nD. Token usage\nToken usage measures the number of input and output tokens consumed. It helps analyze inference costs\nbut does not identify whether delays are caused by document retrieval, tool execution, or model inference."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q58 · pages 60–60","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q059","topicId":"practice","title":"Question 59","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that processes engineering drawings stored in Azure Blob\nStorage.\nAzure AI Content Safety must retrieve images by using blob URLs to evaluate user-submitted images.\nThe solution must meet the following requirements:\n•\nFollow the principle of least privilege.\n•\nAvoid using storage account keys or shared access signatures (SAS).\n•\nAllow Content Safety to read images stored in Azure Blob Storage."},{"type":"image","src":"/content/ai-103/figure-198.png","alt":"Original diagram from AI-103, page 61","caption":"Source: AI-103 PDF · page 61"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Authentication","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Azure RBAC role","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Storage account access keys"},{"id":"p1-c2","label":"Shared Access Signature (SAS)"},{"id":"p1-c3","label":"System-assigned managed identity"},{"id":"p1-c4","label":"User-assigned managed identity"},{"id":"p2-c1","label":"Storage Blob Data Reader"},{"id":"p2-c2","label":"Storage Blob Data Contributor"},{"id":"p2-c3","label":"Storage Queue Data Contributor"},{"id":"p2-c4","label":"Owner"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-199.png","alt":"Original diagram from AI-103, page 61","caption":"Source: AI-103 PDF · page 61"},{"type":"paragraph","text":"$45"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q59 · pages 61–62","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q060","topicId":"practice","title":"Question 60","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent and an image generation model\ndeployment.\nThe agent creates lifestyle marketing images for clothing products.\nUsers provide a photograph of a jacket and request new scenes in different environments.\nThe solution must ensure that the generated images continue to depict the same jacket while allowing the\nbackground, lighting, and setting to change.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Include the original image as a reference image in the generation request."},{"id":"b","label":"Reduce the max_tokens parameter."},{"id":"c","label":"Enable groundedness detection."},{"id":"d","label":"Configure Content Safety to annotate the generated images."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$46"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q60 · pages 62–63","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q061","topicId":"practice","title":"Question 61","prompt":[{"type":"paragraph","text":"You have an Azure Speech in Foundry Tools resource that hosts a custom speech to text model\ndeployed to a custom endpoint. An agent uses the endpoint to perform real-time speech recognition.\nYou are approaching the expiration date of the custom speech to text model.\nWhat is the expected behavior when the model expires?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Speech recognition requests will return a 4xx error until a new custom model is deployed."},{"id":"b","label":"Speech recognition requests will continue to use the expired custom model until the model is removed manually."},{"id":"c","label":"Speech recognition requests will fall back to the most recent base model for the same locale."},{"id":"d","label":"The custom model will be deleted automatically when the model expires."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$47"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q61 · pages 63–64","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q062","topicId":"practice","title":"Question 62","prompt":[{"type":"paragraph","text":"You have a technical support agent that uses the Microsoft Foundry Agent Service.\nCustomers often upload log files while troubleshooting issues. A support case can remain open for several\nweeks, and different support engineers may continue the conversation during that time.\nThe solution must meet the following requirements:\n•\nMaintain the complete conversation history across multiple sessions.\n•\nPreserve uploaded files, tool calls, tool outputs, and agent responses.\n•\nMinimize application code.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Store the thread ID after the initial conversation and provide the same thread ID when continuing the support case."},{"id":"b","label":"Store the generated responses in Azure AI Search and prepend them to every new prompt."},{"id":"c","label":"Enable persistent agent memory and allow the agent to reconstruct previous conversations automatically."},{"id":"d","label":"Store conversation summaries in a database and include the summaries in each new request."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$48"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q62 · pages 64–65","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q063","topicId":"practice","title":"Question 63","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent built by using the\nFoundry Agent Service.\nThe agent uploads user-provided screenshots to Azure Storage through a ticketing tool and receives a blob\nURL for additional reasoning.\nYou need to use image moderation during agent runs and prevent harmful content from being returned\nduring runs.\nAzure AI Content Safety must access the images by using the blob URL. The solution must follow the\nprinciple of least privilege."},{"type":"image","src":"/content/ai-103/figure-208.png","alt":"Original diagram from AI-103, page 65","caption":"Source: AI-103 PDF · page 65"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Guardrails","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Storage access","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Select Tool call and set Action to Block"},{"id":"p1-c2","label":"Select User input and Output and set Action to Annotate"},{"id":"p1-c3","label":"Select User input and Tool response and set Action to Annotate"},{"id":"p1-c4","label":"Select User input, Output, Tool response, and Tool call and set Action to Block"},{"id":"p2-c1","label":"Storage account access keys"},{"id":"p2-c2","label":"User-assigned identity with Storage Queue Data Contributor"},{"id":"p2-c3","label":"System-assigned managed identity with Storage Blob Data Reader"},{"id":"p2-c4","label":"System-assigned managed identity with Storage Blob Data Contributor"}],"allowReuse":true,"correctPairs":{"p1":"p1-c4","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-211.png","alt":"Original diagram from AI-103, page 66","caption":"Source: AI-103 PDF · page 66"},{"type":"paragraph","text":"$49"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q63 · pages 65–67","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q064","topicId":"practice","title":"Question 64","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nYou need to improve response completeness. The solution must be implemented in the logic of the\napplication code before responses are returned.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Add a retry evaluation before the responses are returned."},{"id":"b","label":"Decrease the value of the max_tokens parameter."},{"id":"c","label":"Switch to Retrieval Augmented Generation (RAG)."},{"id":"d","label":"Replace the model with a smaller deployment."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$4a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q64 · pages 67–67","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q065","topicId":"practice","title":"Question 65","prompt":[{"type":"paragraph","text":"You have an app named App1 that uses a Microsoft Foundry chat model deployment.\nApp1 accepts free-form text entered directly by users.\nSome users intentionally submit prompts that attempt to bypass system instructions, reveal hidden prompts,\nor manipulate tool execution.\nYou need to detect these direct prompt injection attempts before the model processes the user's input.\nWhat should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Image moderation"},{"id":"b","label":"Prompt Shields for documents"},{"id":"c","label":"Protected material text"},{"id":"d","label":"Prompt Shields for user prompts"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$4b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q65 · pages 68–68","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q066","topicId":"practice","title":"Question 66","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent that answers employee questions by using\nRetrieval-Augmented Generation (RAG).\nAfter deployment, users report the following issues:\n•\nThe retrieved documents are relevant, but the generated answers do not address the user's question.\n•\nResponses generated by the agent are significantly longer than expected, increasing inference costs.\nYou need to determine which diagnostic capability to use for each issue.\nWhich diagnostic capability should you use?\nTo answer, drag the appropriate diagnostic capabilities to the correct issues. Each diagnostic capability may\nbe used once, more than once, or not at all."},{"type":"image","src":"/content/ai-103/figure-218.png","alt":"Original diagram from AI-103, page 69","caption":"Source: AI-103 PDF · page 69"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Investigate irrelevant answers"},{"id":"p2","label":"Investigate excessively long responses"}],"choices":[{"id":"c1","label":"Relevance evaluation"},{"id":"c2","label":"Completion token analytics"},{"id":"c3","label":"Groundedness"},{"id":"c4","label":"Prompt traces"},{"id":"c5","label":"Latency timeline"}],"allowReuse":true,"correctPairs":{"p1":"c1","p2":"c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-219.png","alt":"Original diagram from AI-103, page 69","caption":"Source: AI-103 PDF · page 69"},{"type":"paragraph","text":"$4c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q66 · pages 68–69","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q067","topicId":"practice","title":"Question 67","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project named Project1 that contains the following: An OpenAPI tool that\ncalls an external API\nA project connection named Connection1 that stores the API key of the external API\nWhen an agent calls the OpenAPI tool, the API returns a 401 unauthorized error, and traces show that the API\nkey header is NOT being sent.\nYou need to ensure that the OpenAPI tool automatically includes the API key from Connection1 on all\nrequests.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Enable identity passthrough so that the tool uses the Microsoft Entra token of the caller."},{"id":"b","label":"Add the API key header manually to the OpenAPI specification."},{"id":"c","label":"Configure the tool to use the default connection of Project1."},{"id":"d","label":"Connect the tool to Connection1."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$4d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q67 · pages 70–70","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q068","topicId":"practice","title":"Question 68","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent.\nAfter deploying a new prompt template, administrators observe that Azure OpenAI costs have increased\nsignificantly, even though the number of user requests has remained constant.\nYou need to determine whether the prompt or generated responses are consuming more tokens than\nexpected.\nWhich observability signal should you review?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Groundedness evaluation metrics"},{"id":"b","label":"Retrieval evaluation metrics"},{"id":"c","label":"Token usage analytics"},{"id":"d","label":"Agent execution timeline"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$4e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q68 · pages 71–71","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q069","topicId":"practice","title":"Question 69","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent. The agent uses Azure AI\nSearch as a knowledge source to answer questions by using Retrieval-Augmented Generation (RAG).\nAfter a recent deployment, users report the following issues:\n•\nThe agent occasionally generates responses that are not supported by the retrieved documents.\n•\nSupport engineers want the agent to return a fallback response instead of generating an answer\nwhen insufficient grounding evidence is available.\nYou need to identify the evaluation metric and the recommended configuration to address the issues."},{"type":"image","src":"/content/ai-103/figure-226.png","alt":"Original diagram from AI-103, page 72","caption":"Source: AI-103 PDF · page 72"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Evaluation","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Configuration","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Coherence"},{"id":"p1-c2","label":"Fluency"},{"id":"p1-c3","label":"Groundedness"},{"id":"p1-c4","label":"Similarity"},{"id":"p2-c1","label":"Increase temperature"},{"id":"p2-c2","label":"Reject responses below the groundedness threshold"},{"id":"p2-c3","label":"Increase maximum tokens"},{"id":"p2-c4","label":"Fine-tune with the documents"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-227.png","alt":"Original diagram from AI-103, page 72","caption":"Source: AI-103 PDF · page 72"},{"type":"paragraph","text":"$4f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q69 · pages 72–73","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q070","topicId":"practice","title":"Question 70","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nYour organization needs to detect suspicious sign-in activity, investigate security incidents, and correlate\nalerts generated from Microsoft Foundry, Microsoft Defender, and Microsoft Entra ID.\nThe solution must provide a centralized security operations platform.\nWhich two components should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Microsoft Sentinel"},{"id":"b","label":"Log Analytics workspace"},{"id":"c","label":"Azure Monitor Agent"},{"id":"d","label":"Application Insights"},{"id":"e","label":"OpenTelemetry"}],"correctOptionIds":["a","b"]},"explanation":[{"type":"paragraph","text":"$50"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q70 · pages 73–74","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q071","topicId":"practice","title":"Question 71","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a model deployment.\nYou have an application that calls the deployment by using the Azure OpenAI v1 API and\nDefaultAzureCredential. The developers at your company receive HTTP 403 errors when they send inference\nrequests, even after running az login.\nYou need to ensure that the developers can perform model inference. The solution must follow the principle\nof least privilege.\nWhich role-based access control (RBAC) role should you assign to the developers?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Cognitive Services User"},{"id":"b","label":"Cognitive Services OpenAI User"},{"id":"c","label":"Contributor"},{"id":"d","label":"Cognitive Services Data Reader"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$51"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q71 · pages 74–75","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q072","topicId":"practice","title":"Question 72","prompt":[{"type":"paragraph","text":"You have an app named App1 that uses a Microsoft Foundry multimodal model deployment.\nApp1 runs optical character recognition (OCR) on uploaded images and appends the OCR output to the\nprompt as additional context.\nSome uploaded images contain embedded text.\nYou need to prevent potentially malicious instructions from being processed by the model.\nWhat should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"image moderation"},{"id":"b","label":"prompt shields for documents"},{"id":"c","label":"protected material text"},{"id":"d","label":"prompt shields for user prompts"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$52"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q72 · pages 75–76","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q073","topicId":"practice","title":"Question 73","prompt":[{"type":"paragraph","text":"You need to recommend a solution for a legal research agent by using the Microsoft Foundry Agent\nService.\nThe solution must meet the following requirements:\n•\nRetain attorney preferences across multiple conversations.\n•\nEnable the agent to retrieve reference material from documents uploaded during a conversation.\nWhich Foundry capability should you recommend for each requirement?"},{"type":"image","src":"/content/ai-103/figure-241.png","alt":"Original diagram from AI-103, page 76","caption":"Source: AI-103 PDF · page 76"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Retain attorney preferences","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Use uploaded legal documents","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Persistent agent memory"},{"id":"p1-c2","label":"Conversation history"},{"id":"p1-c3","label":"Orchestration-managed session context"},{"id":"p1-c4","label":"Prompt caching"},{"id":"p2-c1","label":"File search"},{"id":"p2-c2","label":"Code interpreter"},{"id":"p2-c3","label":"Computer use"},{"id":"p2-c4","label":"Translator"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-242.png","alt":"Original diagram from AI-103, page 76","caption":"Source: AI-103 PDF · page 76"},{"type":"paragraph","text":"$53"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q73 · pages 76–77","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q074","topicId":"practice","title":"Question 74","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project named Project1.\nProject1 contains an application that processes scanned engineering drawings.\nYou need to configure Azure Document Intelligence in Foundry Tools to extract the document content while\npreserving tables, headings, paragraphs, and reading order. The extracted content will be passed directly to a\nlarge language model for summarization.\nThe solution must minimize custom post-processing.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Configure output=figures when analyzing the document."},{"id":"b","label":"Set output_content_format=ContentFormat.MARKDOWN."},{"id":"c","label":"Configure string_index_type=UnicodeCodePoint."},{"id":"d","label":"Increase the OCR resolution before processing."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$54"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q74 · pages 77–78","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q075","topicId":"practice","title":"Question 75","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an Azure AI Search resource used to ground\nmultiple agents.\nDevelopers at your company use Microsoft Entra ID authentication to query the search index from a custom\napplication. They receive HTTP 403 (Forbidden) errors when executing search queries.\nYou need to grant the minimum permissions required for developers to query the search index.\nWhich role-based access control (RBAC) role should you assign?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Search Service Contributor"},{"id":"b","label":"Search Index Data Reader"},{"id":"c","label":"Contributor"},{"id":"d","label":"Reader"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$55"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q75 · pages 78–79","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q076","topicId":"practice","title":"Question 76","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent used by an insurance company.\nYou need to enhance the agent by using built-in tools. The solution must meet the following requirements:\n•\nAllow the agent to analyze claim spreadsheets uploaded during conversations and generate charts.\n•\nAllow the agent to interact with a legacy claims management website that does not expose APIs.\n•\nAllow the agent to answer questions by using policy documents uploaded directly to the current\nconversation.\nWhat should you use for each requirement?\nTo answer, drag the appropriate tools to the correct requirements. Each tool may be used once, more than\nonce, or not at all."},{"type":"image","src":"/content/ai-103/figure-249.png","alt":"Original diagram from AI-103, page 79","caption":"Source: AI-103 PDF · page 79"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Analyze spreadsheets and generate charts"},{"id":"p2","label":"Interact with a legacy website"},{"id":"p3","label":"Search policy documents"}],"choices":[{"id":"c1","label":"Code interpreter"},{"id":"c2","label":"Computer use"},{"id":"c3","label":"File search"},{"id":"c4","label":"Grounding with Bing Search"},{"id":"c5","label":"Microsoft Fabric"}],"allowReuse":true,"correctPairs":{"p1":"c1","p2":"c2","p3":"c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-250.png","alt":"Original diagram from AI-103, page 79","caption":"Source: AI-103 PDF · page 79"},{"type":"paragraph","text":"$56"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q76 · pages 79–80","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q077","topicId":"practice","title":"Question 77","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent has a Model Context Protocol\n(MCP) tool that queries a knowledge base stored in Azure AI Search.\nSome agent runs return answers from the base model without invoking the knowledge base, which results in\nresponses without grounded citations.\nYou are provided with the following code snippet that runs the agent.\nrun = project_client.agents.runs.create_and_process(\nthread_id=thread.id,\nagent_id=agent.id\n)\nYou need to add the correct tool _choice parameter to the code to deterministically force the agent to invoke\nthe MCP tool on each run.\nWhat should you add?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"tool_choice= “required”"},{"id":"b","label":"tool_choice= “auto”"},{"id":"c","label":"tool_choice= “type”:“knowledge_base”"},{"id":"d","label":"tool_choice = “type”:“mcp”"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$57"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q77 · pages 80–81","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q078","topicId":"practice","title":"Question 78","prompt":[{"type":"paragraph","text":"A Microsoft Foundry agent invokes three custom tools.\nAdministrators report that users occasionally experience response delays.\nThey need to determine which tool contributes the most to the total response time.\nWhich diagnostic capability should they review?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Token usage analytics"},{"id":"b","label":"Tool execution traces"},{"id":"c","label":"Groundedness evaluation"},{"id":"d","label":"Conversation history"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$58"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q78 · pages 81–82","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q079","topicId":"practice","title":"Question 79","prompt":[{"type":"paragraph","text":"You need to recommend a solution for a customer service agent by using the Microsoft Foundry Agent\nService.\nThe agent must meet the following requirements:\n•\nExecute Python code to analyze spreadsheets uploaded by users during conversations.\n•\nAccess current weather conditions from public websites without requiring users to upload\ndocuments.\nWhich Foundry capability should you recommend for each requirement?"},{"type":"image","src":"/content/ai-103/figure-264.png","alt":"Original diagram from AI-103, page 82","caption":"Source: AI-103 PDF · page 82"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Analyze spreadsheets","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Get current weather","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Code interpreter"},{"id":"p1-c2","label":"File search"},{"id":"p1-c3","label":"Computer use"},{"id":"p1-c4","label":"Azure AI Search"},{"id":"p2-c1","label":"Grounding with Bing Search"},{"id":"p2-c2","label":"File search"},{"id":"p2-c3","label":"Computer use"},{"id":"p2-c4","label":"Microsoft Fabric"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-265.png","alt":"Original diagram from AI-103, page 82","caption":"Source: AI-103 PDF · page 82"},{"type":"paragraph","text":"$59"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q79 · pages 82–83","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q080","topicId":"practice","title":"Question 80","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent used by an internal HR application.\nFollowing a prompt update, administrators notice that users are reporting more incomplete and unsupported\nanswers. The application continues to process requests successfully, and response times remain unchanged.\nYou need to determine whether the quality of the generated responses has degraded.\nWhich observability capability should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Token usage"},{"id":"b","label":"Latency"},{"id":"c","label":"Evaluation metrics"},{"id":"d","label":"Run success rate"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$5a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q80 · pages 83–84","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q081","topicId":"practice","title":"Question 81","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that serves a high-volume chat app. Most requests are simple\nFAQs, but some require advanced reasoning.\nYou need to reduce costs and latency for common queries, without degrading the quality of the responses to\ncomplex questions.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Route all the requests to a smaller model."},{"id":"b","label":"Use a model cascade that routes the requests to different models."},{"id":"c","label":"Increase the value of the max_tokens parameter for all the requests."},{"id":"d","label":"Route all the requests to the most capable model."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$5b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q81 · pages 84–85","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q082","topicId":"practice","title":"Question 82","prompt":[{"type":"paragraph","text":"A financial reporting application generates JSON that is consumed by downstream automation.\nOccasionally, responses contain unexpected fields that cause processing failures.\nWhich approach should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Lower the model temperature."},{"id":"b","label":"Use structured outputs with a JSON schema."},{"id":"c","label":"Increase the maximum completion tokens."},{"id":"d","label":"Fine-tune the model."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$5c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q82 · pages 85–85","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q083","topicId":"practice","title":"Question 83","prompt":[{"type":"paragraph","text":"You need to recommend a solution for a procurement agent by using the Microsoft Foundry Agent\nService.\nThe solution must meet the following requirements:\n•\nAnswer questions by using supplier contracts uploaded by users during conversations.\n•\nGenerate charts that summarize purchasing trends from uploaded Excel workbooks.\nWhich Foundry capability should you recommend for each requirement?"},{"type":"image","src":"/content/ai-103/figure-274.png","alt":"Original diagram from AI-103, page 86","caption":"Source: AI-103 PDF · page 86"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Analyze contracts","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Generate charts from Excel","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"File search"},{"id":"p1-c2","label":"Code interpreter"},{"id":"p1-c3","label":"Grounding with Bing Search"},{"id":"p1-c4","label":"Computer use"},{"id":"p2-c1","label":"Code interpreter"},{"id":"p2-c2","label":"File search"},{"id":"p2-c3","label":"Azure AI Search"},{"id":"p2-c4","label":"Microsoft Fabric"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-275.png","alt":"Original diagram from AI-103, page 86","caption":"Source: AI-103 PDF · page 86"},{"type":"paragraph","text":"$5d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q83 · pages 86–87","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q084","topicId":"practice","title":"Question 84","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nYou need to process mixed-format documents that contain scanned text, tables, and multicolumn layouts.\nThe extracted content must preserve the document structure and be converted into the Markdown format for\ndownstream reasoning.\nWhat should you configure first?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"an Azure Language in Foundry Tools text analysis model deployment"},{"id":"b","label":"a generative chat completion request"},{"id":"c","label":"an Azure OpenAI Responses API call that uses a multimodal model"},{"id":"d","label":"an Azure Content Understanding in Foundry Tools analyzer"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$5e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q84 · pages 87–88","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q085","topicId":"practice","title":"Question 85","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project.\nYou plan to build a customer support solution that contains an agent. The solution must meet the following\nrequirements:\nProvide accurate, context-aware responses grounded in internal product documentation stored in Azure AI\nSearch. Require deep, multi-step reasoning across long contexts.\nGenerate detailed natural language responses.\nWhich type of model should you use to power the agent?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a multimodal model"},{"id":"b","label":"a small language model (SLM)"},{"id":"c","label":"a key phrase extraction model"},{"id":"d","label":"a large language model (LLM)"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$5f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q85 · pages 88–89","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q086","topicId":"practice","title":"Question 86","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a legal research agent.\nThe solution must meet the following requirements:\n•\nResearch recently published court decisions available on public websites.\n•\nSearch contracts that attorneys upload during a conversation.\n•\nLog in to a third-party compliance portal and download supporting evidence for the current case.\nWhat should you use for each requirement?\nTo answer, drag the appropriate tools to the correct requirements. Each tool may be used once, more than\nonce, or not at all."},{"type":"image","src":"/content/ai-103/figure-290.png","alt":"Original diagram from AI-103, page 89","caption":"Source: AI-103 PDF · page 89"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Find recent court decisions"},{"id":"p2","label":"Search uploaded contracts"},{"id":"p3","label":"Download from a portal"}],"choices":[{"id":"c1","label":"Code interpreter"},{"id":"c2","label":"Computer use"},{"id":"c3","label":"File search"},{"id":"c4","label":"Grounding with Bing Search"},{"id":"c5","label":"Microsoft Fabric"}],"allowReuse":true,"correctPairs":{"p1":"c4","p2":"c3","p3":"c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-291.png","alt":"Original diagram from AI-103, page 89","caption":"Source: AI-103 PDF · page 89"},{"type":"paragraph","text":"$60"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q86 · pages 89–90","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q087","topicId":"practice","title":"Question 87","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe knowledge source for the agent is a set of scanned PDF troubleshooting guides stored in Azure Blob\nStorage. The guide pages contain two-column layouts and tables.\nYou use Azure Content Understanding in Foundry Tools to process the PDFs.\nYou plan to ingest the processed content into an index for Retrieval Augmented Generation (RAG) and store\nextracted fields for downstream automation.\nStakeholders must be able to verify where each extracted field value came from in the original PDF and route\nlow-reliability extractions for manual review.\nYou need to ensure that the Content Understanding document analyzer output includes a per-field confidence\nscore and source grounding to locations within the source document.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Set enableSegment to true."},{"id":"b","label":"Provide labeled samples."},{"id":"c","label":"Enable estimateFieldSourceAndConfidence."},{"id":"d","label":"Configure the analyzer to use generative extraction for all fields."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$61"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q87 · pages 90–91","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q088","topicId":"practice","title":"Question 88","prompt":[{"type":"paragraph","text":"A Microsoft Foundry agent answers questions from an Azure AI Search index.\nAdministrators observe the following:\n•\nAverage prompt size has doubled.\n•\nAzure OpenAI costs have increased significantly.\n•\nResponse quality remains unchanged.\nWhich action should you recommend first?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Replace the model with GPT-4.1."},{"id":"b","label":"Retrieve fewer document chunks before constructing the prompt."},{"id":"c","label":"Increase the chunk overlap during indexing."},{"id":"d","label":"Increase the model context window."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$62"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q88 · pages 91–92","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q089","topicId":"practice","title":"Question 89","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent deployed to multiple environments.\nThe organization has adopted a passwordless authentication strategy.\nYou need to configure the GitHub Actions workflow to meet the following requirements:\n•\nEliminate long-lived credentials.\n•\nAuthenticate securely to Azure resources.\nHow should you configure the workflow?"},{"type":"image","src":"/content/ai-103/figure-298.png","alt":"Original diagram from AI-103, page 92","caption":"Source: AI-103 PDF · page 92"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Authentication","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Credential management","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Azure Login with OpenID Connect (OIDC)"},{"id":"p1-c2","label":"Personal access token"},{"id":"p1-c3","label":"Storage account key"},{"id":"p1-c4","label":"Publish profile"},{"id":"p2-c1","label":"Store credentials in GitHub secrets"},{"id":"p2-c2","label":"Use federated identity credentials"},{"id":"p2-c3","label":"Rotate personal access tokens"},{"id":"p2-c4","label":"Use a shared administrator account"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-299.png","alt":"Original diagram from AI-103, page 92","caption":"Source: AI-103 PDF · page 92"},{"type":"paragraph","text":"$63"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q89 · pages 92–93","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q090","topicId":"practice","title":"Question 90","prompt":[{"type":"paragraph","text":"You have an application that processes scanned PDF invoices. The invoices have varied layouts and\ninclude multipage tables.\nYou have a pipeline that uses optical character recognition (OCR) and extracts totals and invoice numbers.\nThe results are often incorrect because the document structure is ignored.\nYou need to implement a solution that provides OCR, layout analysis, and template-generalizing field\nextraction. The solution must NOT require training a custom model. The solution must minimize\nadministrative effort.\nWhat should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Language in Foundry Tools"},{"id":"b","label":"Azure Content Understanding in Foundry Tools"},{"id":"c","label":"an Azure Machine Learning model"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$64"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q90 · pages 93–94","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q091","topicId":"practice","title":"Question 91","prompt":[{"type":"paragraph","text":"You are creating an agent workflow in a Microsoft Foundry project to support natural voice interactions.\nThe agent must receive continuous audio input, convert the input into text for reasoning, and then return\nspoken responses to a user.\nThe workflow must meet the following requirements:\n• Support turn-taking dynamics, where the agent begins to generate the speech output before the user\nfinishes speaking.\n• Operate with low latency to maintain conversational experience.\nYou need to enable both speech to text and text to speech in a real-time agent interaction.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Use batch transcription to convert the audio input and return text responses from the agent."},{"id":"b","label":"Use real-time speech to text for incoming audio and text to speech for agent responses."},{"id":"c","label":"Use an embeddings model to encode the audio, and then decode the audio into text and speech."},{"id":"d","label":"Use speech translation to convert the audio into another language and return the translated text."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$65"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q91 · pages 94–95","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q092","topicId":"practice","title":"Question 92","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that processes purchase orders stored in Azure Blob Storage.\nEach purchase order has a different layout depending on the supplier.\nThe extracted information will be stored as structured JSON and used by a procurement agent.\nYou need to create a single analyzer that meets the following requirements:\nExtract the purchase order number, supplier name, requested delivery date, and total value from all\n•\nsupported layouts.\nReturn confidence scores for each extracted field.\n•\nMinimize post-processing in the application.\n•\nWhat should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"A custom Azure Content Understanding analyzer in Foundry Tools that defines the required fields as extracted fields."},{"id":"b","label":"The Azure Content Understanding prebuilt-read analyzer."},{"id":"c","label":"The Azure Content Understanding prebuilt-layout analyzer."},{"id":"d","label":"Azure AI Search with vector search enabled."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$66"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q92 · pages 95–96","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q093","topicId":"practice","title":"Question 93","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a deployed chat model.\nYou have a Python service that sends API requests to the model. The service is integrated with an automated\nvalidation system that compares generated outputs against approved response patterns.\nStakeholders report that small wording differences are causing validation mismatches.\nYou need to update the request parameters to improve output stability. The solution must maximize\nreasoning quality.\nHow should you complete the Python code?"},{"type":"image","src":"/content/ai-103/figure-300.png","alt":"Original diagram from AI-103, page 96","caption":"Source: AI-103 PDF · page 96"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"temperature","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"output_config.effort","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"0"},{"id":"p1-c2","label":"1"},{"id":"p1-c3","label":"2"},{"id":"p2-c1","label":"high"},{"id":"p2-c2","label":"low"},{"id":"p2-c3","label":"medium"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-304.png","alt":"Original diagram from AI-103, page 97","caption":"Source: AI-103 PDF · page 97"},{"type":"paragraph","text":"$67"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q93 · pages 96–97","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q094","topicId":"practice","title":"Question 94","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses Azure AI Search as the\nretriever.\nYou plan to ingest PDF into an Azure AI Search index to ensure that the agent can ground responses in texts\nin both documents and embedded images.\nUsers require citations that link to the source files.\nYou need to ensure that during indexing, the images are extracted into a structure that can be used as input\nfor the built-in optical character recognition (OCR) skill.\nWhich indexing approach should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"an indexer to extract image data into a normalized_images collection"},{"id":"b","label":"a Shaper skill to restructure the OCR input"},{"id":"c","label":"a skillset to run the OCR skill directly against the content field of the index"},{"id":"d","label":"the outputFieldMappings parameter to write image data to a searchable field"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$68"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q94 · pages 98–98","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q095","topicId":"practice","title":"Question 95","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that generates real estate marketing images from text prompts.\nAfter publishing several images, you discover that one image contains a vehicle parked in the driveway. The\nproperty owner requests that only the vehicle be removed while preserving the house, landscaping, lighting,\nand shadows.\nYou need to update the image.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Apply a mask-based inpainting edit to the area containing the vehicle."},{"id":"b","label":"Regenerate the image by using a lower temperature value."},{"id":"c","label":"Modify the original prompt to specify an empty driveway and generate a new image."},{"id":"d","label":"Create an image variation from the original image."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$69"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q95 · pages 99–99","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q096","topicId":"practice","title":"Question 96","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent.\nThe agent invokes several tools to retrieve order information, customer profiles, and shipping status before\ngenerating a response.\nUsers report that response times have increased significantly after a recent deployment.\nYou need to identify which stage of the agent execution is contributing most to the increased response time.\nWhich observability signal should you review?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Groundedness evaluation metrics"},{"id":"b","label":"Latency breakdown traces"},{"id":"c","label":"Content Safety metrics"},{"id":"d","label":"Relevance evaluation metrics"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$6a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q96 · pages 100–100","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q097","topicId":"practice","title":"Question 97","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nUsers report that some responses omit required regulatory clauses, even when the clauses are present in\nthe retrieved content.\nYou need to improve response completeness.\nSolution: You increase the value of the max_tokens parameter.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["a"]},"explanation":[],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q97 · pages 101–101","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q098","topicId":"practice","title":"Question 98","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nUsers report that some responses omit required regulatory clauses, even when the clauses are present in\nthe retrieved content.\nYou need to improve response completeness.\nSolution: You add a reflection pass that regenerates the response if the required clauses are missing.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["a"]},"explanation":[],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q98 · pages 101–101","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q099","topicId":"practice","title":"Question 99","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nUsers report that some responses omit required regulatory clauses, even when the clauses are present in\nthe retrieved content.\nYou need to improve response completeness.\nSolution: You increase the value of the temperature parameter.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["b"]},"explanation":[],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q99 · pages 102–102","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q100","topicId":"practice","title":"Question 100","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nUsers report that some responses omit required regulatory clauses, even when the clauses are present in\nthe retrieved content.\nYou need to improve response completeness.\nSolution: You run an evaluation flow that scores responses for completeness and blocks responses that fall\nbelow a defined threshold.\nDoes this meet the goal?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Yes"},{"id":"b","label":"No"}],"correctOptionIds":["b"]},"explanation":[],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q100 · pages 102–103","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q101","topicId":"practice","title":"Question 101","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a Retrieval Augmented Generation (RAG) chat\nsolution used by customer support agents.\nYou are adding an automated pre-production evaluation step to a CI/CD pipeline named Pipeline1. The\nevaluation will run against a labeled test dataset that contains support questions and the expected grounding\ncontext.\nYou need to ensure that Pipeline1 fails if unsupported content or a retrieval mismatch exceeds a defined\nthreshold:\nresponses include claims not supported by the retrieved source content\n•\nretrieved source content does not align with the labeled expected context\n•\nWhich two built-in evaluators should you use in Pipeline1?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Retrieval"},{"id":"b","label":"Fluency"},{"id":"c","label":"Coherence"},{"id":"d","label":"Groundedness"},{"id":"e","label":"Response Completeness"}],"correctOptionIds":["a","d"]},"explanation":[{"type":"paragraph","text":"$6b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q101 · pages 103–103","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q102","topicId":"practice","title":"Question 102","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a support-ticket triage agent built by using the\nFoundry Agent Service.\nThe agent uses tool to classify the ticket type and sot the ticket priority.\nSometimes, the same support case continues across multiple sessions over several days.\nYou need to persist state by using a durable ID to ensure that the agent can automatically reuse the full\ninteraction history. The solution must preserve previous user messages, tool calls and tool outputs across\nturns and sessions.\nWhich runtime component should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"output item"},{"id":"b","label":"agent"},{"id":"c","label":"conversation"},{"id":"d","label":"response"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. conversation\nA conversation is the runtime component that maintains state across multiple turns and sessions using a\ndurable identifier. It preserves the full interaction history, including user messages, tool calls, and tool\noutputs. This allows the agent to resume context seamlessly across sessions, which is required when\nsupport cases span multiple days.\nIncorrect Answers:\nA. output item\nAn output item represents a single response or piece of output, not a persistent state container.\nB. agent\nAn agent defines behavior and orchestration logic but does not persist interaction history across sessions.\nD. response\nA response is a single execution result and does not store or manage conversation history."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q102 · pages 104–104","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q103","topicId":"practice","title":"Question 103","prompt":[{"type":"paragraph","text":"You have a Microsoft Founcy project that contains a Retrieval Augmented Generation (RAG) solution.\nYou need to run a pre-production evaluation by using labeled CSV dataset that contains the query, context,\nresponse and ground truth.\nThe evaluation must measure the following:\nWhether responses address the user query\n•\nWhether responses are supported by the provided context\n•\nWhether responses contain sensitive or proprietary information\n•\nWhich AI quality evaluation metrics should you use?"},{"type":"image","src":"/content/ai-103/figure-321.png","alt":"Original diagram from AI-103, page 105","caption":"Source: AI-103 PDF · page 105"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Evaluate context and query","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Detect sensitive or proprietary content","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Coherence and Fluency"},{"id":"p1-c2","label":"GPT similarity and F1"},{"id":"p1-c3","label":"Groundedness and Relevance"},{"id":"p1-c4","label":"Groundedness and ROUGE"},{"id":"p2-c1","label":"Hateful and unfair content"},{"id":"p2-c2","label":"Indirect attacks"},{"id":"p2-c3","label":"Protected material"},{"id":"p2-c4","label":"Violent content"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-322.png","alt":"Original diagram from AI-103, page 105","caption":"Source: AI-103 PDF · page 105"},{"type":"paragraph","text":"$6c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q103 · pages 104–106","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q104","topicId":"practice","title":"Question 104","prompt":[{"type":"paragraph","text":"You plan to configure an evaluation in Microsoft Foundry for a Retrieval Augmented Generation (RAG)\nchat app. You need to provide scores for groundedness, relevance, and harmful content categories.\nWhich two evaluation categories can you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"risk and safety metrics"},{"id":"b","label":"fluency evaluator"},{"id":"c","label":"similarity evaluators"},{"id":"d","label":"AI quality (NLP) metrics"},{"id":"e","label":"AI quality (AI assisted) metrics"}],"correctOptionIds":["a","e"]},"explanation":[{"type":"paragraph","text":"$6d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q104 · pages 106–107","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q105","topicId":"practice","title":"Question 105","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that uses Azure Content Understanding in Foundry Tools to\nanalyze marketing videos.\nVideo segmentation is enabled.\nYou need to configure an analyzer to output a generated JSON field that describes the color scheme of each\nvideo segment.\nHow should you configure the analyzer?"},{"type":"image","src":"/content/ai-103/figure-332.png","alt":"Original diagram from AI-103, page 107","caption":"Source: AI-103 PDF · page 107"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Field value type"},{"id":"p2","label":"Method"}],"choices":[{"id":"c1","label":"classify"},{"id":"c2","label":"generate"},{"id":"c3","label":"group"},{"id":"c4","label":"string"},{"id":"c5","label":"table"}],"allowReuse":true,"correctPairs":{"p1":"c4","p2":"c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-333.png","alt":"Original diagram from AI-103, page 107","caption":"Source: AI-103 PDF · page 107"},{"type":"paragraph","text":"Correct Answer:\nField value type → string\nA string field type is used when the output is descriptive text. In this scenario, the requirement is to describe\nthe color scheme of each video segment. This is not structured multi-field JSON with defined subfields, but\nrather a natural language or textual description, which maps to a string.\nField method → generate\nThe generate method is used when the analyzer must create new content using AI rather than extract it\ndirectly from the source. Since the color scheme must be inferred from visual content and described, it\nrequires generative capability.\nIncorrect Answers:\ngroup\nGroup is used for structured JSON with predefined subfields. The question asks for a generated description,\nnot a structured schema with multiple named fields.\nclassify\nClassify is used when assigning predefined labels, not generating descriptive output.\ntable\nTable is used for structured tabular extraction, not descriptive generation."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q105 · pages 107–108","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q106","topicId":"practice","title":"Question 106","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses two tools to perform the\nfollowing actions:\nUse Azure AI Search to retrieve answers from a private product documentation index.\n•\nUse the web search tool to retrieve public information on the internet.\n•\nYou need to ensure that for a specific run, the agent deterministically retrieves information only from the\ninternet.\nTo what should you set tool_choice?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"“type”: “bing_grouding”"},{"id":"b","label":"“type”: “azure_ai-search”"},{"id":"c","label":"“auto”"},{"id":"d","label":"“required”"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. “type”: “bing_grounding”\nThis is correct because setting tool_choice explicitly to bing_grounding forces the agent to deterministically\nuse only the web search tool for that run. It ensures that responses are generated strictly from internet\nsources and prevents the agent from calling Azure AI Search or any other tool.\nIncorrect Answers:\nB. “type”: “azure_ai-search”\nThis forces the agent to use the private index, which is the opposite of the requirement.\nC. “auto”\nAuto allows the agent to choose tools dynamically, so it does not guarantee internet-only retrieval.\nD. “required”\nRequired forces tool usage but does not specify which tool, so it does not ensure deterministic selection of\nweb search."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q106 · pages 108–109","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q107","topicId":"practice","title":"Question 107","prompt":[{"type":"paragraph","text":"$6e"},{"type":"image","src":"/content/ai-103/figure-338.png","alt":"Original diagram from AI-103, page 109","caption":"Source: AI-103 PDF · page 109"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Changing the content filtering configuration to low severity will resolve the fine-tuning job issues."},{"id":"s2","label":"The difference between the 12% and 4% content harm defect rate is consistent with the different severity thresholds used in Run1 and Run2."},{"id":"s3","label":"The identical 6% protected material evaluation values across Run1 and Run2 indicate that this metric is unaffected by the change in the severity threshold."}],"correctValues":{"s1":false,"s2":true,"s3":true}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-349.png","alt":"Original diagram from AI-103, page 110","caption":"Source: AI-103 PDF · page 110"},{"type":"paragraph","text":"Statement 1 --> No\nThis is incorrect because lowering the severity threshold only reduces how strictly harmful content is\nflagged, but it does not remove or fix the harmful content present in the dataset. The fine-tuning job fails due\nto actual content violations detected during RAI checks, so the dataset itself must be cleaned rather than just\nchanging the filtering level.\nStatement 2 --> Yes\nThis is correct because a medium severity threshold flags more content as harmful compared to a high\nseverity threshold, resulting in a higher defect rate (12% vs 4%). This difference directly reflects how varying\nseverity levels impact content harm detection sensitivity.\nStatement 3 --> Yes\nThis is correct because protected material evaluation is independent of harmful content severity thresholds.\nThe identical 6% values across both runs confirm that changing severity levels affects only harmful content\nmetrics and not protected material detection."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q107 · pages 109–110","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q108","topicId":"practice","title":"Question 108","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a customer support agent built on a deployed chat\nmodel. The agent responses are validated by using an automated testing system that compares generated\nanswers to stored expected outputs. Identical prompts must return consistent response to prevent\nautomated test failures.\nYou need to reduce response variability, without modifying the prompt or reducing factual accuracy.\nWhat should you do for the model?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Increase the max_tokens parameter."},{"id":"b","label":"Remove stop sequences from the requests."},{"id":"c","label":"Decrease the temperature parameter."},{"id":"d","label":"Increase the temperature parameter."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. Decrease the temperature parameter\nThis is correct because temperature controls randomness in model output. Lowering the temperature makes\nresponses more deterministic and consistent for identical prompts, which is essential for automated testing\nscenarios without impacting factual accuracy.\nIncorrect Answers:\nA. Increase the max_tokens parameter\nThis only affects response length, not variability or consistency.\nB. Remove stop sequences from the requests\nStop sequences control where responses end, not how deterministic they are.\nD. Increase the temperature parameter\nHigher temperature increases randomness, leading to more variability and inconsistent outputs."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q108 · pages 110–111","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q109","topicId":"practice","title":"Question 109","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains two agents named PolicyWriter and RskReviewer.\nPolicyWriter generates daft updates for customer polices, and RiskReviewer reviews the drafts.\nIn the visual builder, you need to create a workflow that meets the following requirements:\nFinalizes low-risk updates without manual intervention\n•\nEnsures predictable execution across the agents\n•\nRequires user approval for highs updates\n•\nWhat should you configure?"},{"type":"image","src":"/content/ai-103/figure-354.png","alt":"Original diagram from AI-103, page 112","caption":"Source: AI-103 PDF · page 112"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Orchestration pattern","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Approval checkpoints","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"The sequential template that passes outputs node by-node"},{"id":"p1-c2","label":"The group chat template to dynamically route control between the agents"},{"id":"p1-c3","label":"The human-in-the-loop template that pauses execution of the workflow for input"},{"id":"p2-c1","label":"Add a Basic chat node"},{"id":"p2-c2","label":"Add a Condition statement"},{"id":"p2-c3","label":"Add an Ask a question node"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-347.png","alt":"Original diagram from AI-103, page 112","caption":"Source: AI-103 PDF · page 112"},{"type":"paragraph","text":"$6f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q109 · pages 112–113","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q110","topicId":"practice","title":"Question 110","prompt":[{"type":"paragraph","text":"You are developing prompts for a Micosoft Foundry project that classifies incoming support tickets by\ncategory. You need to improve accuracy by showing the model how correct classifications look, without\nretaining the model or storing knowledge permanently.\nWhich prompt engineering approach should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Retrieval Augmented Generation (RAG)"},{"id":"b","label":"zero-shot learning"},{"id":"c","label":"chain of thought"},{"id":"d","label":"few-shot learning"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nD. few-shot learning\nThis is correct because few-shot learning improves classification accuracy by providing a few labeled\nexamples directly in the prompt. This shows the model what correct outputs look like without retraining or\npermanently storing knowledge, aligning perfectly with the requirement.\nIncorrect Answers:\nA. Retrieval Augmented Generation (RAG)\nRAG retrieves external data but does not demonstrate example classifications within the prompt.\nB. zero-shot learning\nZero-shot provides no examples, so it does not help guide the model toward more accurate classifications.\nC. chain of thought\nChain-of-thought improves reasoning steps, not classification accuracy through examples."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q110 · pages 113–113","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q111","topicId":"practice","title":"Question 111","prompt":[{"type":"paragraph","text":"You have a web app named App1 that processes user prompts by integrating with a Microsoft Foundry\nproject named Project1.\nApp1 performs the following actions:\nSends prompts directly to a model by using the Azure OpenAI Responses API\n•\nInvokes the Azure AI Content Safety tool by using a Foundry connection within the same request\n•\nYou need to configure end-to-end visibility into each step of the request workflow.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Enable logging by using the client SDK for Content Safety."},{"id":"b","label":"Enable logging by using Foundry Local."},{"id":"c","label":"Enable application tracing in Project1."},{"id":"d","label":"Route requests through the Azure OpenAI endpoint."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. Enable application tracing in Project1\nThis is correct because application tracing provides end-to-end observability across the entire request flow,\nincluding model calls and tool invocations like Content Safety. It captures each step in the workflow, enabling\nfull visibility into how the request is processed within Foundry.\nIncorrect Answers:\nA. Enable logging by using the client SDK for Content Safety\nThis only provides visibility into Content Safety calls, not the complete workflow.\nB. Enable logging by using Foundry Local\nFoundry Local is used for local development and debugging, not full production tracing.\nD. Route requests through the Azure OpenAI endpoint\nThis does not provide tracing across integrated tools or end-to-end workflow visibility."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q111 · pages 114–114","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q112","topicId":"practice","title":"Question 112","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent named Agent1.\nAgent runs successful, but Foundry Control Plane does NOT display values for error rates, runs, and token\nusage, and the Traces tab is empty.\nYou need to ensure that Found Control Plane displays the appropriate values for Agent1. What should you\ndo?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Update Agent1 to a new version."},{"id":"b","label":"Restart Agent from Foundry Control Plan"},{"id":"c","label":"Assign to a Log Analytics workspace to Agent1."},{"id":"d","label":"Enable Application Insights for Agent1."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nD. Enable Application Insights for Agent1\nThis is correct because metrics such as error rates, runs, token usage, and traces are collected through\nApplication Insights. Enabling it integrates telemetry and observability, allowing the Foundry Control Plane to\ndisplay detailed runtime metrics and traces for the agent.\nIncorrect Answers:\nA. Update Agent1 to a new version\nUpdating the version does not enable telemetry or monitoring capabilities.\nB. Restart Agent from Foundry Control Plane\nRestarting does not address missing telemetry configuration.\nC. Assign to a Log Analytics workspace to Agent1\nLog Analytics alone does not provide the required application-level tracing and metrics integration for\nFoundry agents."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q112 · pages 114–115","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q113","topicId":"practice","title":"Question 113","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent uses a stored access key to retrieve secrets from an Azure key vault, which violates a keyless-\ncredentials requirement.\nYou need to ensure that the agent can retrieve the secrets. The solution must follow the principle of least\nprivilege. What should you configure?"},{"type":"image","src":"/content/ai-103/figure-362.png","alt":"Original diagram from AI-103, page 115","caption":"Source: AI-103 PDF · page 115"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Managed identity scope","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Key Vault authorization","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Enable a system-assigned managed identity at the Foundry level"},{"id":"p1-c2","label":"Enable a system-assigned managed identity at the project level"},{"id":"p1-c3","label":"Create a service principal and store its client secret"},{"id":"p2-c1","label":"Add an API key to application settings"},{"id":"p2-c2","label":"Add a Key Vault access policy for the secrets"},{"id":"p2-c3","label":"Assign the Key Vault Secrets User role to the managed identity"}],"allowReuse":true,"correctPairs":{"p1":"p1-c2","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-357.png","alt":"Original diagram from AI-103, page 116","caption":"Source: AI-103 PDF · page 116"},{"type":"paragraph","text":"$70"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q113 · pages 115–116","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q114","topicId":"practice","title":"Question 114","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent uses Azure Content Understanding in Foundry Too to process vendor onboarding packets. The\npacks include digital PDFs that contain tables and hyperlinks.\nThe extracted content is indexed for search and provided to a downstream agent in the Markdown format.\nYou need to generate a Markdown output that has a layout and a semantic structure optimized for Retrieval\nAugmented Generation (RAG) workflows.\nWhich built-in analyzer should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"prebuilt-documentFieldSchema"},{"id":"b","label":"prebuilt-documentSearch"},{"id":"c","label":"prebuilt-read"},{"id":"d","label":"prebuilt-layout"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. prebuilt-documentSearch\nThis is correct because prebuilt-documentSearch is optimized for RAG scenarios, producing structured\nMarkdown output with semantic organization suitable for indexing and retrieval. It preserves layout elements\nlike tables and links while formatting content for efficient downstream search and grounding.\nIncorrect Answers:\nA. prebuilt-documentFieldSchema\nUsed for structured field extraction, not for generating RAG-optimized Markdown output.\nC. prebuilt-read\nExtracts raw text without preserving layout or semantic structure needed for RAG.\nD. prebuilt-layout\nCaptures layout elements but does not produce semantically optimized Markdown for retrieval workflows."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q114 · pages 116–117","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q115","topicId":"practice","title":"Question 115","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains a multi-agent solution. The agents use tool calling\nto query internal systems.\nYou need to implement responsible AI auditing to meet the following requirements:\nCapture all the nested operations across the entire agent run.\n•\nRecord tool invocation arguments and retuned results as metadata.\n•\nWhat should you use for each requirement?"},{"type":"image","src":"/content/ai-103/figure-360.png","alt":"Original diagram from AI-103, page 117","caption":"Source: AI-103 PDF · page 117"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Trace nested operations"},{"id":"p2","label":"Capture tool arguments and results"}],"choices":[{"id":"c1","label":"Hierarchical spans"},{"id":"c2","label":"KQL queries"},{"id":"c3","label":"Sampling"},{"id":"c4","label":"Tool call attributes"},{"id":"c5","label":"Trace sampling"}],"allowReuse":true,"correctPairs":{"p1":"c1","p2":"c4"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-363.png","alt":"Original diagram from AI-103, page 118","caption":"Source: AI-103 PDF · page 118"},{"type":"paragraph","text":"Correct Answer:\nCapture all the nested operations across the entire agent run → Hierarchical spans\nThis is correct because hierarchical spans represent the full execution tree of an agent run, capturing parent-\nchild relationships between steps, sub-steps, and tool calls. This ensures complete visibility into nested\noperations for auditing and tracing.\nRecord tool invocation arguments and results → Tool call attributes\nThis is correct because tool call attributes store metadata about each tool invocation, including input\narguments and returned results. This enables detailed auditing of how tools were used and what data was\nprocessed.\nIncorrect Answers:\nA KQL query filter\nUsed for querying logs, not for capturing execution traces.\nSampling / Trace sampling policy\nUsed to limit data collection, not to ensure full capture of operations."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q115 · pages 117–118","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q116","topicId":"practice","title":"Question 116","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent.\nThe agent uses Azure AI Search for Retrieval Augmented Generation (RAG). You plan to ingest and index PDF\nproduct manuals.\nYou need to build a solution that supports semantic similarity matching. The solution must ensure that the\nagent retrieves relevant data when user questions use different wording than the product manuals.\nWhich indexing approach should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"vector search"},{"id":"b","label":"semantic ranking"},{"id":"c","label":"suggesters"},{"id":"d","label":"analyzers"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. vector search\nThis is correct because vector search enables semantic similarity matching by converting text into\nembeddings and retrieving content based on meaning rather than exact keywords. This ensures that user\nqueries with different wording still match relevant content from product manuals.\nIncorrect Answers:\nB. semantic ranking\nThis improves ranking of already retrieved results but does not perform semantic retrieval itself.\nC. suggesters\nUsed for autocomplete and search suggestions, not for semantic matching.\nD. analyzers\nUsed for text processing like tokenization, not for semantic similarity search."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q116 · pages 118–119","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q117","topicId":"practice","title":"Question 117","prompt":[{"type":"paragraph","text":"You develop a test method to verify the results retrieved from a call to the Azure Vision in Foundry\nTools API. The call is used to analyze the existence of company logos in images. The call returns a collection\nof brands named brands.\nYou have the following code segment:"},{"type":"image","src":"/content/ai-103/figure-366.png","alt":"Original diagram from AI-103, page 119","caption":"Source: AI-103 PDF · page 119"},{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."},{"type":"image","src":"/content/ai-103/figure-367.png","alt":"Original diagram from AI-103, page 119","caption":"Source: AI-103 PDF · page 119"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"The code will display the name of each detected brand with a confidence equal to or higher than 75 percent."},{"id":"s2","label":"The code will display coordinates for the top-left corner of the rectangle that contains the brand logo of the displayed brands."},{"id":"s3","label":"The code will display coordinates for the bottom-right corner of the rectangle that contains the brand logo of the displayed brands."}],"correctValues":{"s1":true,"s2":true,"s3":false}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-370.png","alt":"Original diagram from AI-103, page 120","caption":"Source: AI-103 PDF · page 120"},{"type":"paragraph","text":"Statement 1 --> Yes\nThis is correct because the code checks if brand.confidence >= 0.75, which ensures that only brands with\nconfidence equal to or greater than 75% are processed. It then prints brand.name, so the name of each\nqualifying detected brand will be displayed.\nStatement 2 --> Yes\nThis is correct because the code prints {brand.rectangle.x} and {brand.rectangle.y}, which represent the\ncoordinates of the top-left corner of the bounding rectangle around the detected logo.\nStatement 3 --> No\nThis is correct because the code prints width {brand.rectangle.w} and height {brand.rectangle.h}, not the\nbottom-right coordinates. Bottom-right coordinates would require calculating x + w and y + h, which is not\ndone here."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q117 · pages 119–120","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q118","topicId":"practice","title":"Question 118","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry agent that grounds responses from an Azure Search index that contains\nthe following:\nSearchable text fields for product names and product codes\n•\nA vector field that stores embeddings for product descriptions\n•\nYou need to ensure that users can query the index by using the following:\nExact product names or codes\n•\nNatural language descriptions of the products\n•\nWhat should you configure?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"vector search only"},{"id":"b","label":"hybrid search"},{"id":"c","label":"keyword search only"},{"id":"d","label":"semantic search only"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. hybrid search\nThis is correct because hybrid search combines keyword search for exact matches on product names and\ncodes with vector search for semantic similarity on product descriptions. This ensures both precise lookups\nand natural language queries are handled effectively in a single query.\nIncorrect Answers:\nA. vector search only\nThis supports semantic queries but does not handle exact keyword matches efficiently.\nC. keyword search only\nThis works for exact matches but cannot handle natural language or semantic similarity.\nD. semantic search only\nSemantic ranking enhances results but does not combine keyword and vector retrieval like hybrid search."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q118 · pages 120–121","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q119","topicId":"practice","title":"Question 119","prompt":[{"type":"paragraph","text":"You plan to create a Microsoft Foundry project named Project1 that will contain an agent and use an\nAzure key vault named KV1.\nYou need to configure a connection from Project1 to KV1.\nHow should you complete the Bicep code?"},{"type":"image","src":"/content/ai-103/figure-383.png","alt":"Original diagram from AI-103, page 122","caption":"Source: AI-103 PDF · page 122"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"category","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"authType","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"AzureAIService"},{"id":"p1-c2","label":"AzureKeyVault"},{"id":"p1-c3","label":"AzureOpenAI"},{"id":"p2-c1","label":"AccountKey"},{"id":"p2-c2","label":"AccountManagedIdentity"},{"id":"p2-c3","label":"ApiKey"}],"allowReuse":true,"correctPairs":{"p1":"p1-c2","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-386.png","alt":"Original diagram from AI-103, page 123","caption":"Source: AI-103 PDF · page 123"},{"type":"paragraph","text":"Correct Answer:\ncategory → AzureKeyVault\nThis is correct because the connection is being created to an Azure Key Vault resource (KV1). The category\nmust match the target service type so that Foundry correctly identifies and integrates with Key Vault.\nauthType → AccountManagedIdentity\nThis is correct because managed identity enables secure, keyless authentication between the Foundry project\nand Key Vault. It aligns with best practices and avoids storing secrets like API keys while supporting least\nprivilege access.\nIncorrect Answers:\nAzureAIService / AzureOpenAI\nThese categories are for AI services, not Key Vault connections.\nAccountKey / ApiKey\nThese require storing secrets, which violates secure keyless authentication practices."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q119 · pages 121–124","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q120","topicId":"practice","title":"Question 120","prompt":[{"type":"paragraph","text":"You have an Azure AI Search indexer that ingests PDF policy manuals.\nClient applications must display page-level citations that have bounding polygons for both text and images.\nYou need to add a single built-in multimodal content extraction skill to the Azure AI Search skillset.\nThe solution must meet the following requirements:\nProvide text and image location metadata.\n•\nExtract tables that span multiple pages.\n•\nWhat should you add?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Document Extraction"},{"id":"b","label":"Azure Content Understanding in Foundry Tools"},{"id":"c","label":"GenAI Prompt"},{"id":"d","label":"Document Layout"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$71"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q120 · pages 124–125","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q121","topicId":"practice","title":"Question 121","prompt":[{"type":"paragraph","text":"You are building an Azure AI Search indexing pipeline named Pipeline1 that ingests invoices stored in\nAzure Blob Storage. The invoices are stored as scanned images.\nYou need to enable users to search invoice data across the invoice fields. Which built-in skill should you add\nto the skillset of Pipeline1?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Text Split"},{"id":"b","label":"Text Translation"},{"id":"c","label":"optical character recognition (OCR)"},{"id":"d","label":"Image Analysis"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. optical character recognition (OCR)\nThis is correct because the invoices are stored as scanned images, which means they do not contain\nsearchable text. OCR converts the text within images into machine-readable text, enabling Azure AI Search to\nindex invoice fields and make them searchable.\nIncorrect Answers:\nA. Text Split\nUsed to break large text into chunks, but it requires text input and cannot extract text from images.\nB. Text Translation\nTranslates text between languages, but does not extract text from scanned images.\nD. Image Analysis\nDetects objects, captions, or tags in images, but does not extract structured text required for search\nindexing."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q121 · pages 125–125","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q122","topicId":"practice","title":"Question 122","prompt":[{"type":"paragraph","text":"You have an invoice-processing application named App1 that uses Azure Constant Understanding in\nFoundry Tools.\nYou are building a new Content Understanding pipeline named Pipeline1 that must meet the following\nrequirements:\nCompare an invoice to its related purchase order\n•\nValidate the voice against static vendor contact documents\n•\nReturn a single structured output that includes discrepancy findings\n•\nYou need to configure Pipeline1 and expose the pipeline as a single analyzer endpoint. What should you\nconfigure?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a single-file task in standard mode that uses the vendor contract provided as an additional document during analysis."},{"id":"b","label":"a single-file task in standard mode that uses confidence scores enabled for the extracted fields."},{"id":"c","label":"a multiple-file task in pro mode that uses the vendor contract files as reference data"},{"id":"d","label":"a multi-file task in standard mode that uses the invoice and purchase order as input to the analyzer"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$72"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q122 · pages 125–126","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q123","topicId":"practice","title":"Question 123","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project.\nYou need to create a customer support agent that meets the following requirements:\nGrounds responses only in company policy documents stored in curated repositories\n•\nRetains customer preferences across separate chat sessions\n•\nHow should you configure the agent?"},{"type":"image","src":"/content/ai-103/figure-387.png","alt":"Original diagram from AI-103, page 127","caption":"Source: AI-103 PDF · page 127"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Knowledge grounding","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Memory","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Configure retrieval from approved data sources"},{"id":"p1-c2","label":"Upload the policy documents directly to the agent"},{"id":"p1-c3","label":"Embed the policy documents directly into the agent instructions"},{"id":"p2-c1","label":"Enable agent memory that uses persistent storage"},{"id":"p2-c2","label":"Use orchestration-managed session context"},{"id":"p2-c3","label":"Retain user preferences in the state of the client application"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-388.png","alt":"Original diagram from AI-103, page 127","caption":"Source: AI-103 PDF · page 127"},{"type":"paragraph","text":"$73"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q123 · pages 126–128","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q124","topicId":"practice","title":"Question 124","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that generates short promotional product videos.\nAfter several clips are approved, reviewers notice a small watermark in the top-right corner of some videos.\nYou need to remove the watermark without regenerating the videos.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Modify the original prompt to exclude watermarks."},{"id":"b","label":"Crop the video by using the size parameter."},{"id":"c","label":"Increase the guidance scale."},{"id":"d","label":"Apply a mask-based inpainting edit to the affected part of the video."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nD. Apply a mask-based inpainting edit to the affected part of the video\nThis is correct because the requirement is to remove a watermark from already generated videos without\nregenerating them. Mask-based inpainting allows you to selectively edit a specific region (top-right corner)\nand remove or replace the watermark while preserving the rest of the video content.\nIncorrect Answers:\nA. Modify the original prompt to exclude watermarks\nThis would only affect future video generation and does not fix already generated videos.\nB. Crop the video by using the size parameter\nCropping would remove part of the video frame and may affect important content. It is not a precise or\nsuitable solution for watermark removal.\nC. Increase the guidance scale\nGuidance scale influences how closely the model follows the prompt during generation. It has no effect on\nalready generated videos or post-processing edits."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q124 · pages 128–128","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q125","topicId":"practice","title":"Question 125","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent uses threads and file uploads\nand calls an Azure OpenAI model deployment.\nDuring load testing, calls intermittently fall and return an HTTP 429 rate limit exceeded error. Some user\nuploads fail and generate an HTTP 400 file size exceeded error.\nYou need to mitigate the errors and reduce call failures. The solution must remain within the service and\nmodel limits.\nWhat should you do to resolve each error?"},{"type":"image","src":"/content/ai-103/figure-393.png","alt":"Original diagram from AI-103, page 129","caption":"Source: AI-103 PDF · page 129"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"HTTP 429 errors"},{"id":"p2","label":"HTTP 400 errors"}],"choices":[{"id":"c1","label":"Implement exponential backoff with jitter"},{"id":"c2","label":"Split files into smaller files"},{"id":"c3","label":"Increase quotas"},{"id":"c4","label":"Move large files and use search"},{"id":"c5","label":"Add more tools"}],"allowReuse":true,"correctPairs":{"p1":"c1","p2":"c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-394.png","alt":"Original diagram from AI-103, page 129","caption":"Source: AI-103 PDF · page 129"},{"type":"paragraph","text":"$74"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q125 · pages 128–129","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q126","topicId":"practice","title":"Question 126","prompt":[{"type":"paragraph","text":"You have a web app named App1 that sends requests to a multimodal chat model deployment in a\nMicrosoft Foundry project.\nUser messages can contain both text and images.\nCurrently, App1 includes image URL: as plain text inside the message content so the model cannot recognize\nthem as images.\nTraces show that the requests contain a single text message instead of a multimodal content array.\nYou need to send the message as a structured array that includes both the text portion and the image\nreference to ensure that the model can process the image correctly.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Set the user message content array to include items that have type: text and type: image_url."},{"id":"b","label":"Encode the image to base64 and include the encoded data inside the content string of the user message."},{"id":"c","label":"Add the image URL to the request metadata section, so the model can resolve the processing issue automatically."},{"id":"d","label":"Place the image URL inside the System Message and set type to image_url so the model loads the image at initialization."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$75"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q126 · pages 130–130","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q127","topicId":"practice","title":"Question 127","prompt":[{"type":"paragraph","text":"You have a Python application that redacts sensitive information before sending prompt text to a\nlanguage model. The application has the following code:"},{"type":"image","src":"/content/ai-103/figure-399.png","alt":"Original diagram from AI-103, page 131","caption":"Source: AI-103 PDF · page 131"},{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."},{"type":"image","src":"/content/ai-103/figure-410.png","alt":"Original diagram from AI-103, page 132","caption":"Source: AI-103 PDF · page 132"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"For sample_text, audit will include entity records for Contact and SSN."},{"id":"s2","label":"For sample_text, text_for_model will include john.doe@contoso.com and 859-98-0987."},{"id":"s3","label":"For sample_text, text_for_model will contain entity type masks for John Doe and 312-555-1234."}],"correctValues":{"s1":false,"s2":false,"s3":true}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-403.png","alt":"Original marked answer area from AI-103, page 132","caption":"Source: AI-103 PDF · page 132"},{"type":"paragraph","text":"Statement 1 --> No\nThis is correct because the configuration restricts detection to \"piiCategories\": [\"Person\", \"PhoneNumber\"].\nThe terms “Contact” and “SSN” are not included in these categories, so they will not be detected as entities\nand therefore will not appear in the audit output.\nStatement 2 --> No\nThis is correct because text_for_model uses redactedText, which applies masking (entityMask) to detected\nentities. Even if email and SSN are present in the text, they will either be masked (if detected) or excluded (if\nnot part of configured categories). Hence, the original values like john.doe@contoso.com and 859-98-0987\nwill not appear.\nStatement 3 --> Yes\nThis is correct because the configuration includes \"Person\" and \"PhoneNumber\" with entityMask redaction.\nTherefore, “John Doe” and “312-555-1234” will be detected and replaced with masked placeholders in\ntext_for_model."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q127 · pages 131–132","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q128","topicId":"practice","title":"Question 128","prompt":[{"type":"paragraph","text":"You are building a customer support web app named App1 in Microsoft Foundry that uses a GPT\nrealtime model.\nApp1 must support:\nLive, low-latency voice conversations that use Azure OpenAI\n•\nStreaming audio input from users and playback audio responses\n•\nYou need to configure a connection method that supports real-time audio streaming in client application and\ntargets approximately 100 ms latency.\nWhich connection method should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"RTMP"},{"id":"b","label":"WebRTC"},{"id":"c","label":"SIP"},{"id":"d","label":"WebSocket"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. WebRTC\nThis is correct because WebRTC is designed for real-time, low-latency audio and video streaming, typically\nachieving latency around ~100 ms. It supports bi-directional streaming, making it ideal for live voice\nconversations where users send audio input and receive audio responses instantly.\nIncorrect Answers:\nA. RTMP\nThis is primarily used for live video streaming (e.g., broadcasting) and has higher latency. It is not suitable for\ninteractive real-time conversations.\nC. SIP\nSIP is used for telephony signaling but does not handle real-time media streaming efficiently for modern\nweb-based applications like GPT realtime models.\nD. WebSocket\nWebSocket supports real-time communication but is not optimized for low-latency audio streaming like\nWebRTC. It typically results in higher latency compared to WebRTC for media scenarios."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q128 · pages 133–133","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q129","topicId":"practice","title":"Question 129","prompt":[{"type":"paragraph","text":"You have an Azure subscription.\nYou need to create a new resource that will generate fictional stores in response to user prompts. The\nsolution must ensure that the resource uses a customer-managed key to protect data.\nHow should you complete the script?"},{"type":"image","src":"/content/ai-103/figure-408.png","alt":"Original diagram from AI-103, page 134","caption":"Source: AI-103 PDF · page 134"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Resource kind","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"CLI parameter","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"AIServices"},{"id":"p1-c2","label":"LanguageAuthoring"},{"id":"p1-c3","label":"OpenAI"},{"id":"p2-c1","label":"--api-properties"},{"id":"p2-c2","label":"--assign-identity"},{"id":"p2-c3","label":"--encryption"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-409.png","alt":"Original diagram from AI-103, page 134","caption":"Source: AI-103 PDF · page 134"},{"type":"paragraph","text":"Correct Answer:\nkind → OpenAI\nThis is correct because the requirement is to generate responses to user prompts (fictional stores), which\nrequires an Azure OpenAI resource. Therefore, the resource type must be set to OpenAI.\nparameter → --encryption\nThis is correct because customer-managed keys (CMK) are configured using the encryption property. The\nprovided JSON block specifies \"keySource\": \"Microsoft.KeyVault\" and Key Vault details, which are part of\nencryption settings for CMK.\nIncorrect Answers:\nAIServices / LanguageAuthoring\nThese resource kinds are used for other AI capabilities (vision, language authoring) and do not support\nOpenAI prompt-based generation.\n--api-properties / --assign-identity\nThese parameters do not configure customer-managed keys. CMK specifically requires the encryption\nconfiguration."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q129 · pages 133–135","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q130","topicId":"practice","title":"Question 130","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent and uses a GitHub repository. The\nrepository contains a YAM file named File1 that defines the evaluation settings of the agent.\nYou need to create a GitHub Actions workflow that runs the evaluation defined in File1 when a pull request\n(PR) is opened.\nHow should you configure the workflow?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Set project-endpoint to the endpoint of the project."},{"id":"b","label":"Set evaluation-config to the path of the YAML file."},{"id":"c","label":"Set model-deployment-name to the deployed model."},{"id":"d","label":"Set tenant-id to the Microsoft Entra tenant ID"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$76"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q130 · pages 135–136","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q131","topicId":"practice","title":"Question 131","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project.\nYou need to deploy a model from the model catalog to support a search solution for internal policy\ndocuments. The model must generate vector representations of the text in the documents and of user\nqueries.\nWhich type of model should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"an embedding model"},{"id":"b","label":"an image generation model"},{"id":"c","label":"a large language model (LLM)"},{"id":"d","label":"a small language model (SLM)"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. an embedding model\nEmbedding models are specifically designed to convert text into numerical vector representations. These\nvectors capture the semantic meaning of the text, enabling similarity-based search. In a search solution for\ninternal policy documents, both the documents and user queries must be converted into vectors so that\nrelevant matches can be identified using vector similarity. This is exactly the purpose of embedding models\nin Azure AI Foundry and related services.\nIncorrect answers:\nB. an image generation model\nThis type of model is used to generate images from text prompts and is not suitable for text vectorization or\nsearch.\nC. a large language model (LLM)\nLLMs are primarily used for text generation, summarization, and reasoning, not for generating vector\nembeddings for search indexing.\nD. a small language model (SLM)\nSLMs are optimized for lightweight text processing tasks but are not designed specifically for generating\nhigh-quality vector embeddings for semantic search."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q131 · pages 136–136","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q132","topicId":"practice","title":"Question 132","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project.\nYou need to deploy a model from the model catalog to support real-time inference.\nThe solution must meet the following requirements:\nUse key-based authentication.\n•\nSupport real-time REST API access.\n•\nNOT consume the vCPU quota of the virtual machines in the Azure subscription.\n•\nWhich type of deployment should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"serverless API"},{"id":"b","label":"batch"},{"id":"c","label":"self-hosted container"},{"id":"d","label":"standard"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. serverless API\nA serverless API deployment in Microsoft Foundry allows you to expose the model through a real-time REST\nendpoint without managing underlying infrastructure. It supports key-based authentication and provides\ninstant scalability for real-time inference. Most importantly, it does not consume the vCPU quota of your\nAzure subscription because the compute is fully managed by the service, making it ideal for this requirement.\nIncorrect answers:\nB. batch\nBatch deployments are designed for asynchronous, large-scale processing and do not support real-time\nREST API inference.\nC. self-hosted container\nThis option requires you to run the model on your own infrastructure, which would consume vCPU resources\nin your Azure subscription.\nD. standard\nStandard deployments run on dedicated compute resources within your subscription, which means they\nconsume vCPU quota and do not meet the requirement."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q132 · pages 137–137","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q133","topicId":"practice","title":"Question 133","prompt":[{"type":"paragraph","text":"You have a Python application collects customer comments before posting them to a public forum.\nYou need to send a text comment to Azure AI Content Safety and return the self-harm severity from the\nresponse. How should you complete the code?"},{"type":"image","src":"/content/ai-103/figure-418.png","alt":"Original diagram from AI-103, page 138","caption":"Source: AI-103 PDF · page 138"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"AnalyzeTextOptions argument","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Client method","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"categories=comment"},{"id":"p1-c2","label":"text=[comment]"},{"id":"p1-c3","label":"text=comment"},{"id":"p1-c4","label":"TextCategory.SELF_HARM(comment)"},{"id":"p2-c1","label":"analyze_image"},{"id":"p2-c2","label":"analyze_text"},{"id":"p2-c3","label":"moderate_text"},{"id":"p2-c4","label":"path.post"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-419.png","alt":"Original diagram from AI-103, page 138","caption":"Source: AI-103 PDF · page 138"},{"type":"paragraph","text":"$77"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q133 · pages 137–139","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q134","topicId":"practice","title":"Question 134","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent generates summaries from\nretrieved policy documents.\nYou need to improve response completeness. The solution must be implemented in the logic of the\napplication code before responses are returned.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Add a retry evaluation before the responses are returned."},{"id":"b","label":"Decrease the value of the temperature parameter."},{"id":"c","label":"Increase the value of the presence_penalty parameter"},{"id":"d","label":"Replace the model with a smaller deployment."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. Add a retry evaluation before the responses are returned.\nTo improve response completeness, implementing a retry or evaluation mechanism in the application logic\nallows the system to validate the generated response and regenerate it if it is incomplete. This approach\nensures higher-quality outputs by programmatically checking whether the response meets completeness\ncriteria before returning it to the user. This aligns directly with the requirement to implement the solution in\napplication code logic.\nIncorrect answers:\nB. Decrease the value of the temperature parameter.\nLowering temperature makes responses more deterministic but does not specifically improve completeness.\nC. Increase the value of the presence_penalty parameter\nThis encourages introducing new topics, which may reduce focus rather than improve completeness.\nD. Replace the model with a smaller deployment.\nA smaller model typically has lower capability and may reduce response quality and completeness."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q134 · pages 139–140","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q135","topicId":"practice","title":"Question 135","prompt":[{"type":"paragraph","text":"You are developing an application that will detect faulty components produced on a factory production\nline. The components are specific to your business.\nYou need to use the Azure Custom Vision API to help detect common faults.\nWhich three actions should you perform in sequence?"},{"type":"image","src":"/content/ai-103/figure-424.png","alt":"Original diagram from AI-103, page 140","caption":"Source: AI-103 PDF · page 140"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"ordering","items":[{"id":"i1","label":"Initialize a training dataset"},{"id":"i2","label":"Train a classifier model"},{"id":"i3","label":"Create a project"},{"id":"i4","label":"Upload and tag images"},{"id":"i5","label":"Train an object detection model"}],"count":3,"correctOrder":["i3","i4","i2"]},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-425.png","alt":"Original diagram from AI-103, page 140","caption":"Source: AI-103 PDF · page 140"},{"type":"paragraph","text":"Correct Answer:\n1. Create a project.\nThe first step in Azure Custom Vision is to create a project where you define the type of model (classification\nor object detection) and organize your dataset and training process.\n2. Upload and tag images.\nAfter creating the project, you must upload images of the components and tag them appropriately (for\nexample, faulty vs non-faulty). Tagging is critical because it provides labeled data for supervised learning.\n3. Train the classifier model.\nOnce the images are uploaded and tagged, you train the model so it can learn patterns and detect faults\nbased on the labeled dataset.\nIncorrect answers:\nInitialize the training dataset.\nThis is not an explicit step in Azure Custom Vision; dataset preparation happens during image upload and\ntagging.\nTrain the object detection model.\nObject detection is used when identifying locations of objects in images, not just classifying faults. The\nscenario focuses on detecting faulty components, which aligns with classification."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q135 · pages 140–141","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q136","topicId":"practice","title":"Question 136","prompt":[{"type":"paragraph","text":"You have an Azure subscription.\nYou plan to build an app that will use the Azure AI DALL-E model. You need to deploy the model.\nWhat should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"the Azure SDK for Python and PowerShell cmdlets."},{"id":"b","label":"the Azure SDK for JavaScript and Azure Machine Learning Studio."},{"id":"c","label":"Microsoft Foundry and the Azure Command Line Interface (CLI)"},{"id":"d","label":"the Azure portal and Microsoft Graph API"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. Microsoft Foundry and the Azure Command Line Interface (CLI)\nAzure AI DALL-E models are part of Azure AI Foundry (formerly Azure AI Studio) and are deployed through\nmodel catalog capabilities. You can deploy these models using Microsoft Foundry UI or automate\ndeployments using the Azure CLI. This combination supports proper provisioning, deployment, and\nmanagement of generative AI models like DALL-E.\nIncorrect answers:\nA. the Azure SDK for Python and PowerShell cmdlets.\nThese can interact with deployed models but are not used to deploy DALL-E models from the model catalog.\nB. the Azure SDK for JavaScript and Azure Machine Learning Studio.\nAzure Machine Learning Studio is not used for deploying Azure AI DALL-E models from the Foundry model\ncatalog.\nD. the Azure portal and Microsoft Graph API\nMicrosoft Graph API is unrelated to deploying AI models and cannot be used for this purpose."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q136 · pages 141–142","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q137","topicId":"practice","title":"Question 137","prompt":[{"type":"paragraph","text":"You have a custom named entity recognition (NER) project in Azure Language in Foundry Tools for\nsupport tickets. The schema for the project contains an entity type named ContactInfo.\nIn tagged training files, ContactInfo is used for phone numbers, email addresses, and social media handles.\nModel evaluation shows low precision for ContactInfo, including false positives in which nearby text is\nextracted as ContactInfo.\nYou need to improve the precision of the project.\nWhat should you do before retraining the model?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Lower the confidence threshold for ContactInfo."},{"id":"b","label":"Trigger an auto-labeling job."},{"id":"c","label":"Add more support tickets as training data and label more ContactInfo entities."},{"id":"d","label":"Replace ContactInfo by using Phone, Email, and SocialMedia entities. Relabel every matching span."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$78"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q137 · pages 142–143","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q138","topicId":"practice","title":"Question 138","prompt":[{"type":"paragraph","text":"You are building a text-to-speech solution that uses Azure Speech in Foundry Tools to read\ninstructions from the script in a text file.\nYou discover that the solution often pronounces technical terms incorrectly.\nYou need to prevent the incorrect pronunciations. The solution must minimize development effort.\nWhat should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"From Speech Studio, train a custom neural voice"},{"id":"b","label":"Use Speech Synthesis Markup Language (SSML) to specify phonemes."},{"id":"c","label":"Use Speech Synthesis Markup Language (SSML) to apply say as rules."},{"id":"d","label":"Use Speech Synthesis Markup Language (SSML) to adjust the prosody of the voice."},{"id":"e","label":"From Azure OpenAI use the Whisper model."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$79"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q138 · pages 143–143","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q139","topicId":"practice","title":"Question 139","prompt":[{"type":"paragraph","text":"You need to create a new resource that will be used to perform sentiment analysis and optical\ncharacter recognition (OCR).\nThe solution must meet the following requirements:\nUse a single key and endpoint to access multiple services.\n•\nConsolidate billing for future services that you might use.\n•\nSupport the use of Azure Vision in Foundry Tools in the future.\n•\nHow should you complete the HTTP request to create the new resource?"},{"type":"image","src":"/content/ai-103/figure-434.png","alt":"Original diagram from AI-103, page 144","caption":"Source: AI-103 PDF · page 144"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"HTTP method","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Resource kind","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"PATCH"},{"id":"p1-c2","label":"POST"},{"id":"p1-c3","label":"PUT"},{"id":"p2-c1","label":"CognitiveServices"},{"id":"p2-c2","label":"ComputerVision"},{"id":"p2-c3","label":"TextAnalytics"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c1"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-437.png","alt":"Original diagram from AI-103, page 145","caption":"Source: AI-103 PDF · page 145"},{"type":"paragraph","text":"$7a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q139 · pages 144–146","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q140","topicId":"practice","title":"Question 140","prompt":[{"type":"paragraph","text":"You are developing a new sales system that will process user-generated video and text from a public-\nfacing website.\nYou plan to notify users that their data has been processed by the sales system. Which responsible AI\nprinciple does this help meet?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"fairness"},{"id":"b","label":"transparency"},{"id":"c","label":"inclusiveness"},{"id":"d","label":"reliability and safety"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. transparency\nTransparency in responsible AI refers to informing users how their data is being used and how systems\noperate. By notifying users that their video and text data are being processed by the sales system, you\nensure openness about data usage. This builds trust and aligns with the principle of making AI systems\nunderstandable and clear to users.\nIncorrect answers:\nA. fairness\nFairness focuses on eliminating bias and ensuring equitable treatment, not informing users about data\nprocessing.\nC. inclusiveness\nInclusiveness ensures accessibility and usability for diverse groups, not transparency of data usage.\nD. reliability and safety\nThis principle relates to consistent and safe system behavior, not user awareness of data processing."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q140 · pages 146–147","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q141","topicId":"practice","title":"Question 141","prompt":[{"type":"paragraph","text":"You are creating an enrichment pipeline that will use Azure AI Search. The knowledge store contains\nunstructured JSON data and the text from scanned PDF documents.\nWhich projection type should you use for each data type?"},{"type":"image","src":"/content/ai-103/figure-448.png","alt":"Original diagram from AI-103, page 147","caption":"Source: AI-103 PDF · page 147"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Store JSON documents","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Store extracted text","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"File projection"},{"id":"p1-c2","label":"Object projection"},{"id":"p1-c3","label":"Table projection"},{"id":"p2-c1","label":"File projection"},{"id":"p2-c2","label":"Object projection"},{"id":"p2-c3","label":"Table projection"}],"allowReuse":true,"correctPairs":{"p1":"p1-c2","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-443.png","alt":"Original diagram from AI-103, page 147","caption":"Source: AI-103 PDF · page 147"},{"type":"paragraph","text":"Correct Answer:\nJSON data: Object projection\nObject projection is used for structured or semi-structured data like JSON. It preserves the hierarchical\nstructure of the JSON documents, making it suitable for storing and querying complex objects in the\nknowledge store.\nExtracted text data: Table projection\nTable projection is ideal for flattened, structured representations of data such as extracted text from\ndocuments. It organizes the data into rows and columns, making it efficient for querying and analysis,\nespecially for OCR-extracted text from scanned PDFs.\nIncorrect answers:\nFile projection\nFile projection is used to store enriched documents as files (for example, images or PDFs), not for structured\nJSON or extracted text intended for querying."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q141 · pages 147–148","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q142","topicId":"practice","title":"Question 142","prompt":[{"type":"paragraph","text":"You have an Azure subscription that contains an Azure App Service app named App1. You provision a\nMicrosoft Foundry Service resource named CSAccount1.\nYou need to configure App1 to access CSAccount1. The solution must minimize administrative effort.\nWhat should you use to configure App1?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"the endpoint URI and subscription key"},{"id":"b","label":"the endpoint URI and an OAuth token"},{"id":"c","label":"the endpoint URI and a shared access signature (SAS) token"},{"id":"d","label":"a system assigned managed identity and an X.509 certificate"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. the endpoint URI and subscription key\nUsing the endpoint URI along with a subscription key is the simplest and most commonly used method to\nauthenticate an App Service app with an Azure AI (Foundry) resource. It requires minimal configuration and\nadministrative effort, making it ideal for quick integration scenarios. The application simply includes the key\nin the request headers to securely access the service.\nIncorrect answers:\nB. the endpoint URI and an OAuth token\nThis requires additional setup with Microsoft Entra ID and token management, increasing administrative\neffort.\nC. the endpoint URI and a shared access signature (SAS) token\nSAS tokens are typically used for Azure Storage, not for accessing Azure AI services.\nD. a system assigned managed identity and an X.509 certificate\nThis involves more complex configuration and certificate management, which does not minimize\nadministrative effort."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q142 · pages 148–148","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q143","topicId":"practice","title":"Question 143","prompt":[{"type":"paragraph","text":"You are building a model to detect objects in images.\nThe performance of the model based on training data is shown in the following exhibit."},{"type":"image","src":"/content/ai-103/figure-454.png","alt":"Original diagram from AI-103, page 149","caption":"Source: AI-103 PDF · page 149"},{"type":"paragraph","text":"Use the drop-down menus to select the answer choice that completes each statement based on the\ninformation presented in the graphic."},{"type":"image","src":"/content/ai-103/figure-449.png","alt":"Original diagram from AI-103, page 149","caption":"Source: AI-103 PDF · page 149"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"False positive percentage","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4","p1-c5"]},{"id":"p2","label":"True positives / (True positives + False negatives)","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4","p2-c5"]}],"choices":[{"id":"p1-c1","label":"0"},{"id":"p1-c2","label":"25"},{"id":"p1-c3","label":"30"},{"id":"p1-c4","label":"50"},{"id":"p1-c5","label":"100"},{"id":"p2-c1","label":"0"},{"id":"p2-c2","label":"25"},{"id":"p2-c3","label":"30"},{"id":"p2-c4","label":"50"},{"id":"p2-c5","label":"100"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-452.png","alt":"Original diagram from AI-103, page 150","caption":"Source: AI-103 PDF · page 150"},{"type":"paragraph","text":"Correct Answer:\n0\nPrecision is given as 100%.\nPrecision = True Positives / (True Positives + False Positives).\nIf precision is 100%, it means False Positives = 0.\nSo, the percentage of false positives is 0%.\n25\nRecall is given as 25%.\nRecall = True Positives / (True Positives + False Negatives).\nSo the required value is directly the recall value, which is 25%."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q143 · pages 148–150","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q144","topicId":"practice","title":"Question 144","prompt":[{"type":"paragraph","text":"You are developing an application that will use Azure AI Search for internal documents. You need to\nimplement document-level filtering for Azure AI Search.\nWhich three actions should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Add allowed groups to each index entry"},{"id":"b","label":"Create one index per group."},{"id":"c","label":"Send access tokens from Microsoft Entra ID, with the search request."},{"id":"d","label":"Retrieve all the groups."},{"id":"e","label":"Retrieve the group memberships of the user"},{"id":"f","label":"Supply the groups as a filter for the search requests"}],"correctOptionIds":["a","e","f"]},"explanation":[{"type":"paragraph","text":"$7b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q144 · pages 150–151","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q145","topicId":"practice","title":"Question 145","prompt":[{"type":"paragraph","text":"You have a web app that uses Azure AI Search.\nWhen reviewing activity you see greater than expected search query volumes. You suspect that the query\nkey is compromised.\nYou need to prevent unauthorized access to the search endpoint and ensure that users only have read only\naccess to the documents collection. The solution must minimize app downtime.\nWhich three actions should you perform in sequence?"},{"type":"image","src":"/content/ai-103/figure-455.png","alt":"Original diagram from AI-103, page 151","caption":"Source: AI-103 PDF · page 151"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"ordering","items":[{"id":"i1","label":"Regenerate the primary admin key"},{"id":"i2","label":"Regenerate the secondary admin key"},{"id":"i3","label":"Change the application to use the secondary admin key"},{"id":"i4","label":"Add a new query key"},{"id":"i5","label":"Change the application to use the new query key"},{"id":"i6","label":"Delete the compromised query key"}],"count":3,"correctOrder":["i4","i5","i6"]},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-464.png","alt":"Original diagram from AI-103, page 152","caption":"Source: AI-103 PDF · page 152"},{"type":"paragraph","text":"Correct Answer:\nAdd a new query key\nTo maintain availability and minimize downtime, you should first create a new query key. Query keys provide\nread-only access, which meets the requirement that users should only have read access to the documents.\nChange the app to use the new key\nNext, update the application to use the newly created query key. This ensures uninterrupted service while\ntransitioning away from the compromised key.\nDelete the compromised key\nFinally, remove the compromised key to prevent any further unauthorized access to the search endpoint.\nIncorrect answers:\nRegenerate the primary admin key\nAdmin keys provide full control and are not intended for query operations; regenerating them does not\naddress compromised query keys.\nRegenerate the secondary admin key\nSame as above, admin keys are not used for query-only access.\nChange the app to use the secondary admin key\nUsing admin keys violates the requirement of read-only access and increases security risk."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q145 · pages 151–152","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q146","topicId":"practice","title":"Question 146","prompt":[{"type":"paragraph","text":"You have an Azure AI Search indexer that ingest PDF policy manuals.\nClient applications must display page-level citations that have bounding polygons for both text and images.\nYou need to add a single built-in multimodal content extraction skill to the Azure AI Search skillset.\nThe solution must meet the following requirements:\nProvide text and image location metadata.\n•\nExtract tables that span multiple pages.\n•\nWhat should you add?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Document Layout"},{"id":"b","label":"Document Extraction"},{"id":"c","label":"Azure Content Understanding"},{"id":"d","label":"GenAI Prompt"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$7c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q146 · pages 152–153","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q147","topicId":"practice","title":"Question 147","prompt":[{"type":"paragraph","text":"You are designing a content management system.\nYou need to ensure that the reading experience is optimized for users who have reduced comprehension and\nlearning differences, such as dyslexia. The solution must minimize development effort.\nWhich Azure service should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Document Intelligence in Foundry Tools"},{"id":"b","label":"Azure Language in Foundry Tools"},{"id":"c","label":"Azure AI Immersive Reader"},{"id":"d","label":"Azure Translator in Foundry Tools"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nC. Azure AI Immersive Reader\nAzure AI Immersive Reader is specifically designed to improve reading comprehension and accessibility for\nusers, including those with dyslexia and other learning differences. It provides features such as text-to-\nspeech, syllable breakdown, line focus, and customizable text display. It is easy to integrate and requires\nminimal development effort, making it the best choice for optimizing the reading experience.\nIncorrect answers:\nA. Azure Document Intelligence in Foundry Tools\nUsed for extracting structured data from documents, not for improving reading accessibility.\nB. Azure Language in Foundry Tools\nProvides NLP capabilities like sentiment analysis and entity recognition, but does not enhance reading\nexperience.\nD. Azure Translator in Foundry Tools\nUsed for language translation, not for improving comprehension or accessibility for users with learning\ndifferences."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q147 · pages 153–154","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q148","topicId":"practice","title":"Question 148","prompt":[{"type":"paragraph","text":"You are building a custom vision model that will be deployed as part of an iOS app. You have images\nof cats and dogs. Each image contains either a cat or a dog.\nYou need to use the Azure Custom Vision service to detect whether the image is of a cat or a dog.\nHow should you configure the project in the Azure Custom Vision portal?"},{"type":"image","src":"/content/ai-103/figure-465.png","alt":"Original diagram from AI-103, page 155","caption":"Source: AI-103 PDF · page 155"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Deployment type","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Version update policy","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Standard"},{"id":"p1-c2","label":"Global Standard"},{"id":"p1-c3","label":"Global Provisioned"},{"id":"p2-c1","label":"Once the current version expires"},{"id":"p2-c2","label":"Opt out of automatic model version upgrades"},{"id":"p2-c3","label":"Upgrade once a new default version becomes available"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-468.png","alt":"Original diagram from AI-103, page 156","caption":"Source: AI-103 PDF · page 156"},{"type":"paragraph","text":"$7d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q148 · pages 154–157","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q149","topicId":"practice","title":"Question 149","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project that contains an agent. The agent has a Model Context Protocol\n(MCP) tool named kbsearch that queries a knowledge base stored in Azure AI Search.\nSome agent runs return answers from the base model without invoking the knowledge base, which results in\nresponses without grounded citations.\nYou are provided with the following code snippet that runs the agent."},{"type":"image","src":"/content/ai-103/figure-471.png","alt":"Original diagram from AI-103, page 157","caption":"Source: AI-103 PDF · page 157"},{"type":"paragraph","text":"You need to deterministically force the agent to invoke kbsearch on each run. What should you do?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Add the response_format parameter to the create_and_process() method call."},{"id":"b","label":"Replace create_and_process() method with the create_thread_and_process_run() method."},{"id":"c","label":"Add the toolset parameter to the create_and_process() method call."},{"id":"d","label":"Add the tool_choice parameter to the create_and_process() method call."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nD. Add the tool_choice parameter to the create_and_process() method call.\nThis is correct because tool_choice controls which tool the agent must use during a run. By specifying the\nkbsearch MCP tool as the required tool, you can prevent the agent from answering directly from the base\nmodel and ensure that the knowledge base is invoked on every run, providing grounded responses and\ncitations.\nIncorrect Answers:\nA. Add the response_format parameter to the create_and_process() method call.\nThis controls the structure or format of the model's response and does not force a specific tool invocation.\nB. Replace create_and_process() with create_thread_and_process_run().\nThis changes how the thread and run are created but does not force the agent to invoke a particular tool.\nC. Add the toolset parameter to the create_and_process() method call.\nA toolset defines or provides the tools available to the agent, but it does not deterministically force the agent\nto invoke kbsearch."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q149 · pages 157–158","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q150","topicId":"practice","title":"Question 150","prompt":[{"type":"paragraph","text":"You are developing a text processing solution. You have the following function."},{"type":"image","src":"/content/ai-103/figure-474.png","alt":"Original diagram from AI-103, page 158","caption":"Source: AI-103 PDF · page 158"},{"type":"paragraph","text":"You call the function and use the following string as the second argument. Our tour of London included a\nvisit to Buckingham Palace\nWhat will be the output of the function?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"London and Buckingham Palace only"},{"id":"b","label":"Tour and visit only"},{"id":"c","label":"Our tour of London included a visit to Buckingham Palace"},{"id":"d","label":"London and Tour only"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nA. London and Buckingham Palace only\nThis is correct because recognize_entities() identifies named entities in the supplied text and returns them\nthrough response.entities. In this sentence, London is recognized as a location entity and Buckingham\nPalace as a location/landmark entity. The function then prints the recognized entity text, rather than printing\nevery word in the sentence.\nIncorrect Answers:\nB. Tour and visit only\nThese are common words and are not recognized as named entities by the entity recognition service.\nC. Our tour of London included a visit to Buckingham Palace\nThe function does not print the original input text. It only prints the text of entities identified by\nrecognize_entities().\nD. London and Tour only\n“Tour” is not a named entity in this context, while Buckingham Palace is recognized as an entity."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q150 · pages 158–159","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q151","topicId":"practice","title":"Question 151","prompt":[{"type":"paragraph","text":"You are building a solution that students will use to find references for essays. You use the following\ncode to start building the solution."},{"type":"image","src":"/content/ai-103/figure-477.png","alt":"Original diagram from AI-103, page 159","caption":"Source: AI-103 PDF · page 159"},{"type":"paragraph","text":"For each of the following statements, select Yes is the statement is true. Otherwise, select No."},{"type":"image","src":"/content/ai-103/q151-linked-entities-answer-area.png","alt":"Original diagram from AI-103, page 159","caption":"Source: AI-103 PDF · page 159"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"The code will detect the language of documents."},{"id":"s2","label":"The url attribute returned for each linked entity will be a Bing search link."},{"id":"s3","label":"The matches attribute returned for each linked entity will provide the location in a document where the entity is referenced."}],"correctValues":{"s1":false,"s2":false,"s3":true}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-481.png","alt":"Original marked answer area from AI-103, page 160","caption":"Source: AI-103 PDF · page 160"},{"type":"paragraph","text":"$7e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q151 · pages 159–160","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q152","topicId":"practice","title":"Question 152","prompt":[{"type":"paragraph","text":"You have a Microsoft Foundry project for a support ticket triage app that reads ticket text from a\ndatabase.\nYou need to ensure that the app meets the following requirements:\nCompares candidate models by quality, cost, and throughput\n•\nPrevents hosting model weights in the Azure subscription\n•\nWhat should you configure?"},{"type":"image","src":"/content/ai-103/figure-484.png","alt":"Original diagram from AI-103, page 161","caption":"Source: AI-103 PDF · page 161"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Model evaluation","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Deployment option","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Configure private endpoint access."},{"id":"p1-c2","label":"Use deployment lists and license tabs."},{"id":"p1-c3","label":"Use tool catalog connections and run traces."},{"id":"p1-c4","label":"Use model catalog leaderboards and model cards."},{"id":"p2-c1","label":"Bring your own model."},{"id":"p2-c2","label":"Build a vector index."},{"id":"p2-c3","label":"Use a serverless deployment."},{"id":"p2-c4","label":"Use a managed compute deployment."}],"allowReuse":true,"correctPairs":{"p1":"p1-c4","p2":"p2-c3"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-485.png","alt":"Original marked answer area from AI-103, page 161","caption":"Source: AI-103 PDF · page 161"},{"type":"paragraph","text":"$7f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q152 · pages 160–162","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q153","topicId":"practice","title":"Question 153","prompt":[{"type":"paragraph","text":"You have an Azure subscription.\nYou need to build an app that will compare documents for semantic similarity. The solution must meet the\nfollowing requirements:\nReturn numeric vectors that represent the tokens of each document.\n•\nMinimize development effort.\n•\nWhich Azure OpenAI model should you use?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"GPT-3.5"},{"id":"b","label":"embeddings"},{"id":"c","label":"GPT-4"},{"id":"d","label":"DALL-E"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. embeddings\nAzure OpenAI embedding models convert text into numeric vectors that capture the semantic meaning of\nthe text. These vectors can then be compared using similarity measures to determine how semantically\nsimilar two documents are. Using the built-in embeddings capability minimizes development effort because\nyou do not need to build your own language representation model.\nIncorrect Answers:\nA. GPT-3.5\nGPT-3.5 is a generative language model designed primarily for generating and understanding text, not\ndirectly producing embedding vectors for semantic similarity.\nC. GPT-4\nGPT-4 is a generative language model and is not the appropriate model for directly generating document\nembeddings.\nD. DALL-E\nDALL-E is designed for image generation and is not intended for converting document text into semantic\nembedding vectors."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q153 · pages 162–163","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q154","topicId":"practice","title":"Question 154","prompt":[{"type":"paragraph","text":"You are building an app that will provide users with definitions of common AI terms. You create the\nfollowing Python code."},{"type":"image","src":"/content/ai-103/figure-490.png","alt":"Original diagram from AI-103, page 163","caption":"Source: AI-103 PDF · page 163"},{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."},{"type":"image","src":"/content/ai-103/q154-llm-statements-answer-area.png","alt":"Original diagram from AI-103, page 163","caption":"Source: AI-103 PDF · page 163"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"The response will contain an explanation of large language models (LLMs) that has a high degree of certainty."},{"id":"s2","label":"Changing “what is an LLM?” to “What is an LLM in the context of AI models?” will produce the intended response."},{"id":"s3","label":"Changing “You are a helpful assistant.” to “You must answer only within the context of AI language models.” will give a higher likelihood of producing the intended response."}],"correctValues":{"s1":false,"s2":false,"s3":true}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/q154-llm-statements-answer-area-correct.png","alt":"Original marked answer area from AI-103, page 164","caption":"Source: AI-103 PDF · page 164"},{"type":"paragraph","text":"Statement 1 --> No\nThe prompt “What is an LLM?” is ambiguous because the abbreviation “LLM” can have different meanings.\nThe code does not provide enough contextual instruction to guarantee that the response will explain Large\nLanguage Models with a high degree of certainty.\nStatement 2 --> No\nChanging the prompt to “What is an LLM in the context of AI models?” adds context and may make the\nintended meaning clearer. However, the wording “will produce the intended response” implies a guarantee.\nPrompt changes can increase the likelihood of a desired response but cannot guarantee a specific output.\nStatement 3 --> Yes\nChanging the system message to “You must answer only within the context of AI language models.”\nprovides a stronger and more specific instruction about the intended domain. System-level instructions have\na higher priority than user messages, so this change increases the likelihood that the model will interpret\nLLM as Large Language Model and provide the intended response."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q154 · pages 163–164","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q155","topicId":"practice","title":"Question 155","prompt":[{"type":"paragraph","text":"You have an Azure OpenAI model named AI1.\nYou are building a web app named App1 by using the Azure OpenAI SDK. You need to configure App1 to\nconnect to AI1.\n\nWhat information must you provide?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"the deployment name, key, and model name"},{"id":"b","label":"the endpoint, key, and model type"},{"id":"c","label":"the deployment name, endpoint, and key"},{"id":"d","label":"the endpoint, key, and model name"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$80"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q155 · pages 164–165","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q156","topicId":"practice","title":"Question 156","prompt":[{"type":"paragraph","text":"You are building a solution in Azure that will use Azure Language in Foundry Tools service to process\nsensitive customer data.\nYou need to ensure that only specific Azure processes can access the Language service. The solution must\nminimize administrative effort.\nWhat should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Application Gateway"},{"id":"b","label":"a virtual network gateway"},{"id":"c","label":"IPsec rules"},{"id":"d","label":"virtual network rules"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"$81"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q156 · pages 165–166","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q157","topicId":"practice","title":"Question 157","prompt":[{"type":"paragraph","text":"You have an Azure subscription that contains a Microsoft Foundry Service resource named\nCSAccount1 and a virtual network named VNet1. CSAaccount1 is connected to VNet1.\nYou need to ensure that only specific resources can access CSAccount1. The solution must meet the\nfollowing requirements:\nPrevent external access to CSAccount1.\n•\nMinimize administrative effort.\n•\nWhich two actions should you perform?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"credential","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"project_client.agents method","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"AzureKeyCredential()"},{"id":"p1-c2","label":"DefaultAzureCredential()"},{"id":"p1-c3","label":"None"},{"id":"p2-c1","label":"create_version"},{"id":"p2-c2","label":"get"},{"id":"p2-c3","label":"get_version"}],"allowReuse":true,"correctPairs":{"p1":"p1-c2","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"paragraph","text":"$82"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q157 · pages 166–167","url":""},"review":{"status":"ready","notes":["Interaction labels normalized for readability; the original image remains authoritative for wording."]}},{"id":"ai103-q158","topicId":"practice","title":"Question 158","prompt":[{"type":"paragraph","text":"You have a collection of press releases stored as PDF files.\nYou need to extract text from the files and perform sentiment analysis.\nWhich service should you use for each task?"},{"type":"image","src":"/content/ai-103/figure-503.png","alt":"Original diagram from AI-103, page 168","caption":"Source: AI-103 PDF · page 168"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Extract text","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Perform sentiment analysis","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"Azure AI Search"},{"id":"p1-c2","label":"Azure Vision in Foundry Tools"},{"id":"p1-c3","label":"Azure Document Intelligence in Foundry Tools"},{"id":"p2-c1","label":"Azure AI Search"},{"id":"p2-c2","label":"Azure AI Computer Vision"},{"id":"p2-c3","label":"Azure Document Intelligence in Foundry Tools"},{"id":"p2-c4","label":"Azure Language in Foundry Tools"}],"allowReuse":true,"correctPairs":{"p1":"p1-c3","p2":"p2-c4"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-504.png","alt":"Original marked answer area from AI-103, page 168","caption":"Source: AI-103 PDF · page 168"},{"type":"paragraph","text":"$83"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q158 · pages 167–169","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q159","topicId":"practice","title":"Question 159","prompt":[{"type":"paragraph","text":"You are designing an Azure AI solution to identify defective products on a production line.\nYou have a real-time video feed and an image library of sample products that are approved or rejected\nmanually. You need to recommend a service that meets the following requirements:\nMonitors the video feed and identifies the defective products.\n•\nCan train a new model by using the image library.\n•\nMinimizes development effort.\n•\nWhat should you recommend?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Vision in Foundry Tools"},{"id":"b","label":"Azure AI Video Indexer"},{"id":"c","label":"Azure AI Custom Vision"},{"id":"d","label":"Azure Machine Learning"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$84"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q159 · pages 169–170","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q160","topicId":"practice","title":"Question 160","prompt":[{"type":"paragraph","text":"You run the following command."},{"type":"image","src":"/content/ai-103/figure-509.png","alt":"Original diagram from AI-103, page 170","caption":"Source: AI-103 PDF · page 170"},{"type":"paragraph","text":"For each of the following statements, select Yes if the statement is true. Otherwise, select No."},{"type":"image","src":"/content/ai-103/figure-510.png","alt":"Original diagram from AI-103, page 170","caption":"Source: AI-103 PDF · page 170"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"true_false","statements":[{"id":"s1","label":"Going to http://localhost:5000/status will query the Azure endpoint to verify whether the API key used to start the container is valid."},{"id":"s2","label":"The container logging provider will write log data."},{"id":"s3","label":"Going to http://localhost:5000/swagger will provide the details to access the documentation for the available endpoints."}],"correctValues":{"s1":false,"s2":false,"s3":true}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-513.png","alt":"Original marked answer area from AI-103, page 171","caption":"Source: AI-103 PDF · page 171"},{"type":"paragraph","text":"Statement 1 --> No\nThe /status endpoint is used to verify whether the API key used to start the container is valid. However, it\nperforms this verification without causing an endpoint query to Azure. Therefore, the statement is incorrect\nbecause it specifically says that /status will query the Azure endpoint.\nStatement 2 --> No\nThe container logging provider does not automatically write persistent log data simply because the container\nis started. Logging providers such as Disk or Fluentd must be explicitly configured. The command shown\nonly provides the EULA, billing endpoint, and API key, so no additional logging provider has been configured.\nStatement 3 --> Yes\nThe /swagger endpoint provides the Swagger/OpenAPI documentation for the endpoints exposed by the\ncontainer. It can be used to view the available APIs and the information required to interact with them."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q160 · pages 170–171","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q161","topicId":"practice","title":"Question 161","prompt":[{"type":"paragraph","text":"You are developing an app that will use the Speech and Language APIs.\nYou need to provision resources for the app. The solution must ensure that each service is accessed by\nusing a single endpoint and credential.\nWhich type of resource should you create?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Language in Foundry Tools"},{"id":"b","label":"Microsoft Foundry service"},{"id":"c","label":"Azure Speech in Foundry Tools"},{"id":"d","label":"Content Safety in Foundry Control Plane"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$85"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q161 · pages 171–172","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q162","topicId":"practice","title":"Question 162","prompt":[{"type":"paragraph","text":"You are building an app that will include one million scanned magazine articles. Each article will be\nstored as an image file.\nYou need to configure the app to extract text from the images. The solution must minimize development\neffort.\nWhat should you include in the solution?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Document Intelligence in Foundry Tools"},{"id":"b","label":"the Read API in Azure Vision in Foundry Tools"},{"id":"c","label":"Azure Vision in Foundry Tools Image Analysis"},{"id":"d","label":"Azure Language in Foundry Tools"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$86"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q162 · pages 172–173","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q163","topicId":"practice","title":"Question 163","prompt":[{"type":"paragraph","text":"You are building an app that will scan confidential documents and use the Azure Language in Foundry\nTools service to analyze the contents.\nYou provision a Microsoft Foundry Service resource.\nYou need to ensure that the app can make requests to the Azure Language in Foundry Tools service\nendpoint. The solution must ensure that confidential documents remain on-premises.\nWhich three actions should you perform in sequence?"},{"type":"image","src":"/content/ai-103/figure-518.png","alt":"Original diagram from AI-103, page 173","caption":"Source: AI-103 PDF · page 173"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"ordering","items":[{"id":"i1","label":"Pull an image from Docker Hub."},{"id":"i2","label":"Run the container and specify an API key and the Endpoint URL of the Azure AI resource."},{"id":"i3","label":"Provision an on-premises Kubernetes cluster that is isolated from the internet."},{"id":"i4","label":"Provision an on-premises Kubernetes cluster that has internet connectivity."},{"id":"i5","label":"Provision an Azure Kubernetes Service (AKS) resource."},{"id":"i6","label":"Run the container and specify an App ID and Client Secret."},{"id":"i7","label":"Pull an image from the Microsoft Container Registry (MCR)."}],"count":3,"correctOrder":["i4","i7","i2"]},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-521.png","alt":"Original marked answer area from AI-103, page 174","caption":"Source: AI-103 PDF · page 174"},{"type":"paragraph","text":"$87"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q163 · pages 173–174","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q164","topicId":"practice","title":"Question 164","prompt":[{"type":"paragraph","text":"You are developing an app that will use the Azure Vision in Foundry Tools API to analyze an image.\nYou need configure the request that will be used by the app to identify whether an image is clipart or a line\ndrawing.\nHow should you complete the request?"},{"type":"image","src":"/content/ai-103/figure-524.png","alt":"Original diagram from AI-103, page 175","caption":"Source: AI-103 PDF · page 175"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"HTTP method","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"visualFeatures","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"GET"},{"id":"p1-c2","label":"PATCH"},{"id":"p1-c3","label":"POST"},{"id":"p2-c1","label":"description"},{"id":"p2-c2","label":"imageType"},{"id":"p2-c3","label":"objects"},{"id":"p2-c4","label":"tags"}],"allowReuse":false,"correctPairs":{"p1":"p1-c3","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-525.png","alt":"Original marked answer area from AI-103, page 175","caption":"Source: AI-103 PDF · page 175"},{"type":"paragraph","text":"$88"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q164 · pages 175–176","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q165","topicId":"practice","title":"Question 165","prompt":[{"type":"paragraph","text":"You use the Azure Custom Vision service to build a classifier. After training is complete, you need to\nevaluate the classifier.\nWhich two metrics are available for review?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"F-score"},{"id":"b","label":"area under the curve (AUC)"},{"id":"c","label":"precision"},{"id":"d","label":"weighted accuracy"},{"id":"e","label":"recall"}],"correctOptionIds":["c","e"]},"explanation":[{"type":"paragraph","text":"$89"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q165 · pages 176–177","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q166","topicId":"case-study","title":"Question 166","prompt":[{"type":"paragraph","text":"You need to configure the model deployment for Agent1 to meet the technical requirements. What\nshould you configure?"},{"type":"image","src":"/content/ai-103/figure-536.png","alt":"Original diagram from AI-103, page 180","caption":"Source: AI-103 PDF · page 180"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Deployment type","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"Version update policy","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"Standard"},{"id":"p1-c2","label":"Global Standard"},{"id":"p1-c3","label":"Global Provisioned"},{"id":"p2-c1","label":"Once the current version expires"},{"id":"p2-c2","label":"Opt out of automatic model version upgrades"},{"id":"p2-c3","label":"Upgrade once a new default version becomes available"}],"allowReuse":false,"correctPairs":{"p1":"p1-c1","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-539.png","alt":"Original marked answer area from AI-103, page 181","caption":"Source: AI-103 PDF · page 181"},{"type":"paragraph","text":"$8a"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q166 · pages 180–182","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q167","topicId":"case-study","title":"Question 167","prompt":[{"type":"paragraph","text":"You need to configure Agent1 to meet the security and compliance requirements.\nWhat should you use?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"self-harm content filtering"},{"id":"b","label":"prompt shields"},{"id":"c","label":"Personally identifiable information (PII) Detection"},{"id":"d","label":"violence content filtering"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"$8b"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q167 · pages 182–182","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q168","topicId":"case-study","title":"Question 168","prompt":[{"type":"paragraph","text":"You need to recommend a solution to assess the responses generated by Agent1 when the agent uses\nthe product information stored in storage1. The solution must meet the technical requirements.\nWhat should you include in the recommendation?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"a Retrieval Augmented Generation (RAG) evaluator"},{"id":"b","label":"a custom guardrail"},{"id":"c","label":"model fine-tuning"},{"id":"d","label":"a groundedness evaluator"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$8c"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q168 · pages 182–183","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q169","topicId":"case-study","title":"Question 169","prompt":[{"type":"paragraph","text":"You need to configure Agent1 to answer customer questions about only the Contoso products. The\nsolution must meet the business requirements.\nWhat should you do?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Modify the system message instructions."},{"id":"b","label":"Add few-shot examples."},{"id":"c","label":"Apply top-p sampling."},{"id":"d","label":"Increase the value of the temperature parameter."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"$8d"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q169 · pages 183–184","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q170","topicId":"case-study","title":"Question 170","prompt":[{"type":"paragraph","text":"You need to recommend an invoice review solution that resolves the issue reported by the finance\ndepartment.\nWhat should you include in the recommendation?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"chat completions"},{"id":"b","label":"Azure Document Intelligence in Foundry Tools"},{"id":"c","label":"Azure Content Understanding in Foundry Tools"},{"id":"d","label":"Image Analysis"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$8e"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q170 · pages 184–185","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q171","topicId":"case-study","title":"Question 171","prompt":[{"type":"paragraph","text":"You need to configure an indexing pipeline for Agent1 to retrieve the relevant product information in\nstorage1. The solution must meet the technical requirement.\nWhich two built-in skills should you use?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Azure OpenAI Embedding"},{"id":"b","label":"Entity Recognition"},{"id":"c","label":"Text Split"},{"id":"d","label":"Merge"},{"id":"e","label":"Language Detection"},{"id":"f","label":"key phrase extraction"}],"correctOptionIds":["a","c"]},"explanation":[{"type":"paragraph","text":"$8f"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q171 · pages 185–186","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q172","topicId":"case-study","title":"Question 172","prompt":[{"type":"paragraph","text":"You need to recommend a solution to support the planned changes and technical requirements for\nAgent1 to use the product information stored in storage1.\nWhat should you include in the recommendation?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Azure Translator in Foundry Tools"},{"id":"b","label":"Grounding with Bing Search"},{"id":"c","label":"Azure AI Search"},{"id":"d","label":"Azure Document intelligence in Foundry Tools"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"$90"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q172 · pages 186–187","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q173","topicId":"case-study","title":"Question 173","prompt":[{"type":"paragraph","text":"You need to ensure that the marketing department can generate videos by using the model\ndeployed to Project2.\nHow should you complete the Python code?"},{"type":"image","src":"/content/ai-103/figure-552.png","alt":"Original diagram from AI-103, page 187","caption":"Source: AI-103 PDF · page 187"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"Start video generation","allowedChoiceIds":["p1-c1","p1-c2","p1-c3","p1-c4"]},{"id":"p2","label":"Check job status","allowedChoiceIds":["p2-c1","p2-c2","p2-c3","p2-c4"]}],"choices":[{"id":"p1-c1","label":"create"},{"id":"p1-c2","label":"download_content"},{"id":"p1-c3","label":"list"},{"id":"p1-c4","label":"retrieve"},{"id":"p2-c1","label":"create"},{"id":"p2-c2","label":"download_content"},{"id":"p2-c3","label":"list"},{"id":"p2-c4","label":"retrieve"}],"allowReuse":true,"correctPairs":{"p1":"p1-c1","p2":"p2-c4"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-555.png","alt":"Original marked answer area from AI-103, page 188","caption":"Source: AI-103 PDF · page 188"},{"type":"paragraph","text":"Correct Answer:\ncreate\nTo generate a new video using the deployed model, you must call the create method. This initializes the video\ngeneration job using the provided prompt and model deployment.\nRetrieve\nVideo generation is an asynchronous operation. The retrieve method is used to check the status of the video\ngeneration job until it is completed, failed, or canceled.\nIncorrect answers:\ndownload_content\nUsed to download generated video content after completion, not to create or monitor the job.\nlist\nUsed to list existing video jobs, not to create or track a specific one.\nretrieve (first dropdown)\nRetrieve cannot be used to initiate video generation.\ncreate (second dropdown)\nCreate is only used to start the job, not to poll or check status."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q173 · pages 187–188","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q174","topicId":"case-study","title":"Question 174","prompt":[{"type":"paragraph","text":"You need to configure personalized user interactions for Agent1. The solution must meet the business\nrequirements.\nWhat should you include in the solution?"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"knowledge"},{"id":"b","label":"memory"},{"id":"c","label":"guardrails"},{"id":"d","label":"tools"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct Answer:\nB. memory\nMemory enables the agent to retain conversation context and recall relevant information from previous\ninteractions. This directly satisfies the business requirement of providing personalized user experiences\nacross sessions. By using memory, Agent1 can remember past preferences, previous queries, and context,\nallowing more relevant and tailored responses.\nIncorrect answers:\nA. knowledge\nKnowledge refers to external data sources (like product documents), not personalization or remembering\nuser interactions.\nC. guardrails\nGuardrails are used for safety and policy enforcement, not for personalization.\nD. tools\nTools enable the agent to perform actions or call external services, but do not provide conversational\nmemory or personalization."}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q174 · pages 189–189","url":""},"review":{"status":"ready","notes":[]}},{"id":"ai103-q175","topicId":"case-study","title":"Question 175","prompt":[{"type":"paragraph","text":"You need to ensure that Agent1Dev Team can access Agent1. The solution must meet the security and\ncompliance requirements.\nHow should you complete the Python code?"},{"type":"image","src":"/content/ai-103/figure-560.png","alt":"Original diagram from AI-103, page 190","caption":"Source: AI-103 PDF · page 190"}],"contextId":"contoso","difficulty":"unspecified","interaction":{"type":"matching","prompts":[{"id":"p1","label":"credential","allowedChoiceIds":["p1-c1","p1-c2","p1-c3"]},{"id":"p2","label":"project_client.agents method","allowedChoiceIds":["p2-c1","p2-c2","p2-c3"]}],"choices":[{"id":"p1-c1","label":"AzureKeyCredential()"},{"id":"p1-c2","label":"DefaultAzureCredential()"},{"id":"p1-c3","label":"None"},{"id":"p2-c1","label":"create_version"},{"id":"p2-c2","label":"get"},{"id":"p2-c3","label":"get_version"}],"allowReuse":false,"correctPairs":{"p1":"p1-c2","p2":"p2-c2"}},"explanation":[{"type":"heading","text":"Original answer from the PDF","level":"3"},{"type":"image","src":"/content/ai-103/figure-561.png","alt":"Original marked answer area from AI-103, page 190","caption":"Source: AI-103 PDF · page 190"},{"type":"paragraph","text":"$91"}],"optionExplanations":[],"source":{"name":"AI-103 1.pdf","locator":"Q175 · pages 189–191","url":""},"review":{"status":"ready","notes":[]}}],"sources":[{"name":"Cloud and AI Hub · AI-103 practice questions","locator":"User-provided PDF · 191 pages","url":""}],"conversion":{"inputName":"AI-103 1.pdf","coverage":"complete","notes":["Preserves all 175 numbered questions and the shared Contoso case study starting at Q166.","Answer keys and explanations are transcribed from the supplied PDF, not independently certified.","Original image-based questions keep their diagrams. Structured overrides are reviewed separately."],"unresolved":[]}},"initialAll":false,"initialFilter":"$undefined"}]]
