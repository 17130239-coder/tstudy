8:[["$","$L11","gh-300",{"course":{"schemaVersion":"1.0","id":"gh-300","revision":1,"title":"GH-300: GitHub Copilot","subtitle":"116 exam-prep practice questions · source-provided answer keys","description":"Structured GH-300 practice questions from the supplied JSON source. Question text, answer choices, and source-provided answer keys are preserved for interactive practice and review.","language":"en","icon":"code","accent":"indigo","coverImage":"/content/course-icons/gh-300.png","status":"published","topics":[{"id":"topic-1","title":"Topic 1","description":"Questions labeled Topic 1 in gh-300.json."},{"id":"topic-2","title":"Topic 2","description":"Questions labeled Topic 2 in gh-300.json."},{"id":"topic-3","title":"Topic 3","description":"Questions labeled Topic 3 in gh-300.json."},{"id":"topic-4","title":"Topic 4","description":"Questions labeled Topic 4 in gh-300.json."},{"id":"topic-5","title":"Topic 5","description":"Questions labeled Topic 5 in gh-300.json."},{"id":"topic-6","title":"Topic 6","description":"Questions labeled Topic 6 in gh-300.json."},{"id":"topic-7","title":"Topic 7","description":"Questions labeled Topic 7 in gh-300.json."}],"contexts":[],"questions":[{"id":"gh300-q001","topicId":"topic-1","title":"Question 1","prompt":[{"type":"paragraph","text":"Which Microsoft ethical AI principle is aimed at ensuring AI systems treat all people equally?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Privacy and Security"},{"id":"b","label":"Fairness"},{"id":"c","label":"Reliability and Safety"},{"id":"d","label":"Inclusiveness"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. Fairness"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 1","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q002","topicId":"topic-1","title":"Question 2","prompt":[{"type":"paragraph","text":"What can be done during AI development to minimize bias?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Collect massive amounts of data for training."},{"id":"b","label":"Focus on accuracy of the data."},{"id":"c","label":"Use diverse data, fairness metrics, and human oversight."},{"id":"d","label":"Improve on the computational efficiency and speed."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nC. Use diverse data, fairness metrics, and human oversight."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 2","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q003","topicId":"topic-1","title":"Question 3","prompt":[{"type":"paragraph","text":"Why is it important to ensure the security of the code used in Generative AI (Gen AI) tools?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Ensuring code security prevents unauthorized access and potential data breaches."},{"id":"b","label":"Ensuring code security enables the AI system to handle larger datasets effectively."},{"id":"c","label":"Ensuring code security maintains the integrity of the AI system."},{"id":"d","label":"Ensuring code security supports the development of more advanced AI features."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. Ensuring code security prevents unauthorized access and potential data breaches."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 3","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q004","topicId":"topic-1","title":"Question 4","prompt":[{"type":"paragraph","text":"A social media manager wants to use AI to filter content. How can they promote transparency in the platform’s AI operations?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"By providing clear explanations about the types of content the AI is designed to filter and how it arrives at its conclusion."},{"id":"b","label":"By relying on a well-regarded AI development company."},{"id":"c","label":"By regularly updating the AI filtering algorithm."},{"id":"d","label":"By focusing on user satisfaction with the content filtering"}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. By providing clear explanations about the types of content the AI is designed to filter and how it arrives at its conclusion."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 4","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q005","topicId":"topic-1","title":"Question 5","prompt":[{"type":"paragraph","text":"How does GitHub Copilot Chat utilize its training data and external sources to generate responses when answering coding questions?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"It primarily relies on the model’s training data to generate responses."},{"id":"b","label":"It combines its training data set, code in user repositories, and external sources like Bing to generate responses."},{"id":"c","label":"It uses user-provided documentation and exclusively to generate responses."},{"id":"d","label":"It primarily uses search results from Bing to generate responses."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. It combines its training data set, code in user repositories, and external sources like Bing to generate responses."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 5","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q006","topicId":"topic-1","title":"Question 6","prompt":[{"type":"paragraph","text":"Which principle emphasizes that AI systems should be understandable and provide clear information on how they work?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Fairness"},{"id":"b","label":"Accountability"},{"id":"c","label":"Transparency"},{"id":"d","label":"Inclusiveness"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nC. Transparency"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 6","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q007","topicId":"topic-1","title":"Question 7","prompt":[{"type":"paragraph","text":"Which of the following is a risk associated with using AI?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"AI replaces the need for developer opportunities in most fields."},{"id":"b","label":"AI eliminated the need for data privacy regulations."},{"id":"c","label":"AI algorithms are incapable of perpetuating existing biases."},{"id":"d","label":"AI systems can sometimes make decisions that are difficult to interpret."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nD. AI systems can sometimes make decisions that are difficult to interpret."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 7","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q008","topicId":"topic-1","title":"Question 8","prompt":[{"type":"paragraph","text":"What types of prompts or code snippets might be flagged by the GitHub Copilot toxicity filter? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Hate speech or discriminatory language (e.g., racial slurs, offensive stereotypes)"},{"id":"b","label":"Sexually suggestive or explicit content"},{"id":"c","label":"Code that contains logical errors or produces unexpected results"},{"id":"d","label":"Code comments containing strong opinions or criticisms"}],"correctOptionIds":["a","b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. Hate speech or discriminatory language (e.g., racial slurs, offensive stereotypes)\nB. Sexually suggestive or explicit content"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 8","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q009","topicId":"topic-1","title":"Question 9","prompt":[{"type":"paragraph","text":"How can the concept of fairness be integrated into the process of operating an AI tool?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Focusing on accessibility will ensure fairness."},{"id":"b","label":"Training AI data and algorithms to be free from biases will ensure fairness."},{"id":"c","label":"Regularly monitoring the AI tool’s performance will ensure fairness in its outputs."},{"id":"d","label":"Focusing on collecting large datasets for training will ensure fairness."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. Training AI data and algorithms to be free from biases will ensure fairness."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 9","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q010","topicId":"topic-1","title":"Question 10","prompt":[{"type":"paragraph","text":"What are the potential risks associated with relying heavily on code generated from GitHub Copilot? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"GitHub Copilot may introduce security vulnerabilities by suggesting code with known exploits."},{"id":"b","label":"GitHub Copilot’s suggestions may not always reflect best practices or the latest coding standards."},{"id":"c","label":"GitHub Copilot may increase development lead time by providing irrelevant suggestions."},{"id":"d","label":"GitHub Copilot may decrease developer velocity by requiring too much time in prompt engineering."}],"correctOptionIds":["a","b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. GitHub Copilot may introduce security vulnerabilities by suggesting code with known exploits.\nB. GitHub Copilot’s suggestions may not always reflect best practices or the latest coding standards."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 10","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q011","topicId":"topic-1","title":"Question 11","prompt":[{"type":"paragraph","text":"Why might a Generative AI (Gen AI) tool create inaccurate outputs?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"The Gen AI tool is programmed with a focus on creativity over factual accuracy."},{"id":"b","label":"The Gen AI tool is experiencing downtime and is not fully recovered."},{"id":"c","label":"The training data might contain biases or inconsistencies."},{"id":"d","label":"The Gen AI tool is being overloaded with too many requests at once."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nC. The training data might contain biases or inconsistencies."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 11","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q012","topicId":"topic-1","title":"Question 12","prompt":[{"type":"paragraph","text":"What should developers consider when relying on GitHub Copilot for generating code that involves statistical analysis?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"GitHub Copilot will automatically correct any statistical errors found in the user’s initial code."},{"id":"b","label":"GitHub Copilot can independently verify the statistical significance of results."},{"id":"c","label":"GitHub Copilot can design new statistical methods that have not been previously documented."},{"id":"d","label":"GitHub Copilot’s suggestions are based on statistical trends and may not always apply accurately to specific datasets."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nD. GitHub Copilot’s suggestions are based on statistical trends and may not always apply accurately to specific datasets."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 12","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q013","topicId":"topic-2","title":"Question 13","prompt":[{"type":"paragraph","text":"What is the primary role of the ‘/optimize’ slash command in Visual Studio?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Translates code into a more performant language."},{"id":"b","label":"Automatically formats the code according to the selected style guide."},{"id":"c","label":"Summarizes your documentation into more maintainable and readable formats."},{"id":"d","label":"Enhances the performance of the selected code by analyzing its runtime complexity."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nD. Enhances the performance of the selected code by analyzing its runtime complexity."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 13","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q014","topicId":"topic-2","title":"Question 14","prompt":[{"type":"paragraph","text":"Which GitHub Copilot plan could an Azure DevOps organization use without requiring a GitHub Enterprise license?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"GitHub Copilot Enterprise"},{"id":"b","label":"GitHub Copilot for Azure DevOps"},{"id":"c","label":"Copilot Teams"},{"id":"d","label":"GitHub Copilot Individual"}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. GitHub Copilot for Azure DevOps"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 14","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q015","topicId":"topic-2","title":"Question 15","prompt":[{"type":"paragraph","text":"Which of the following steps correctly demonstrates how to establish an organization-wide policy for GitHub Copilot Business to restrict its use to certain repositories?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Create a copilot.policy file in each repository"},{"id":"b","label":"Create a copilot.policy in the .github repository"},{"id":"c","label":"Configure the policies in the organization settings"},{"id":"d","label":"Apply policies through the GitHub Actions configuration"}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nC. Configure the policies in the organization settings"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 15","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q016","topicId":"topic-2","title":"Question 16","prompt":[{"type":"paragraph","text":"What type of information can you retrieve through GitHub Copilot Business Subscriptions via REST API? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"View code suggestions for a specific user"},{"id":"b","label":"List all GitHub Copilot seat assignments for an organization"},{"id":"c","label":"Get a summary of GitHub Copilot usage for organization members"},{"id":"d","label":"List of all unsubscribed GitHub Copilot members within an organization"}],"correctOptionIds":["b","c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. List all GitHub Copilot seat assignments for an organization\nC. Get a summary of GitHub Copilot usage for organization members"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 16","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q017","topicId":"topic-2","title":"Question 17","prompt":[{"type":"paragraph","text":"What is the best way to share feedback about GitHub Copilot Chat when using it on GitHub Mobile?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"The feedback section on the GitHub website."},{"id":"b","label":"By tweeting at GitHub’s official X (previously known as Twitter) account."},{"id":"c","label":"Use the emojis in the Copilot Chat interface."},{"id":"d","label":"The Settings menu in the GitHub Mobile app."}],"correctOptionIds":["c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nC. Use the emojis in the Copilot Chat interface."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 17","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q018","topicId":"topic-2","title":"Question 18","prompt":[{"type":"paragraph","text":"What specific function does the ‘/fix’ slash command perform?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Proposes changes for detected issues, suggesting corrections for syntax errors and programming mistakes."},{"id":"b","label":"Converts pseudocode into executable code, optimizing for readability and maintainability."},{"id":"c","label":"Generates new code snippets based on language syntax and best practices."},{"id":"d","label":"Initiates a code review with static analysis tools for security and logic errors."}],"correctOptionIds":["a"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. Proposes changes for detected issues, suggesting corrections for syntax errors and programming mistakes."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 18","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q019","topicId":"topic-2","title":"Question 19","prompt":[{"type":"paragraph","text":"Which GitHub Copilot pricing plans include features that exclude your GitHub Copilot data like usage, prompts, and suggestions from default training GitHub Copilot? (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"GitHub Copilot Codespace"},{"id":"b","label":"GitHub Copilot Business"},{"id":"c","label":"GitHub Copilot Individual"},{"id":"d","label":"GitHub Copilot Enterprise"}],"correctOptionIds":["b","d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. GitHub Copilot Business\nD. GitHub Copilot Enterprise"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 19","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q020","topicId":"topic-2","title":"Question 20","prompt":[{"type":"paragraph","text":"When using an IDE with a supported GitHub Copilot plug-in, which Chat features can be accessed from within the IDE? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Explain code and suggest improvements"},{"id":"b","label":"Find out about releases and commits"},{"id":"c","label":"Generate unit tests"},{"id":"d","label":"Plan coding tasks"}],"correctOptionIds":["a","c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. Explain code and suggest improvements\nC. Generate unit tests"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 20","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q021","topicId":"topic-2","title":"Question 21","prompt":[{"type":"paragraph","text":"Which Copilot Enterprise features are available in all commercially supported IDEs?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Knowledge bases"},{"id":"b","label":"Chat"},{"id":"c","label":"Inline suggestions"},{"id":"d","label":"Pull request summaries"}],"correctOptionIds":["b","c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. Chat\nC. Inline suggestions"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 21","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q022","topicId":"topic-2","title":"Question 22","prompt":[{"type":"paragraph","text":"What two options navigate to configure duplicate detection? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"Organization settings → Copilot → Policies"},{"id":"b","label":"Enterprise settings → Copilot → Policies"},{"id":"c","label":"Repository settings → Copilot → Policies"},{"id":"d","label":"User settings → Copilot → Policies"}],"correctOptionIds":["a","b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. Organization settings → Copilot → Policies\nB. Enterprise settings → Copilot → Policies"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 22","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q023","topicId":"topic-2","title":"Question 23","prompt":[{"type":"paragraph","text":"What kind of insights can the GitHub Copilot usage metrics API provide to help evaluate the effectiveness of GitHub Copilot? Each correct answer presents part of the solution. (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"The API can generate detailed reports on code quality improvements made by GitHub Copilot."},{"id":"b","label":"The API can track the number of code suggestions accepted and used in the organization."},{"id":"c","label":"The API can provide feedback on coding style and standards compliance."},{"id":"d","label":"The API can provide Copilot Chat specific suggestions acceptance metrics."},{"id":"e","label":"The API can refactor your code to improve productivity."}],"correctOptionIds":["b","d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. The API can track the number of code suggestions accepted and used in the organization.\nD. The API can provide Copilot Chat specific suggestions acceptance metrics."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 23","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q024","topicId":"topic-2","title":"Question 24","prompt":[{"type":"paragraph","text":"How do you generate code suggestions with GitHub Copilot in the CLI?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"Describe the project’s architecture → Use the copilot generate command → Accept the generated suggestion."},{"id":"b","label":"Type out the code snippet → Use the copilot refine command to enhance it → Review the suggested command."},{"id":"c","label":"Write code comments → Press the suggestion shortcut → Select the best suggestion from the list."},{"id":"d","label":"Use ‘gh copilot suggest’ → Write the command you want → Select the best suggestion from the list."}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nD. Use ‘gh copilot suggest’ → Write the command yo