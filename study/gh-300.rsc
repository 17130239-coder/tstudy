r 28 days"},{"id":"b","label":"Prompts and Suggestions: Not retained"},{"id":"c","label":"User Engagement Data: Kept for Two Years"},{"id":"d","label":"User Engagement Data: Kept for 1 Year"}],"correctOptionIds":["b","c"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. Prompts and Suggestions: Not retained\nC. User Engagement Data: Kept for Two Years"}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 33","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q034","topicId":"topic-2","title":"Question 34","prompt":[{"type":"paragraph","text":"How does GitHub Copilot Enterprise assist in code reviews during the pull request process? (Choose two.)"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"multiple_choice","options":[{"id":"a","label":"It generates a prose summary and bulleted list of key changes for pull requests."},{"id":"b","label":"It can answer questions about the changeset of the pull request."},{"id":"c","label":"It automatically merges pull requests after an automated review."},{"id":"d","label":"It can validate the accuracy of the changes in the pull request."}],"correctOptionIds":["a","b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nA. It generates a prose summary and bulleted list of key changes for pull requests.\nB. It can answer questions about the changeset of the pull request."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 34","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q035","topicId":"topic-2","title":"Question 35","prompt":[{"type":"paragraph","text":"How can you get multiple suggestions from GitHub Copilot?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"By using the inline chat functionality with the command/multiple"},{"id":"b","label":"By using @workspace in the chat window"},{"id":"c","label":"By 