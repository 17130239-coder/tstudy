":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q099","topicId":"topic-6","title":"Question 99","prompt":[{"type":"paragraph","text":"How can GitHub Copilot be limited when it comes to suggesting unit tests?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"GitHub Copilot’s limitations in generating unit tests can vary based on the IDE version you are using."},{"id":"b","label":"GitHub Copilot primarily suggest basic unit tests that focus on core functionalities, often requiring additional input from developers for comprehensive coverage."},{"id":"c","label":"GitHub Copilot can handle any complexity in code and automatically generate appropriate unit tests."},{"id":"d","label":"GitHub Copilot can generate all types of unit tests, including those for edge cases and complex integration scenarios."}],"correctOptionIds":["b"]},"explanation":[{"type":"paragraph","text":"Correct answer(s) from gh-300.json:\nB. GitHub Copilot primarily suggest basic unit tests that focus on core functionalities, often requiring additional input from developers for comprehensive coverage."}],"optionExplanations":[],"source":{"name":"gh-300.json","locator":"Question 99","url":""},"review":{"status":"ready","notes":[]}},{"id":"gh300-q100","topicId":"topic-7","title":"Question 100","prompt":[{"type":"paragraph","text":"Where can you validate if GitHub Copilot is not returning suggestions because of content exclusions?"}],"contextId":null,"difficulty":"unspecified","interaction":{"type":"single_choice","options":[{"id":"a","label":"The GitHub Copilot errors panel in your IDE"},{"id":"b","label":"The GitHub Copilot logs on [GitHub.com](http://github.com/) under your user settings"},{"id":"c","label":"The code suggestions window will display a warning message"},{"id":"d","label":"The GitHub Copilot icon in the status bar of the editor will display a message"}],"correctOptionIds":["d"]},"explanation":[{"type":"paragraph","