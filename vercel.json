{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "rsc",
          "value": "1"
        }
      ],
      "destination": "/index.rsc"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/index.rsc"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "rsc",
          "value": "1"
        }
      ],
      "destination": "/:path*.rsc"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "query",
          "key": "_rsc"
        }
      ],
      "destination": "/:path*.rsc"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.rsc",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-component"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
